  55          /* =========================================================================
  56           * MATRIX INITIALISATION
  57           * ========================================================================= */
  58          void Init_PESEC_Matrices(uint8_t* m_sizes, uint8_t num_blocks)
  59          {
  60   1          uint8_t i, b, val;
  61   1          uint8_t is_in_d;
  62   1          uint8_t total_m = 0;
  63   1          uint8_t current_col_offset = 0;
  64   1          uint8_t max_syndrome;
  65   1      
  66   1          pesec_num_blocks = num_blocks;
  67   1          pesec_num_d_cols = 0;
  68   1          pesec_num_a_cols = 0;
  69   1      
  70   1          for (b = 0; b < num_blocks; b++)
  71   1          {
  72   2              pesec_bit_offsets[b] = total_m;
  73   2              pesec_col_offsets[b] = current_col_offset;
  74   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  75   2      
  76   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  77   2              {
  78   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  79   3              }
  80   2      
  81   2              total_m += m_sizes[b];
  82   2              current_col_offset += ((1 << m_sizes[b]) - 1);
  83   2          }
  84   1      
  85   1          max_syndrome = (1 << total_m) - 1;
  86   1      
  87   1          for (val = 1; val <= max_syndrome; val++)
  88   1          {
  89   2              is_in_d = 0;
  90   2      
  91   2              for (i = 0; i < pesec_num_d_cols; i++)
  92   2              {
  93   3                  if (PESEC_MAT_D[i] == val)
  94   3                  {
  95   4                      is_in_d = 1;
  96   4                      break;
  97   4                  }
  98   3              }
  99   2      
 100   2              if (is_in_d == 0)
 101   2              {
 102   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 103   3              }
 104   2          }
 105   1      }
