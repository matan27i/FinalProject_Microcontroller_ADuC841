 111          static uint8_t calc_pesec_synd(uint16_t reg_val, uint8_t* mat_ptr, uint8_t cols)
 112          {
 113   1          uint8_t synd_res = 0;
 114   1          uint8_t idx;
 115   1      
 116   1          for (idx = 0; idx < cols; idx++)
