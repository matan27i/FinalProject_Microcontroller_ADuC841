 181          /* =========================================================================
 182           * MAIN ECC FUNCTION
 183           * =========================================================================
 184           * Called after each nibble encoding cycle in process_nibble().
 185           *
 186           * Steps:
 187           *   1. Compute syndrome of data bits (Matrix A x current_bus_state)
 188           *   2. Compute syndrome of redundancy bits (Matrix D x pesec_redundancy_reg)
 189           *   3. XOR to find the syndrome gap
 190           *   4. Solve for the optimal redundancy-bit flip vector
 191           *   5. Apply the differential update to pesec_redundancy_reg
 192           *   6. [W4] Compute overall even parity of all 25 bits
 193           *   7. Output all 26 bits to shift registers
 194           * ========================================================================= */
 195          void ECC(void)
 196          {
 197   1          uint8_t  synd_data;
 198   1          uint8_t  synd_red;
 199   1          uint8_t  synd_diff;
 200   1          uint16_t delta_vector;
 201   1      
 202   1          /* Step 1: Syndrome of the new data */
 203   1          synd_data = get_data_pesec_synd(current_bus_state);
 204   1      
 205   1          /* Step 2: Syndrome of the current redundancy */
 206   1          synd_red = get_red_pesec_synd(pesec_redundancy_reg);
 207   1      
 208   1          /* Step 3: Syndrome gap */
 209   1          synd_diff = synd_data ^ synd_red;
 210   1      
 211   1          /* Step 4: Solve for minimal redundancy flip */
 212   1          delta_vector = solve_pesec_delta(synd_diff);
 213   1      
 214   1          /* Step 5: Apply differential update */
 215   1          pesec_redundancy_reg ^= delta_vector;
 216   1      
 217   1          /* Step 6: [W4] Compute overall even parity of all 25 bits.
 218   1           *
 219   1           * P = parity(data[14:0]) XOR parity(redundancy[9:0])
 220   1           *
 221   1           * The parity of the 25-bit concatenation [data | red] equals the
 222   1           * XOR of the individual parities because parity is linear over
 223   1           * disjoint bit fields.  The receiver checks:
 224   1           *   received_P XOR parity(received_data) XOR parity(received_red)
 225   1           * and combines the result with the PESEC syndrome to distinguish
 226   1           * single errors (correctable) from double errors (detectable). */
 227   1          pesec_overall_parity = parity16(current_bus_state & BUS_STATE_MASK)
 228   1                               ^ parity16(pesec_redundancy_reg & PESEC_RED_MASK);
 229   1      
 230   1          /* Step 7: Output 26 bits to daisy-chained shift registers */
 231   1          output_to_shift_registers();
 232   1      }


