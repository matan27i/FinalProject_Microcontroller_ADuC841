 126          static uint8_t get_data_pesec_synd(uint16_t data_val)
 127          {
 128   1          return calc_pesec_synd(data_val, PESEC_MAT_A, pesec_num_a_cols);
 129   1      }
 130          
 131          static uint8_t get_red_pesec_synd(uint16_t red_val)
