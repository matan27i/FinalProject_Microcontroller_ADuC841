 136          /* =========================================================================
 137           * PARITY COMPUTATION HELPER  (W4 -- SEC+DED)
 138           * =========================================================================
 139           * Computes the population parity (popcount mod 2) of a 16-bit value
 140           * using XOR folding.  Optimised for the 8051 instruction set:
 141           *   1. XOR the high byte into the low byte (one 8-bit XOR).
 142           *   2. Fold the resulting byte: nibbles, pairs, then single bit.
 143           * Total: 5 XORs + 3 shifts + 1 AND -- no branches, no lookup table.
 144           *
 145           * Returns: 0 if the number of set bits is even, 1 if odd.
 146           * ========================================================================= */
 147          static uint8_t parity16(uint16_t v)
 148          {
 149   1          uint8_t x;
 150   1      
 151   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 152   1          x ^= x >> 4;
 153   1          x ^= x >> 2;
 154   1          x ^= x >> 1;
 155   1      
 156   1          return (x & 1u);
 157   1      }
 158          
 159          /* =========================================================================
 160           * DELTA SOLVER
 161           * ========================================================================= */
 162          static uint16_t solve_pesec_delta(uint8_t synd_gap)
 163          {
 164   1          uint16_t delta_vec = 0;
 165   1          uint8_t  b, chunk, val;
 166   1      
 167   1          for (b = 0; b < pesec_num_blocks; b++)
 168   1          {
 169   2              chunk = synd_gap & pesec_chunk_masks[b];
 170   2      
 171   2              if (chunk != 0)
 172   2              {
 173   3                  val = chunk >> pesec_bit_offsets[b];
 174   3                  delta_vec |= (1 << (pesec_col_offsets[b] + val - 1));
 175   3              }
 176   2          }
 177   1      
 178   1          return delta_vec;
C51 COMPILER V9.60.7.0   TX_ECC                                                            04/15/2026 21:35:45 PAGE 4   

 179   1      }
