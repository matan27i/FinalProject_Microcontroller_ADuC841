 205          /* 
 206             NON-BLOCKING UART TX BUFFER  (unchanged)
 207              */
 208          
 209          #define TX_BUF_SIZE 64
 210          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 211          static uint8_t tx_head = 0;
 212          static uint8_t tx_tail = 0;
 213          
 214          
 215          void rx_send_uart_byte(uint8_t data_byte)
 216          {
 217   1          uint8_t next_head;
 218   1      
 219   1          next_head = (tx_head + 1) % TX_BUF_SIZE;
 220   1          if (next_head == tx_tail)
 221   1          {
 222   2              return;
 223   2          }
 224   1      
 225   1          tx_buf[tx_head] = data_byte;
 226   1          tx_head = next_head;
 227   1      }
 228          
 229          
 230          void rx_uart_pump(void)
 231          {
 232   1          if (TI && (tx_tail != tx_head))
 233   1          {
 234   2              TI = 0;
 235   2              SBUF = tx_buf[tx_tail];
 236   2              tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
 237   2          }
 238   1      }
