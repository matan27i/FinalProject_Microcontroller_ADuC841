 151          
 152          /* 
 153             RX_SPI_Slave_Init
 154             
 155             [F2] FIX: P1.5 ANALOG-MODE BUG
 156          
 157             The ADuC841 Port 1 defaults to ANALOG INPUT mode on power-up.
 158             In analog mode, the digital input buffer is disconnected, so the
 159             pin cannot reliably read logic levels.  P1.5 is the SPI /SS pin.
 160             If SPE is enabled while P1.5 is still analog, the SPI slave
 161             peripheral cannot detect the master's slave-select assertion.
 162          
 163             FIX: Write 0 to P1.5 BEFORE enabling SPE.  On the ADuC841, writing
 164             a 0 to any Port 1 bit switches that pin from analog to digital mode.
 165             We use a bitwise AND to clear only P1.5 without disturbing other P1
 166             bits that may be intentionally left in analog mode for ADC use.
 167          
 168             After the digital-mode switch, SPI is enabled as before.
 169          
 170             [W4] rx_spi_parity is reset to 0 alongside the other staging registers.
 171          
 172             SPICON = 0x20:
 173               SPE=1 (SPI enable), SPIM=0 (slave), CPOL=0, CPHA=0 (Mode 0).
 174               [FIX] Was 0xA0; bit 7 (ISPI) is a status flag, not an enable.
 175             IEIP2 |= 0x01:
 176               [FIX] Enable ESI (SPI/I2C interrupt source) -- was never set.
 177             
C51 COMPILER V9.60.7.0   RX_HWG                                                            04/17/2026 01:17:50 PAGE 4   

 178          */
 179          void RX_SPI_Slave_Init(void)
 180          {
 181   1          spi_byte_idx = 0;
 182   1          rx_spi_frame_ready = 0;
 183   1          rx_spi_data = 0;
 184   1          rx_spi_red = 0;
 185   1          rx_spi_parity = 0;
 186   1      
 187   1          /* [תיקון קריטי]: מעביר את P1.5 למצב דיגיטלי כדי שיוכל לקרוא 
             -את ה-/SS */
 188   1          P1 &= ~0xF0u;
 189   1      
 190   1          SPIDAT = 0x00u;
 191   1      
 192   1          /* אתחול SPI: Slave Mode 0 */
 193   1          SPICON = 0x20u;
 194   1      
 195   1          /* אפשור פסיקות SPI */
 196   1          IEIP2 |= 0x01u;
 197   1      
 198   1          /* הגדרת INT0 */
 199   1          IT0 = 1;
 200   1          IE0 = 0;
 201   1          EX0 = 1;
 202   1      }
