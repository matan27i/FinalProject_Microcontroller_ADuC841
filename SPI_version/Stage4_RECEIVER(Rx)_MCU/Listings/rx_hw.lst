 183          /* 
 184             RX_SPI_Slave_Init
 185             
 186             [F2] FIX: P1.5 ANALOG-MODE BUG
 187          
 188             The ADuC841 Port 1 defaults to ANALOG INPUT mode on power-up.
 189             In analog mode, the digital input buffer is disconnected, so the
 190             pin cannot reliably read logic levels.  P1.5 is the SPI /SS pin.
 191             If SPE is enabled while P1.5 is still analog, the SPI slave
 192             peripheral cannot detect the master's slave-select assertion.
 193          
 194             After the digital-mode switch, SPI is enabled as before.
 195          
 196             rx_spi_parity is reset to 0 alongside the other staging registers.
 197          
 198             SPICON = 0x24  (Mode 1, CPHA=1):
 199               SPE=1 (SPI enable), SPIM=0 (slave), CPOL=0, CPHA=1.
 200          
 201               *** ADuC841 DATASHEET CPHA=0 QUIRK ***
 202               Per the ADuC841 datasheet (SPI slave section, p.54):
 203                 "If CPHA = 1, the SS input may be permanently pulled low.
 204                  If CPHA = 0, the SS input must be driven LOW before the
 205                  first bit in a byte-wide transmission or reception and
 206                  return HIGH again after the last bit in that byte-wide
 207                  transmission or reception."
 208                 "The end of transmission occurs after the eighth clock
 209                  has been received if CPHA = 1, or when SS returns high
 210                  if CPHA = 0."
 211               In other words, Mode 0 (CPHA=0) requires /SS to toggle
 212               HIGH-LOW *per byte*.  The Arduino's sendFrame() holds /SS
 213               LOW for all 4 bytes of a frame, which violates the CPHA=0
 214               protocol -- SPIDAT is not latched at proper byte boundaries,
 215               so received bytes are shifted/duplicated, PESEC fires on
 216               every frame, rx_is_bus_reset() never sees {0,0,0,0}, and
 217               the FSM emits the scrambled 'FdFdrFrFdFdFr!' pattern.
 218               Switching to Mode 1 (CPHA=1) allows /SS to remain LOW
 219               across the entire 4-byte frame with per-byte latching on
 220               the 8th SCLK edge -- which is exactly what the Arduino
 221               master is doing.  testspii.ino must match with SPI_MODE1.
 222          
 223             IEIP2 |= 0x01:
 224               Enable ESI (SPI/I2C interrupt source) -- was never set.
 225          
 226          */
 227          void RX_SPI_Slave_Init(void)
 228          {
 229   1          /* Reset SPI receive state. */
 230   1          spi_byte_idx       = 0;
 231   1          rx_spi_frame_ready = 0;
 232   1          rx_spi_data        = 0;
 233   1          rx_spi_red         = 0;
 234   1          rx_spi_parity      = 0;   
 235   1      
 236   1          /* Force P1.5 (/SS) from analog mode to digital input mode.
 237   1             On the ADuC841, SCLOCK and SDATA/MOSI are dedicated pins (not on
 238   1             P1), and MISO is on P3.3.  Only /SS (P1.5) is a Port 1 pin that
 239   1             needs the analog-to-digital switch.  We also clear P1.7-P1.4 to
 240   1             be safe, since the receiver does not use ADC channels 4-7. */
C51 COMPILER V9.60.7.0   RX_HW                                                             04/21/2026 15:24:35 PAGE 5   

 241   1          P1 &= ~0xF0u;   /* P1.7..P1.4 = 0 -> digital mode */
 242   1      
 243   1          /* Pre-load transmit register. */
 244   1          SPIDAT = 0x00u;
 245   1      
 246   1          /* Configure SPI: slave mode, Mode 1 (CPHA=1).
 247   1             SPE=1, SPIM=0, CPOL=0, CPHA=1, SPR=00 => 0x24.
 248   1             [FIX] Was 0x20 (Mode 0): the ADuC841 slave requires /SS to
 249   1             toggle per-byte in CPHA=0 mode (see datasheet p.54 and the
 250   1             block comment above).  Arduino's sendFrame() holds /SS low
 251   1             across all 4 bytes, so we must use CPHA=1 (Mode 1) instead
 252   1             so that each byte is latched on the 8th SCLK rather than
 253   1             on the /SS rising edge.  testspii.ino uses SPI_MODE1 to
 254   1             match. */
 255   1          SPICON = 0x24u;
 256   1      
 257   1          /* [FIX] Enable the SPI/I2C interrupt source (ESI, bit 0 of IEIP2).
 258   1             Without this, the SPI ISR at vector 003BH never fires regardless
 259   1             of the ISPI flag state.  IEIP2 power-on default is A0H (ESI=0).
 260   1             Use ORL to preserve other bits (priority settings). */
 261   1          IEIP2 |= 0x01u;
 262   1      
 263   1          /* Configure INT0 (P3.2) for falling-edge trigger on /SS assertion.
 264   1           *
 265   1           * Arduino pin 10 drives BOTH P1.5 (SPI /SS) and P3.2 (INT0) per the
 266   1           * testspii.ino wiring note.  Each Arduino sendFrame() lowers pin 10,
 267   1           * which fires INT0_FrameSync_ISR and zeros spi_byte_idx -- giving a
 268   1           * hard resync at every frame start, independent of how many SPI
 269   1           * bytes the previous frame delivered.
 270   1           *
 271   1           * History: this was briefly disabled (EX0 = 0) during bring-up when
 272   1           * we were not sure whether P3.2 was wired.  The [F3] self-reset at
 273   1           * idx == 4 let frames assemble, but a single lost byte left
 274   1           * spi_byte_idx stuck mid-frame -- producing the symptom where reset
 275   1           * frames ({0,0,0,0}) never triggered rx_is_bus_reset() because the
 276   1           * received bytes were shifted by one slot against the previous
 277   1           * frame's tail.  INT0 is the correct mechanism for frame alignment
 278   1           * now that the SPI path itself is confirmed working. */
 279   1          IT0 = 1;
 280   1          IE0 = 0;
 281   1          EX0 = 1;   /* [FIX] RE-ENABLED.  Frame-alignment hardware resync.
 282   1                        The current testspiiGuCci.ino drives pin 10 as an
 283   1                        OUTPUT: HIGH between frames, LOW during a frame
 284   1                        (see sendFrame() in that sketch).  That gives P3.2
 285   1                        a clean, non-floating signal with exactly one falling
 286   1                        edge per 4-byte frame.  INT0_FrameSync_ISR zeros
 287   1                        spi_byte_idx on that edge BEFORE the first SCLK byte
 288   1                        is latched, so the SPI ISR always sees byte0 in slot 0.
 289   1                        Without this, a single dropped SPI byte (very likely
 290   1                        during ADuC boot / first-frame race) permanently
 291   1                        shifts every subsequent frame by N bytes -- which is
 292   1                        exactly the "12 consecutive FU" symptom we saw:
 293   1                        PESEC syndrome != 0 but parity OK = even-bit-flip
 294   1                        signature caused by byte-boundary misalignment, not
 295   1                        by PESEC or line noise.  The old reason to keep this
 296   1                        disabled (floating pin 10 on the legacy testspii.ino)
 297   1                        no longer applies. */
 298   1      
 299   1          /* EA is NOT set here; caller must set EA=1 after all inits. */
 300   1      }
 301          
 302          
