   1          /* 
   2             File: rx_hw.c
   3          
   4             ADuC841 PORT 1 ANALOG-MODE ANOMALY:
   5             On the ADuC841, all Port 1 pins power up in ANALOG INPUT mode.  In
   6             this mode the digital input buffer is disabled and the pin reads as
   7             indeterminate.  Writing a 0 to a P1 bit switches that pin to DIGITAL
   8             mode.  This must be done BEFORE enabling any peripheral (like SPI)
   9             that relies on reading the pin.
  10          
  11             The SPI /SS pin is P1.5.  If SPE is set while P1.5 is still in
  12             analog mode, the SPI slave cannot detect /SS transitions and will
  13             either ignore frames entirely or sample data at random phases.
  14             
  15          */
  16          
  17          #include "rx_system.h"
  18          
  19          /* Set RX_DEBUG_LED to 1 to enable in-ISR LED toggle on P3.4 for scope
  20             debugging of SPI byte reception.
  21             [FIX] Default is now 0 (OFF).  With the Arduino SPI clock dropped
  22             to 50 kHz the ISR has plenty of deadline margin, but the P3.4
  23             toggle added ~8 instruction cycles per byte plus EMI on a port pin
  24             adjacent to INT0 (P3.2) -- a plausible contributor to spurious
  25             INT0 falling edges that zero spi_byte_idx mid-frame.  Compile with
  26             -DRX_DEBUG_LED=1 to re-enable for scope work. */
  27          #ifndef RX_DEBUG_LED
  28          #define RX_DEBUG_LED 0
  29          #endif
  30          
  31          #if RX_DEBUG_LED
              sbit DEBUG_LED = P3^4;
              #endif
  34          
  35          /*
  36             SPI RECEIVE STATE VARIABLES
  37              */
  38          
  39          /* Staging registers: assembled 26-bit word from the last complete frame.
  40             Written atomically by the SPI ISR; read by the main loop when
  41             rx_spi_frame_ready == 1. */
  42          volatile uint16_t rx_spi_data        = 0;
  43          volatile uint16_t rx_spi_red         = 0;
  44          volatile uint8_t  rx_spi_parity      = 0;   /* [W4] Overall parity bit */
  45          volatile uint8_t  rx_spi_frame_ready = 0;
  46          
  47          /* ISR-private byte accumulation buffer and counter.
  48             [W6] volatile because spi_byte_idx is written from two ISRs
  49             (INT0 vector 0 and SPI vector 7).  They cannot preempt each other at
  50             equal priority, but volatile prevents compiler reordering/caching. */
  51          static uint8_t spi_rx_buf[4];
  52          static volatile uint8_t spi_byte_idx = 0;
  53          
  54          
C51 COMPILER V9.60.7.0   RX_HW                                                             04/21/2026 15:24:35 PAGE 2   

  55          /* 
  56             INTERRUPT SERVICE ROUTINES
  57              */
  58          
  59          /* 
  60             INT0 ISR (vector 0, address 0x0003) -- /SS Frame-Sync
  61             
  62             Fires on the falling edge of /SS (Mega asserts slave select).
  63             Resets the byte counter to 0 so the next SPI byte is byte 0.
  64             
  65          */
  66          void INT0_FrameSync_ISR(void) interrupt 0
  67          {
  68   1          spi_byte_idx = 0;
  69   1      }
  70          
  71          
  72          /* 
  73             SPI/I2C ISR (vector 7, address 0x003B) -- Byte Received
  74             
  75             Fires after each complete 8-bit SPI transfer.
  76          
  77             FRAME PROTOCOL (4 bytes per frame):
  78               Index 0: H1 data bits  [7:0]
  79               Index 1: bit 7 = overall parity (W4)
  80                        bits [6:0] = H1 data bits [14:8]
  81               Index 2: ECC red bits  [7:0]
  82               Index 3: ECC red bits  [9:8] (bits 7-2 = 0)
  83          
  84             After storing byte 3, the ISR assembles the 15-bit data, 10-bit
  85             redundancy, and 1-bit parity, then sets rx_spi_frame_ready = 1.
  86             
  87          */
  88          void SPI_Receive_ISR(void) interrupt 7
  89          {
  90   1          uint8_t rx_byte;
  91   1          uint8_t idx;
  92   1      
  93   1      #if RX_DEBUG_LED
                  DEBUG_LED = !DEBUG_LED;
              #endif
  96   1      
  97   1          /* Reading SPIDAT returns the just-clocked byte AND clears ISPI. */
  98   1          rx_byte = SPIDAT;
  99   1      
 100   1          /* Snapshot the index once so we don't re-read the volatile
 101   1             inside the hot path. */
 102   1          idx = spi_byte_idx;
 103   1          if (idx >= 4)
 104   1          {
 105   2              /* Stale byte after the frame was assembled but before the main
 106   2                 loop consumed rx_spi_frame_ready.  Drop it. */
 107   2              return;
 108   2          }
 109   1      
 110   1          spi_rx_buf[idx] = rx_byte;
 111   1          idx++;
 112   1          spi_byte_idx = idx;
 113   1      
 114   1          if (idx == 4)
 115   1          {
 116   2              /* 15-bit data word from bytes 0 (low) and 1[6:0] (high).
C51 COMPILER V9.60.7.0   RX_HW                                                             04/21/2026 15:24:35 PAGE 3   

 117   2                 Byte 1 bit 7 carries the overall parity. */
 118   2              rx_spi_data = (uint16_t)spi_rx_buf[0]
 119   2                          | (((uint16_t)(spi_rx_buf[1] & 0x7Fu)) << 8);
 120   2      
 121   2              /* 10-bit redundancy from bytes 2 (low) and 3[1:0] (high). */
 122   2              rx_spi_red  = (uint16_t)spi_rx_buf[2]
 123   2                          | (((uint16_t)(spi_rx_buf[3] & 0x03u)) << 8);
 124   2      
 125   2              rx_spi_parity = (spi_rx_buf[1] >> 7) & 0x01u;
 126   2      
 127   2              rx_spi_frame_ready = 1;
 128   2      
 129   2              /* Allow the next frame to arrive without requiring INT0 resync.
 130   2                 INT0 is still enabled as a belt-and-braces realignment; it
 131   2                 fires on the /SS falling edge at the START of the next frame
 132   2                 and zeros spi_byte_idx again, which is a no-op after this
 133   2                 self-reset. */
 134   2              spi_byte_idx = 0;
 135   2          }
 136   1      }
