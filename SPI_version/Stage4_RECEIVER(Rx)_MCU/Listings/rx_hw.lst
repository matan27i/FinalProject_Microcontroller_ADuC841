 141              */
 142          
 143          /*
 144             RX_Timer3_Init
 145          
 146             Configures Timer 3 (ADuC841 dedicated UART baud rate generator) for
 147             115200 baud at a core clock of 11.0592 MHz (CD=0 in PLLCON).
 148          
 149            
 150          */
 151          void RX_Timer3_Init(void)
 152          {
 153   1          T3FD  = 0x20u;   /* Fractional divider = 32 */
 154   1          T3CON = 0x82u;   /* Enable Timer 3 as UART baud source, DIV = 2 */
 155   1      }
 156          
 157          
 158          /*
 159             RX_UART_Init
 160          
 161             [FIX] Write SCON as a full byte instead of individual sbit writes.
 162             The ADuC841 Keil header aliases SCON bit 7 as SM0/FE; depending on
 163             SMOD0 in PCON, sbit writes to SM0/SM1 can silently target the wrong
 164             bit and leave SCON = 0x00 (Mode 0, synchronous shift-register at
 165             f_core/12).  In that mode, SBUF bytes are clocked out on TxD as raw
 166             8-bit shift-register pulses at ~921 kHz with no start/stop framing,
 167             so PuTTY at 115200 baud (or any async baud) sees nothing decodable.
 168             This is the same trap fixed on the TX side in tx_main.c [C4].
 169          
 170             SCON = 0x40 -> SM0=0, SM1=1 (Mode 1, 8-bit async UART, Timer-3 baud)
 171                            SM2=0, REN=0 (TX-only, receive disabled)
 172                            TB8=RB8=TI=RI=0
 173             ES remains 0: the TX path is polled via rx_uart_pump(), not ISR-driven.
 174          */
 175          void RX_UART_Init(void)
 176          {
 177   1          SCON = 0x40;
 178   1          ES   = 0;
C51 COMPILER V9.60.7.0   RX_HW                                                             04/21/2026 15:24:35 PAGE 4   

 179   1          TI   = 1;   /* Seed TI so the first rx_uart_pump() can write SBUF */
 180   1      }
