 303          /* 
 304             NON-BLOCKING UART TX BUFFER 
 305              */
 306          
 307          /* [FIX] Bumped 64 -> 128.  rx_send_uart_byte() drops on full, and
 308             under PuTTY flow-control pauses or back-to-back frames the early
 309             debug markers (F, R) were getting dropped while later FSM bytes
 310             (decoded chars) survived -- producing the "many A's, no F/R"
 311             pattern in the trace.  Bigger ring absorbs the bursts. */
 312          #define TX_BUF_SIZE 128
 313          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 314          static uint8_t tx_head = 0;
 315          static uint8_t tx_tail = 0;
 316          
 317          
 318          void rx_send_uart_byte(uint8_t data_byte)
 319          {
 320   1          uint8_t next_head;
 321   1      
 322   1          next_head = (tx_head + 1) % TX_BUF_SIZE;
 323   1          if (next_head == tx_tail)
 324   1          {
 325   2              return;
 326   2          }
 327   1      
 328   1          tx_buf[tx_head] = data_byte;
 329   1          tx_head = next_head;
 330   1      }
 331          
 332          
 333          void rx_uart_pump(void)
 334          {
 335   1          if (TI && (tx_tail != tx_head))
 336   1          {
 337   2              TI = 0;
 338   2              SBUF = tx_buf[tx_tail];
 339   2              tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
 340   2          }
 341   1      }


