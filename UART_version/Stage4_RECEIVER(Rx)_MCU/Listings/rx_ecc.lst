 158          /* 
 159             PARITY COMPUTATION HELPER
 160             
 161             Computes the population parity (popcount mod 2) of a 16-bit value
 162             using XOR folding.  Identical to the TX encoder's implementation.
 163          
 164             Returns: 0 if even number of set bits, 1 if odd.
 165              */
 166          static uint8_t parity16(uint16_t v) // Xor folding
 167          {
 168   1          uint8_t x;
 169   1      
 170   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 171   1          x ^= x >> 4;
 172   1          x ^= x >> 2;
 173   1          x ^= x >> 1;
 174   1      
 175   1          return (x & 1u); // and masking to find LSB 
 176   1      }
