 123          /* 
 124             PESEC SYNDROME COMPUTATION (INTERNAL HELPERS)
 125              */
 126          
 127          static uint8_t calc_pesec_syndrome_generic(uint16_t reg_val,uint8_t *mat_ptr,uint8_t  num_cols) // vector 
             -* matrix 
 128          {
 129   1          uint8_t syndrome = 0;
 130   1          uint8_t idx;
 131   1      
 132   1          for (idx = 0; idx < num_cols; idx++) // 
 133   1          {
 134   2              if ((reg_val >> idx) & 1u)
 135   2              {
 136   3                  syndrome ^= mat_ptr[idx];
 137   3              }
 138   2          }
 139   1      
 140   1          return syndrome;
 141   1      }
 142          
 143          
 144          static uint8_t get_data_syndrome(uint16_t data_val) //data * A
 145          {
 146   1          return calc_pesec_syndrome_generic(data_val, PESEC_MAT_A,
 147   1                                             pesec_num_a_cols);
 148   1      }
 149          
 150          
 151          static uint8_t get_red_syndrome(uint16_t red_val) // Redundancy * D
 152          {
 153   1          return calc_pesec_syndrome_generic(red_val, PESEC_MAT_D,
 154   1                                             pesec_num_d_cols);
 155   1      }
