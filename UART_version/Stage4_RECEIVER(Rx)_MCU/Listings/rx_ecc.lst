  75          /* 
  76             PESEC MATRIX INITIALISATION
  77              */
  78          void rx_init_pesec_matrices(uint8_t *m_sizes, uint8_t num_blocks)
  79          {
  80   1          uint8_t i, b, val;
  81   1          uint8_t is_in_d;
  82   1          uint8_t total_m = 0;
  83   1          uint8_t current_col_offset = 0;
  84   1          uint8_t max_syndrome;
  85   1      
  86   1          pesec_num_blocks = num_blocks;
  87   1          pesec_num_d_cols = 0;
  88   1          pesec_num_a_cols = 0;
  89   1      
  90   1          for (b = 0; b < num_blocks; b++)
  91   1          {
  92   2              pesec_bit_offsets[b] = total_m;
  93   2              pesec_col_offsets[b] = current_col_offset;
  94   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  95   2      
  96   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  97   2              {
  98   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  99   3              }
 100   2      
 101   2              total_m += m_sizes[b];
 102   2              current_col_offset += ((1 << m_sizes[b]) - 1);
 103   2          }
 104   1      
 105   1          max_syndrome = (1 << total_m) - 1;
 106   1      
 107   1          for (val = 1; val <= max_syndrome; val++)
 108   1          {
 109   2              is_in_d = 0;
 110   2      
 111   2              for (i = 0; i < pesec_num_d_cols; i++)
 112   2              {
 113   3                  if (PESEC_MAT_D[i] == val)
 114   3                  {
 115   4                      is_in_d = 1;
 116   4                      break;
