 340          
 341          uint16_t rx_correct_bus_state(uint16_t corrected_data)
 342          {
 343   1          uint16_t delta;
 344   1          uint8_t  syndrome_delta;
 345   1          uint16_t expected_delta;
 346   1          uint16_t result;
 347   1      
 348   1          corrected_data &= BUS_STATE_MASK;
 349   1      
 350   1          delta = corrected_data ^ rx_previous_bus_state;
 351   1      
 352   1          syndrome_delta = rx_compute_syndrome(delta);
 353   1      
 354   1          expected_delta = find_minimal_w(syndrome_delta);
 355   1      
 356   1          if (delta == expected_delta)
 357   1          {
 358   2              result = corrected_data;
 359   2          }
 360   1          else
 361   1          {
 362   2              result = (rx_previous_bus_state ^ expected_delta) & BUS_STATE_MASK;
 363   2              rx_errors_corrected++;
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/07/2026 11:54:57 PAGE 7   

 364   2          }
 365   1      
 366   1          rx_previous_bus_state = result;
 367   1      
 368   1          return result;
 369   1      }


