 324          /* 
 325             H1 DIFFERENTIAL ERROR CORRECTION  (unchanged from previous version)
 326              */
 327          
 328          uint16_t find_minimal_w(uint8_t s_target)
 329          {
 330   1          s_target &= 0x0F;
 331   1      
 332   1          if (s_target == 0)
 333   1          {
 334   2              return 0;
 335   2          }
 336   1      
 337   1          return ((uint16_t)1u << (s_target - 1));
 338   1      }
