 186          /* 
 187             PESEC ERROR CORRECTION  (SEC+DED UPGRADED)
 188             
 189          
 190             [W4] UPGRADED FROM SEC TO SEC+DED
 191          
 192             The original SEC-only algorithm:
 193               1. Compute syndrome S.
 194               2. If S == 0: no error.
 195               3. If S != 0: search for matching column, correct if found.
 196          
 197             The SEC+DED algorithm adds an overall parity check to distinguish
 198             single errors (correctable) from double errors (detectable only):
 199          
 200               1. Compute PESEC syndrome S.
 201               2. Recompute the overall parity of the received 25 data+red bits.
 202               3. Compare recomputed parity with the received overall parity bit.
 203               4. Apply the 4-case truth table:
 204          
 205                  CASE 1: S == 0, parity OK
 206                    The codeword is valid.  No error occurred.
 207                    Return: PESEC_NO_ERROR.
 208          
 209                  CASE 2: S != 0, parity FAIL (odd total parity)
 210                    An odd number of bits flipped.  For practical channel error
 211                    rates, this is overwhelmingly a SINGLE-bit error.  The PESEC
 212                    syndrome S identifies the errored bit position.  Proceed with
 213                    standard column-matching correction.
 214                    Return: PESEC_CORRECTED_DATA or PESEC_CORRECTED_RED.
 215          
 216                  CASE 3: S != 0, parity OK (even total parity)
 217                    An even number of bits flipped (2, 4, ...).  The PESEC syndrome
 218                    is non-zero because the two (or more) errors do not cancel in
 219                    syndrome space, but the overall parity IS even because two flips
 220                    preserve parity.  This is a DOUBLE (or higher even) error that
 221                    PESEC cannot correct -- applying the syndrome would "correct"
 222                    to the wrong codeword.
 223                    Return: PESEC_UNCORRECTABLE.
 224          
 225                  CASE 4: S == 0, parity FAIL (odd total parity)
 226                    The syndrome is zero, meaning all 25 data+red bits form a valid
 227                    PESEC codeword.  But the parity is wrong, so exactly one bit
 228                    flipped -- and that bit is the overall parity bit itself.
 229                    The data and redundancy are clean; no correction needed.
 230                    Return: PESEC_CORRECTED_PARITY.
 231          
 232             Parameters:
 233               data_bits       Pointer to 15-bit data; corrected in place if needed.
 234               red_bits        Pointer to 10-bit redundancy; corrected in place.
 235               overall_parity  The received overall parity bit (0 or 1) from the
 236                               26th bus bit, as extracted by the UART framing ISR.
 237             */
 238          uint8_t rx_pesec_correct(uint16_t *data_bits, uint16_t *red_bits,
 239                                   uint8_t overall_parity)
 240          {
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/19/2026 11:54:59 PAGE 5   

 241   1          uint8_t syndrome;
 242   1          uint8_t parity_check;
 243   1          uint8_t i;
 244   1          uint8_t search_limit;
 245   1      
 246   1          /* Step 1: Compute full PESEC syndrome over the received 25 bits. */
 247   1          syndrome = get_data_syndrome(*data_bits) ^ get_red_syndrome(*red_bits);
 248   1      
 249   1          /* Step 2: Recompute parity of the received 25 data+redundancy bits
 250   1             and compare with the received overall parity bit.
 251   1             parity_check = 0 means parity is consistent (even total).
 252   1             parity_check = 1 means parity mismatch (odd total = error). */
 253   1          parity_check = parity16(*data_bits & BUS_STATE_MASK)
 254   1                       ^ parity16(*red_bits & PESEC_RED_MASK)
 255   1                       ^ (overall_parity & 0x01u);
 256   1      
 257   1          /* Step 3: Apply the SEC+DED truth table. */
 258   1      
 259   1          if (syndrome == 0)
 260   1          {
 261   2              if (parity_check == 0)
 262   2              {
 263   3                  /* CASE 1: S==0, parity OK -> no error. */
 264   3                  return PESEC_NO_ERROR;
 265   3              }
 266   2              else
 267   2              {
 268   3                  /* CASE 4: S==0, parity FAIL -> only the parity bit flipped.
 269   3                     Data and redundancy are intact.  Increment the correction
 270   3                     counter since a bit error was detected and accounted for. */
 271   3                  rx_pesec_corrections++;
 272   3                  return PESEC_CORRECTED_PARITY;
 273   3              }
 274   2          }
 275   1          else
 276   1          {
 277   2              if (parity_check == 0)
 278   2              {
 279   3                  /* CASE 3: S!=0, parity OK -> double (or even-count) error.
 280   3                     The syndrome points to a wrong position; correcting would
 281   3                     make things worse.  Flag as uncorrectable. */
 282   3                  rx_errors_detected++;
 283   3                  return PESEC_UNCORRECTABLE;
 284   3              }
 285   2      
 286   2              /* CASE 2: S!=0, parity FAIL -> single error.  Proceed with
 287   2                 standard PESEC column-matching correction. */
 288   2          }
 289   1      
 290   1          /* --- Single-error correction (Case 2 only reaches here) --- */
 291   1      
 292   1          /* Search data-bit columns (Matrix A).
 293   1             Only check the first HAMMING_N columns (physical data bits). */
 294   1          search_limit = pesec_num_a_cols;
 295   1          if (search_limit > HAMMING_N)
 296   1          {
 297   2              search_limit = HAMMING_N;
 298   2          }
 299   1      
 300   1          for (i = 0; i < search_limit; i++)
 301   1          {
 302   2              if (PESEC_MAT_A[i] == syndrome)
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/19/2026 11:54:59 PAGE 6   

 303   2              {
 304   3                  *data_bits ^= ((uint16_t)1u << i);
 305   3                  *data_bits &= BUS_STATE_MASK;
 306   3                  rx_pesec_corrections++;
 307   3                  return PESEC_CORRECTED_DATA;
 308   3              }
 309   2          }
 310   1      
 311   1          /* Search redundancy-bit columns (Matrix D). */
 312   1          for (i = 0; i < pesec_num_d_cols; i++)
 313   1          {
 314   2              if (PESEC_MAT_D[i] == syndrome)
 315   2              {
 316   3                  *red_bits ^= ((uint16_t)1u << i);
 317   3                  *red_bits &= PESEC_RED_MASK;
 318   3                  rx_pesec_corrections++;
 319   3                  return PESEC_CORRECTED_RED;
 320   3              }
 321   2          }
 322   1      
 323   1          /* Syndrome is non-zero, parity says single error, but no column
 324   1             matches.  This should not happen with the H1-type construction
 325   1             (every non-zero 5-bit value is a column), but guard against it. */
 326   1          rx_errors_detected++;
 327   1          return PESEC_UNCORRECTABLE;
 328   1      }
