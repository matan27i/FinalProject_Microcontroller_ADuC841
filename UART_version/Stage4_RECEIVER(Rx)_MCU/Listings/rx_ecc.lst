 179          /* 
 180             PESEC ERROR CORRECTION  (SEC+DED UPGRADED)
 181             
 182          
 183             [W4] UPGRADED FROM SEC TO SEC+DED
 184          
 185             The original SEC-only algorithm:
 186               1. Compute syndrome S.
 187               2. If S == 0: no error.
 188               3. If S != 0: search for matching column, correct if found.
 189          
 190             The SEC+DED algorithm adds an overall parity check to distinguish
 191             single errors (correctable) from double errors (detectable only):
 192          
 193               1. Compute PESEC syndrome S.
 194               2. Recompute the overall parity of the received 25 data+red bits.
 195               3. Compare recomputed parity with the received overall parity bit.
 196               4. Apply the 4-case truth table:
 197          
 198                  CASE 1: S == 0, parity OK
 199                    The codeword is valid.  No error occurred.
 200                    Return: PESEC_NO_ERROR.
 201          
 202                  CASE 2: S != 0, parity FAIL (odd total parity)
 203                    An odd number of bits flipped.  For practical channel error
 204                    rates, this is overwhelmingly a SINGLE-bit error.  The PESEC
 205                    syndrome S identifies the errored bit position.  Proceed with
 206                    standard column-matching correction.
 207                    Return: PESEC_CORRECTED_DATA or PESEC_CORRECTED_RED.
 208          
 209                  CASE 3: S != 0, parity OK (even total parity)
 210                    An even number of bits flipped (2, 4, ...).  The PESEC syndrome
 211                    is non-zero because the two (or more) errors do not cancel in
 212                    syndrome space, but the overall parity IS even because two flips
 213                    preserve parity.  This is a DOUBLE (or higher even) error that
 214                    PESEC cannot correct -- applying the syndrome would "correct"
 215                    to the wrong codeword.
 216                    Return: PESEC_UNCORRECTABLE.
 217          
 218                  CASE 4: S == 0, parity FAIL (odd total parity)
 219                    The syndrome is zero, meaning all 25 data+red bits form a valid
 220                    PESEC codeword.  But the parity is wrong, so exactly one bit
 221                    flipped -- and that bit is the overall parity bit itself.
 222                    The data and redundancy are clean; no correction needed.
 223                    Return: PESEC_CORRECTED_PARITY.
 224          
 225             Parameters:
 226               data_bits       Pointer to 15-bit data; corrected in place if needed.
 227               red_bits        Pointer to 10-bit redundancy; corrected in place.
 228               overall_parity  The received overall parity bit (0 or 1) from the
 229                               26th bus bit, as extracted by the UART framing ISR.
 230             */
 231          uint8_t rx_pesec_correct(uint16_t *data_bits, uint16_t *red_bits,
 232                                   uint8_t overall_parity)
 233          {
 234   1          uint8_t syndrome;
 235   1          uint8_t parity_check;
 236   1          uint8_t i;
 237   1          uint8_t search_limit;
 238   1      
 239   1          /* Step 1: Compute full PESEC syndrome over the received 25 bits. */
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/07/2026 11:54:57 PAGE 5   

 240   1          syndrome = get_data_syndrome(*data_bits) ^ get_red_syndrome(*red_bits);
 241   1      
 242   1          /* Step 2: Recompute parity of the received 25 data+redundancy bits
 243   1             and compare with the received overall parity bit.
 244   1             parity_check = 0 means parity is consistent (even total).
 245   1             parity_check = 1 means parity mismatch (odd total = error). */
 246   1          parity_check = parity16(*data_bits & BUS_STATE_MASK)
 247   1                       ^ parity16(*red_bits & PESEC_RED_MASK)
 248   1                       ^ (overall_parity & 0x01u);
 249   1      
 250   1          /* Step 3: Apply the SEC+DED truth table. */
 251   1      
 252   1          if (syndrome == 0)
 253   1          {
 254   2              if (parity_check == 0)
 255   2              {
 256   3                  /* CASE 1: S==0, parity OK -> no error. */
 257   3                  return PESEC_NO_ERROR;
 258   3              }
 259   2              else
 260   2              {
 261   3                  /* CASE 4: S==0, parity FAIL -> only the parity bit flipped.
 262   3                     Data and redundancy are intact.  Increment the correction
 263   3                     counter since a bit error was detected and accounted for. */
 264   3                  rx_pesec_corrections++;
 265   3                  return PESEC_CORRECTED_PARITY;
 266   3              }
 267   2          }
 268   1          else
 269   1          {
 270   2              if (parity_check == 0)
 271   2              {
 272   3                  /* CASE 3: S!=0, parity OK -> double (or even-count) error.
 273   3                     The syndrome points to a wrong position; correcting would
 274   3                     make things worse.  Flag as uncorrectable. */
 275   3                  rx_errors_detected++;
 276   3                  return PESEC_UNCORRECTABLE;
 277   3              }
 278   2      
 279   2              /* CASE 2: S!=0, parity FAIL -> single error.  Proceed with
 280   2                 standard PESEC column-matching correction. */
 281   2          }
 282   1      
 283   1          /* --- Single-error correction (Case 2 only reaches here) --- */
 284   1      
 285   1          /* Search data-bit columns (Matrix A).
 286   1             Only check the first HAMMING_N columns (physical data bits). */
 287   1          search_limit = pesec_num_a_cols;
 288   1          if (search_limit > HAMMING_N)
 289   1          {
 290   2              search_limit = HAMMING_N;
 291   2          }
 292   1      
 293   1          for (i = 0; i < search_limit; i++)
 294   1          {
 295   2              if (PESEC_MAT_A[i] == syndrome)
 296   2              {
 297   3                  *data_bits ^= ((uint16_t)1u << i);
 298   3                  *data_bits &= BUS_STATE_MASK;
 299   3                  rx_pesec_corrections++;
 300   3                  return PESEC_CORRECTED_DATA;
 301   3              }
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/07/2026 11:54:57 PAGE 6   

 302   2          }
 303   1      
 304   1          /* Search redundancy-bit columns (Matrix D). */
 305   1          for (i = 0; i < pesec_num_d_cols; i++)
 306   1          {
 307   2              if (PESEC_MAT_D[i] == syndrome)
 308   2              {
 309   3                  *red_bits ^= ((uint16_t)1u << i);
 310   3                  *red_bits &= PESEC_RED_MASK;
 311   3                  rx_pesec_corrections++;
 312   3                  return PESEC_CORRECTED_RED;
 313   3              }
 314   2          }
 315   1      
 316   1          /* Syndrome is non-zero, parity says single error, but no column
 317   1             matches.  This should not happen with the H1-type construction
 318   1             (every non-zero 5-bit value is a column), but guard against it. */
 319   1          rx_errors_detected++;
 320   1          return PESEC_UNCORRECTABLE;
 321   1      }
