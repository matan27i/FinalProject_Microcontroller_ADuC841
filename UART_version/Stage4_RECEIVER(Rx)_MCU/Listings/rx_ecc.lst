 165          /* 
 166             PARITY COMPUTATION HELPER
 167             
 168             Computes the population parity (popcount mod 2) of a 16-bit value
 169             using XOR folding.  Identical to the TX encoder's implementation.
 170          
 171             Returns: 0 if even number of set bits, 1 if odd.
 172              */
 173          static uint8_t parity16(uint16_t v)
 174          {
 175   1          uint8_t x;
 176   1      
 177   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 178   1          x ^= x >> 4;
C51 COMPILER V9.60.7.0   RX_ECC                                                            05/19/2026 11:54:59 PAGE 4   

 179   1          x ^= x >> 2;
 180   1          x ^= x >> 1;
 181   1      
 182   1          return (x & 1u);
 183   1      }
