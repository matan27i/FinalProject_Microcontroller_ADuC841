 128          /* 
 129             PESEC SYNDROME COMPUTATION (INTERNAL HELPERS)
 130              */
 131          
 132          static uint8_t calc_pesec_syndrome_generic(uint16_t reg_val,
 133                                                     uint8_t *mat_ptr,
 134                                                     uint8_t  num_cols)
 135          {
 136   1          uint8_t syndrome = 0;
 137   1          uint8_t idx;
 138   1      
 139   1          for (idx = 0; idx < num_cols; idx++)
 140   1          {
 141   2              if ((reg_val >> idx) & 1u)
 142   2              {
 143   3                  syndrome ^= mat_ptr[idx];
 144   3              }
 145   2          }
 146   1      
 147   1          return syndrome;
 148   1      }
 149          
 150          
 151          static uint8_t get_data_syndrome(uint16_t data_val)
 152          {
 153   1          return calc_pesec_syndrome_generic(data_val, PESEC_MAT_A,
 154   1                                             pesec_num_a_cols);
 155   1      }
 156          
 157          
 158          static uint8_t get_red_syndrome(uint16_t red_val)
 159          {
 160   1          return calc_pesec_syndrome_generic(red_val, PESEC_MAT_D,
 161   1                                             pesec_num_d_cols);
 162   1      }
