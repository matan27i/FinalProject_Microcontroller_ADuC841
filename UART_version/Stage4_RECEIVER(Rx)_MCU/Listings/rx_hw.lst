 304          /*
 305             NON-BLOCKING UART TX ENQUEUE
 306             ---
 307             If the transmitter is idle, write SBUF directly and mark tx_busy.
 308             If busy, push into the ring buffer; dropped on overflow.
 309          
 310             ES is toggled around the shared state update to prevent the ISR
 311             from racing on tx_busy / tx_head.
 312          */
 313          void rx_send_uart_byte(uint8_t data_byte)
 314          {
 315   1          uint8_t next_head;
 316   1      
 317   1          ES = 0;
 318   1      
 319   1          if (!tx_busy)
 320   1          {
 321   2              tx_busy = 1;
 322   2              SBUF    = data_byte;
 323   2              ES      = 1;
 324   2              return;
 325   2          }
 326   1      
 327   1          next_head = (tx_head + 1u) % TX_BUF_SIZE;
 328   1          if (next_head != tx_tail)
 329   1          {
 330   2              tx_buf[tx_head] = data_byte;
 331   2              tx_head         = next_head;
 332   2          }
 333   1          /* else: ring full, byte dropped */
 334   1      
 335   1          ES = 1;
 336   1      }
