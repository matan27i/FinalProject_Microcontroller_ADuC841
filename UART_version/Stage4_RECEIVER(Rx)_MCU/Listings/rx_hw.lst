 176             UART ISR (vector 4, address 0x23)
 177             ---
 178             Serves both RI (receive) and TI (transmit) on the single 8052 UART.
 179             Priority-wise RI is handled first so that a simultaneous RI+TI (rare
 180             at 115200, but possible when a new start bit arrives as the previous
 181             byte finishes shifting out) is drained promptly.
 182          
 183             TI handling: if there is buffered data, shove the next byte into
 184             SBUF and keep tx_busy = 1.  Otherwise clear tx_busy and leave TI = 0
 185             so the ISR does not re-fire until the next send primes SBUF again.
 186          */
 187          void UART_ISR(void) interrupt 4
 188          {
 189   1          uint8_t rx_byte;
 190   1      
 191   1          if (RI)
 192   1          {
 193   2              rx_byte = SBUF;
 194   2              RI = 0;
 195   2              uart_handle_rx_byte(rx_byte);
 196   2          }
 197   1      
 198   1          if (TI)
 199   1          {
 200   2              TI = 0;
 201   2              if (tx_tail != tx_head)
 202   2              {
 203   3                  SBUF = tx_buf[tx_tail];
 204   3                  tx_tail = (tx_tail + 1u) % TX_BUF_SIZE;
 205   3              }
 206   2              else
 207   2              {
 208   3                  tx_busy = 0;
 209   3              }
 210   2          }
 211   1      }
