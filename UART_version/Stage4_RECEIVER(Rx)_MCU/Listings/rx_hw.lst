 117          typedef enum
 118          {
 119              UART_RX_WAIT_SOF  = 0,
 120              UART_RX_COLLECT   = 1,
 121              UART_RX_WAIT_CRC  = 2
 122          } uart_rx_state_t;
 123          
 124          static volatile uart_rx_state_t uart_rx_state    = UART_RX_WAIT_SOF;
 125          static volatile uint8_t         uart_rx_count    = 0;
 126          static uint8_t                  uart_rx_buf[UART_PAYLOAD_LEN];
 127          
 128          
 129          /*
 130             UART TRANSMIT RING (interrupt-driven)
 131             ---
 132             Capacity bumped from 64 to 128 in the SPI revision to absorb bursts
 133             during PuTTY flow-control pauses.  Kept at 128 here.
 134          */
 135          #define TX_BUF_SIZE 128u
 136          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 137          static volatile uint8_t tx_head = 0;   /* producer: main loop */
 138          static volatile uint8_t tx_tail = 0;   /* consumer: ISR       */
 139          
 140          /* tx_busy = 1 when SBUF currently holds an outbound byte whose TI has
 141             not yet been serviced.  While tx_busy=0, the ISR will not re-fire
 142             on TI (we keep TI cleared) and the next rx_send_uart_byte() will
 143             prime SBUF directly. */
 144          static volatile uint8_t tx_busy = 0;
