 217          /*
 218             PERIPHERAL INITIALISATION
 219          */
 220          
 221          /*
 222             RX_Timer3_Init -- Timer 3 as UART baud rate generator.
 223          
 224             Per the ADuC841 datasheet (Table 35, p.76): with the PLL at fCORE =
 225             11.0592 MHz (CD=0, PLL=1), T3CON = 0x82 and T3FD = 0x20 give an
 226             exact 115200 baud.  Verified by the datasheet formula
 227               actual_baud = (2 * fCORE) / (2^(DIV-1) * (T3FD + 64))
 228                           = (22118400) / (2 * 96) = 115200.
 229          */
 230          void RX_Timer3_Init(void)
 231          {
 232   1          T3FD  = 0x20u;   /* Fractional divider = 32 */
 233   1          T3CON = 0x82u;   /* T3BAUDEN=1, DIV=2 (binary 010) */
 234   1      }
 235          
 236          
 237          /*
 238             RX_UART_Init -- SCON Mode 1, full-duplex, interrupt-driven.
 239          
 240             SCON = 0x50:
C51 COMPILER V9.60.7.0   RX_HW                                                             04/25/2026 20:51:51 PAGE 5   

 241               SM0=0, SM1=1   -> Mode 1 (8-bit async UART, variable baud)
 242               SM2=0          -> No multiprocessor framing
 243               REN=1          -> Receive enabled (NEW: was 0 in SPI version)
 244               TB8=RB8=TI=RI = 0
 245          
 246             ES=1 enables the serial interrupt; the ISR handles both RI and TI.
 247             TI starts at 0: the first rx_send_uart_byte() will prime SBUF.
 248          
 249             The MOV-as-byte style (rather than individual sbit writes to SM0/SM1)
 250             avoids the SMOD0 trap documented on the TX side -- when SMOD0=1 in
 251             PCON, SM0 aliases to a framing-error flag and sbit writes silently
 252             miss SCON.7.
 253          */
 254          void RX_UART_Init(void)
 255          {
 256   1          SCON    = 0x50u;
 257   1          tx_busy = 0;
 258   1          tx_head = 0;
 259   1          tx_tail = 0;
 260   1          uart_rx_state       = UART_RX_WAIT_SOF;
 261   1          uart_rx_count       = 0;
 262   1          rx_frame_ready      = 0;
 263   1          rx_frame_data       = 0;
 264   1          rx_frame_red        = 0;
 265   1          rx_frame_parity     = 0;
 266   1          rx_frame_crc_errors = 0;
 267   1      
 268   1          ES = 1;
 269   1          /* EA is set by the caller after all peripherals are initialised. */
 270   1      }
