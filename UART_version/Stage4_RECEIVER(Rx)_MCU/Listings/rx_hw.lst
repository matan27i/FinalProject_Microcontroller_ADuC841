  73          /* ISR-private state machine and byte accumulation buffer.  volatile
  74             solely to prevent the compiler from hoisting accesses out of the ISR
  75             (they are already single-threaded within the ISR itself). */
  76          typedef enum
  77          {
  78              UART_RX_WAIT_SOF  = 0,
  79              UART_RX_COLLECT   = 1,
  80              UART_RX_WAIT_CRC  = 2
  81          } uart_rx_state_t;
  82          
  83          static volatile uart_rx_state_t uart_rx_state    = UART_RX_WAIT_SOF;
  84          static volatile uint8_t         uart_rx_count    = 0;
