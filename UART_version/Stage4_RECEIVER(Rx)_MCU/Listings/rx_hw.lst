 339          /*
 340             ERROR-INDICATOR LED HELPERS
 341             ---
 342             Single-instruction sbit writes; safe to call from anywhere (main loop
 343             or ISR).  No ES guard needed because the bit-addressable port pin is
 344             not shared with the UART machinery.
 345          */
 346          void rx_led_on(void)
 347          {
 348   1          RX_ERROR_LED_PIN = RX_LED_ACTIVE_LEVEL;
 349   1      }
 350          
 351          void rx_led_off(void)
 352          {
 353   1          RX_ERROR_LED_PIN = (uint8_t)(!RX_LED_ACTIVE_LEVEL);
 354   1      }
