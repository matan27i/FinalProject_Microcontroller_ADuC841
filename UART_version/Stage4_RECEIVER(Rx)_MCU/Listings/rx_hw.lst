 270          /*
 271             NON-BLOCKING UART TX ENQUEUE
 272             ---
 273             If the transmitter is idle, write SBUF directly and mark tx_busy.
 274             If busy, push into the ring buffer; dropped on overflow.
 275          
 276             ES is toggled around the shared state update to prevent the ISR
 277             from racing on tx_busy / tx_head.
 278          */
 279          void rx_send_uart_byte(uint8_t data_byte)
 280          {
 281   1          uint8_t next_head;
 282   1      
 283   1          ES = 0;
 284   1      
 285   1          if (!tx_busy)
 286   1          {
 287   2              tx_busy = 1;
 288   2              SBUF    = data_byte;
 289   2              ES      = 1;
 290   2              return;
 291   2          }
 292   1      
 293   1          next_head = (tx_head + 1u) % TX_BUF_SIZE;
 294   1          if (next_head != tx_tail)
 295   1          {
 296   2              tx_buf[tx_head] = data_byte;
 297   2              tx_head         = next_head;
 298   2          }
 299   1          /* else: ring full, byte dropped */
