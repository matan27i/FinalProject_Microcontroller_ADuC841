  61          /*
  62             DEBUG-MODE STRAP PIN
  63             ---
  64             Runtime control for the link-trace markers ('F', 'R', 'C').  At reset
  65             all 8052 port pins are written to 0xFF, so this pin floats to logic 1
  66             via the internal weak pull-up -- debug OFF by default.  Tie the pin
  67             to GND externally (jumper to any GND header) to force it low and
  68             activate the trace markers.
  69          
  70             The always-on ECC markers ('!U', '!d', '!r', '!p') and the onboard
  71             error LED on P3.4 are NOT gated by this strap -- they always reflect
  72             real error events regardless of debug mode.
  73          
  74             PIN: P3.5 (T1 alternate, but Timer 1 is unused in this project so it
  75             works as a plain input).  Reading the pin is a single 8052 MOV C, bit
  76             instruction; the cost per check is negligible against the 520 us UART
  77             frame inter-arrival time.
  78          */
  79          sbit RX_DEBUG_STRAP_PIN = P3^5;
