 272          
 273          /*
 274             NON-BLOCKING UART TX ENQUEUE
 275             ---
 276             If the transmitter is idle, write SBUF directly and mark tx_busy.
 277             If busy, push into the ring buffer; dropped on overflow.
 278          
 279             ES is toggled around the shared state update to prevent the ISR
 280             from racing on tx_busy / tx_head.
 281          */
 282          void rx_send_uart_byte(uint8_t data_byte)
 283          {
 284   1          uint8_t next_head;
 285   1      
 286   1          ES = 0;
 287   1      
 288   1          if (!tx_busy)
 289   1          {
 290   2              tx_busy = 1;
 291   2              SBUF    = data_byte;
 292   2              ES      = 1;
 293   2              return;
 294   2          }
 295   1      
 296   1          next_head = (tx_head + 1u) % TX_BUF_SIZE;
 297   1          if (next_head != tx_tail)
 298   1          {
 299   2              tx_buf[tx_head] = data_byte;
 300   2              tx_head         = next_head;
 301   2          }
 302   1          /* else: ring full, byte dropped */
C51 COMPILER V9.60.7.0   RX_HW                                                             04/25/2026 20:51:51 PAGE 6   

 303   1      
 304   1          ES = 1;
 305   1      }


