  67          volatile uint16_t rx_frame_data        = 0;
  68          volatile uint16_t rx_frame_red         = 0;
  69          volatile uint8_t  rx_frame_parity      = 0;
  70          volatile uint8_t  rx_frame_ready       = 0;
