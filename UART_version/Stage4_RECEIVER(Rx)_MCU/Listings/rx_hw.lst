   1          /*
   2             File: rx_hw.c
   3          
   4             ADuC841 UART (Mode 1) serves both paths on a single serial port:
   5               RxD (P3.0)  <--  USART1 TXD1 of the Arduino Mega (encoded frames)
   6               TxD (P3.1)  -->  USB-UART bridge to PuTTY          (decoded bytes)
   7          
   8             The UART controller is inherently full-duplex: receiving a frame on
   9             RxD and transmitting a decoded byte on TxD use disjoint hardware
  10             (RB and TB shift registers) and are mediated by the same ISR.
  11          
  12             FRAMING LOGIC:
  13               Incoming bytes are fed into a 3-state accumulator:
  14                   UART_RX_WAIT_SOF     - hunt for 0xAA sync byte
  15                   UART_RX_COLLECT      - capture the next 4 payload bytes
  16                   UART_RX_WAIT_CRC     - verify CRC-8 over the 4 payload bytes
  17               Invalid frames are dropped and the accumulator returns to
  18               UART_RX_WAIT_SOF, so worst-case resync is one frame (~520 us).
  19          
  20             TX IS NOW INTERRUPT-DRIVEN:
  21               In the SPI revision the UART TX path was polled via rx_uart_pump().
  22               Enabling ES = 1 (to receive) means a pending TI flag will also
  23               fire the serial interrupt and cannot be left un-cleared, so TX is
  24               moved into the ISR.  The idle-flag tx_busy tracks whether SBUF
  25               currently holds an outbound byte; the first rx_send_uart_byte()
  26               primes SBUF directly, subsequent calls enqueue into the ring.
  27          */
  28          
  29          #include "rx_system.h"
  30          
  31          
  32          /*
  33             UART FRAME PROTOCOL CONSTANTS -- must match the Mega bridge
  34          */
  35          #define UART_SOF            0xAAu
  36          #define UART_PAYLOAD_LEN    4u
  37          #define UART_CRC_POLY       0x07u
  38          
  39          
  40          /*
  41             UART FRAME RECEIVE STATE VARIABLES
  42          */
  43          
  44          /* Staging registers: written from ISR when a complete CRC-valid frame
  45             has been assembled, read from main loop under EA=0 guard. */
  46          volatile uint16_t rx_frame_data        = 0;
  47          volatile uint16_t rx_frame_red         = 0;
  48          volatile uint8_t  rx_frame_parity      = 0;
  49          volatile uint8_t  rx_frame_ready       = 0;
  50          volatile uint16_t rx_frame_crc_errors  = 0;
  51          
  52          /* ISR-private state machine and byte accumulation buffer.  volatile
  53             solely to prevent the compiler from hoisting accesses out of the ISR
  54             (they are already single-threaded within the ISR itself). */
C51 COMPILER V9.60.7.0   RX_HW                                                             04/25/2026 20:51:51 PAGE 2   

  55          typedef enum
  56          {
  57              UART_RX_WAIT_SOF  = 0,
  58              UART_RX_COLLECT   = 1,
  59              UART_RX_WAIT_CRC  = 2
  60          } uart_rx_state_t;
  61          
  62          static volatile uart_rx_state_t uart_rx_state    = UART_RX_WAIT_SOF;
  63          static volatile uint8_t         uart_rx_count    = 0;
  64          static uint8_t                  uart_rx_buf[UART_PAYLOAD_LEN];
  65          
  66          
  67          /*
  68             UART TRANSMIT RING (interrupt-driven)
  69             ---
  70             Capacity bumped from 64 to 128 in the SPI revision to absorb bursts
  71             during PuTTY flow-control pauses.  Kept at 128 here.
  72          */
  73          #define TX_BUF_SIZE 128u
  74          static uint8_t xdata tx_buf[TX_BUF_SIZE];
  75          static volatile uint8_t tx_head = 0;   /* producer: main loop */
  76          static volatile uint8_t tx_tail = 0;   /* consumer: ISR       */
  77          
  78          /* tx_busy = 1 when SBUF currently holds an outbound byte whose TI has
  79             not yet been serviced.  While tx_busy=0, the ISR will not re-fire
  80             on TI (we keep TI cleared) and the next rx_send_uart_byte() will
  81             prime SBUF directly. */
  82          static volatile uint8_t tx_busy = 0;
  83          
  84          
  85          /*
  86             CRC-8 HELPER (poly 0x07, init 0x00, no reflection)
  87             ---
  88             Must match the bridge's crc8().  Keil C51 generates ~8 cycles per
  89             inner iteration, so 32 iterations per frame = ~23 us at 11.0592 MHz
  90             core -- well under the 87 us UART byte time.
  91          */
  92          /* NOTE: parameter is named `buf` rather than `data` because `data` is a
  93             Keil C51 reserved memory-space keyword (alongside xdata/idata/code/
  94             pdata/bdata) -- using it as an identifier yields C141 syntax errors. */
  95          static uint8_t uart_crc8(uint8_t *buf, uint8_t len)
  96          {
  97   1          uint8_t crc = 0u;
  98   1          uint8_t i, j;
  99   1      
 100   1          for (i = 0u; i < len; i++)
 101   1          {
 102   2              crc ^= buf[i];
 103   2              for (j = 0u; j < 8u; j++)
 104   2              {
 105   3                  if (crc & 0x80u)
 106   3                  {
 107   4                      crc = (uint8_t)((crc << 1) ^ UART_CRC_POLY);
 108   4                  }
 109   3                  else
 110   3                  {
 111   4                      crc = (uint8_t)(crc << 1);
 112   4                  }
 113   3              }
 114   2          }
 115   1          return crc;
 116   1      }
