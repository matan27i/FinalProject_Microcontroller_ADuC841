 218          /*
 219             RX_Timer3_Init -- Timer 3 as UART baud rate generator.
 220          
 221             Per the ADuC841 datasheet (Table 35, p.76): with the PLL at fCORE =
 222             11.0592 MHz (CD=0, PLL=1), T3CON = 0x82 and T3FD = 0x20 give an
 223             exact 115200 baud.  Verified by the datasheet formula
 224               actual_baud = (2 * fCORE) / (2^(DIV-1) * (T3FD + 64))
 225                           = (22118400) / (2 * 96) = 115200.
 226          */
 227          void RX_Timer3_Init(void)
 228          {
 229   1          T3FD  = 0x20u;   /* Fractional divider = 32 */
 230   1          T3CON = 0x82u;   /* T3BAUDEN=1, DIV=2 (binary 010) */
 231   1      }
