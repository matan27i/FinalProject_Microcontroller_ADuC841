 305          /*
 306             RX_UART_Init -- SCON Mode 1, full-duplex, interrupt-driven.
 307          
 308             SCON = 0x50:
 309               SM0=0, SM1=1   -> Mode 1 (8-bit async UART, variable baud)
 310               SM2=0          -> No multiprocessor framing
 311               REN=1          -> Receive enabled (NEW: was 0 in SPI version)
 312               TB8=RB8=TI=RI = 0
 313          
 314             ES=1 enables the serial interrupt; the ISR handles both RI and TI.
 315             TI starts at 0: the first rx_send_uart_byte() will prime SBUF.
 316          
 317             The byte-write style (SCON = 0x50u) is preferred over six individual
 318             sbit assignments: it produces a single MOV instruction, is atomic with
 319             respect to interrupts, and is portable across 8052 derivatives.  Note
 320             that the "SMOD0 / SM0 aliases as framing-error flag" feature seen on
 321             some Silicon Labs C8051 parts does NOT exist on the ADuC841/842/843 --
 322             PCON.6 on this chip is SERIPD (datasheet Rev.B Table 7, p.29) -- so
 323             sbit writes to SM0 would also work here.  The byte-write is still the
 324             better style for the reasons above.
 325          */
 326          void RX_UART_Init(void)
 327          {
 328   1          SCON    = 0x50u;
 329   1          tx_busy = 0;
 330   1          tx_head = 0;
 331   1          tx_tail = 0;
 332   1          uart_rx_state       = UART_RX_WAIT_SOF;
 333   1          uart_rx_count       = 0;
 334   1          rx_frame_ready      = 0;
 335   1          rx_frame_data       = 0;
 336   1          rx_frame_red        = 0;
 337   1          rx_frame_parity     = 0;
 338   1          rx_frame_crc_errors = 0;
 339   1      
 340   1          /* Drive the error LED to its OFF level at boot.  P3.4 powers up
 341   1             weakly pulled high (= LED off if active-low) but writing it
 342   1             explicitly makes the initial state independent of the reset
 343   1             value of P3 in case any other code touched it. */
 344   1          rx_led_off();
 345   1      
 346   1          /* Configure the debug strap (P3.5) as a quasi-bidirectional input:
 347   1             writing 1 enables the weak pull-up so the pin floats high when
 348   1             no external strap is applied (= debug OFF).  Pulling the pin to
 349   1             GND externally then drives it strongly low (= debug ON). */
 350   1          RX_DEBUG_STRAP_PIN = 1;
 351   1      
 352   1          ES = 1;
 353   1          /* EA is set by the caller after all peripherals are initialised. */
 354   1      }
 355          
 356          
 357          /*
 358             NON-BLOCKING UART TX ENQUEUE
 359             ---
 360             If the transmitter is idle, write SBUF directly and mark tx_busy.
 361             If busy, push into the ring buffer; dropped on overflow.
 362          
 363             ES is toggled around the shared state update to prevent the ISR
 364             from racing on tx_busy / tx_head.
C51 COMPILER V9.60.7.0   RX_HW                                                             05/24/2026 15:37:29 PAGE 7   

 365          */
 366          void rx_send_uart_byte(uint8_t data_byte)
 367          {
 368   1          uint8_t next_head;
 369   1      
 370   1          ES = 0;
 371   1      
 372   1          if (!tx_busy)
 373   1          {
 374   2              tx_busy = 1;
 375   2              SBUF    = data_byte;
 376   2              ES      = 1;
 377   2              return;
 378   2          }
 379   1      
 380   1          next_head = (tx_head + 1u) % TX_BUF_SIZE;
 381   1          if (next_head != tx_tail)
 382   1          {
 383   2              tx_buf[tx_head] = data_byte;
 384   2              tx_head         = next_head;
 385   2          }
 386   1          /* else: ring full, byte dropped */
 387   1      
 388   1          ES = 1;
 389   1      }
