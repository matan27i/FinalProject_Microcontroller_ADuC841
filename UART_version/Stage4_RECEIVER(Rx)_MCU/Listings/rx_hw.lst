 288          
 289          /*
 290             RX_Timer3_Init -- Timer 3 as UART baud rate generator.
 291          
 292             Per the ADuC841 datasheet (Table 35, p.76): with the PLL at fCORE =
 293             11.0592 MHz (CD=0, PLL=1), T3CON = 0x82 and T3FD = 0x20 give an
 294             exact 115200 baud.  Verified by the datasheet formula
 295               actual_baud = (2 * fCORE) / (2^(DIV-1) * (T3FD + 64))
 296                           = (22118400) / (2 * 96) = 115200.
 297          */
 298          void RX_Timer3_Init(void)
 299          {
 300   1          T3FD  = 0x20u;   /* Fractional divider = 32 */
 301   1          T3CON = 0x82u;   /* T3BAUDEN=1, DIV=2 (binary 010) */
 302   1      }
