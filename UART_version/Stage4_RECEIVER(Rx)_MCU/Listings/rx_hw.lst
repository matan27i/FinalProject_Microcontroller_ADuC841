 246          /*
 247             UART ISR (vector 4, address 0x23)
 248             ---
 249             Serves both RI (receive) and TI (transmit) on the single 8052 UART.
 250             Priority-wise RI is handled first so that a simultaneous RI+TI (rare
 251             at 115200, but possible when a new start bit arrives as the previous
 252             byte finishes shifting out) is drained promptly.
 253          
 254             TI handling: if there is buffered data, shove the next byte into
 255             SBUF and keep tx_busy = 1.  Otherwise clear tx_busy and leave TI = 0
 256             so the ISR does not re-fire until the next send primes SBUF again.
 257          */
 258          void UART_ISR(void) interrupt 4
 259          {
 260   1          uint8_t rx_byte;
 261   1      
 262   1          if (RI)
 263   1          {
 264   2              rx_byte = SBUF;
 265   2              RI = 0;
 266   2              uart_handle_rx_byte(rx_byte);
 267   2          }
 268   1      
 269   1          if (TI)
 270   1          {
 271   2              TI = 0;
 272   2              if (tx_tail != tx_head)
 273   2              {
 274   3                  SBUF = tx_buf[tx_tail];
 275   3                  tx_tail = (tx_tail + 1u) % TX_BUF_SIZE;
 276   3              }
 277   2              else
 278   2              {
 279   3                  tx_busy = 0;
 280   3              }
 281   2          }
 282   1      }
