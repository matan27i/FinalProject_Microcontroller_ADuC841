 199          /*
 200             UART ISR (vector 4, address 0x23)
 201             ---
 202             Serves both RI (receive) and TI (transmit) on the single 8052 UART.
 203             Priority-wise RI is handled first so that a simultaneous RI+TI (rare
 204             at 115200, but possible when a new start bit arrives as the previous
 205             byte finishes shifting out) is drained promptly.
 206          
 207             TI handling: if there is buffered data, shove the next byte into
 208             SBUF and keep tx_busy = 1.  Otherwise clear tx_busy and leave TI = 0
 209             so the ISR does not re-fire until the next send primes SBUF again.
 210          */
 211          void UART_ISR(void) interrupt 4
 212          {
 213   1          uint8_t rx_byte;
 214   1      
 215   1          if (RI)
 216   1          {
 217   2              rx_byte = SBUF;
 218   2              RI = 0;
 219   2              uart_handle_rx_byte(rx_byte);
 220   2          }
 221   1      
 222   1          if (TI)
 223   1          {
 224   2              TI = 0;
 225   2              if (tx_tail != tx_head)
 226   2              {
 227   3                  SBUF = tx_buf[tx_tail];
 228   3                  tx_tail = (tx_tail + 1u) % TX_BUF_SIZE;
 229   3              }
 230   2              else
 231   2              {
 232   3                  tx_busy = 0;
 233   3              }
 234   2          }
 235   1      }
