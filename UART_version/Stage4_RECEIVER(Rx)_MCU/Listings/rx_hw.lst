 242          /*
 243             RX_Timer3_Init -- Timer 3 as UART baud rate generator.
 244          
 245             Per the ADuC841 datasheet (Table 35, p.76): with the PLL at fCORE =
 246             11.0592 MHz (CD=0, PLL=1), T3CON = 0x82 and T3FD = 0x20 give an
 247             exact 115200 baud.  Verified by the datasheet formula
 248               actual_baud = (2 * fCORE) / (2^(DIV-1) * (T3FD + 64))
 249                           = (22118400) / (2 * 96) = 115200.
 250          */
 251          void RX_Timer3_Init(void)
 252          {
 253   1          T3FD  = 0x20u;   /* Fractional divider = 32 */
 254   1          T3CON = 0x82u;   /* T3BAUDEN=1, DIV=2 (binary 010) */
 255   1      }
 256          
 257          
 258          /*
 259             RX_UART_Init -- SCON Mode 1, full-duplex, interrupt-driven.
 260          
 261             SCON = 0x50:
 262               SM0=0, SM1=1   -> Mode 1 (8-bit async UART, variable baud)
 263               SM2=0          -> No multiprocessor framing
 264               REN=1          -> Receive enabled (NEW: was 0 in SPI version)
 265               TB8=RB8=TI=RI = 0
 266          
 267             ES=1 enables the serial interrupt; the ISR handles both RI and TI.
 268             TI starts at 0: the first rx_send_uart_byte() will prime SBUF.
 269          
 270             The byte-write style (SCON = 0x50u) is preferred over six individual
 271             sbit assignments: it produces a single MOV instruction, is atomic with
 272             respect to interrupts, and is portable across 8052 derivatives.  Note
 273             that the "SMOD0 / SM0 aliases as framing-error flag" feature seen on
 274             some Silicon Labs C8051 parts does NOT exist on the ADuC841/842/843 --
 275             PCON.6 on this chip is SERIPD (datasheet Rev.B Table 7, p.29) -- so
 276             sbit writes to SM0 would also work here.  The byte-write is still the
 277             better style for the reasons above.
 278          */
 279          void RX_UART_Init(void)
 280          {
 281   1          SCON    = 0x50u;
 282   1          tx_busy = 0;
 283   1          tx_head = 0;
 284   1          tx_tail = 0;
 285   1          uart_rx_state       = UART_RX_WAIT_SOF;
 286   1          uart_rx_count       = 0;
 287   1          rx_frame_ready      = 0;
 288   1          rx_frame_data       = 0;
 289   1          rx_frame_red        = 0;
 290   1          rx_frame_parity     = 0;
 291   1          rx_frame_crc_errors = 0;
 292   1      
 293   1          /* Drive the error LED to its OFF level at boot.  P3.4 powers up
 294   1             weakly pulled high (= LED off if active-low) but writing it
 295   1             explicitly makes the initial state independent of the reset
 296   1             value of P3 in case any other code touched it. */
 297   1          rx_led_off();
 298   1      
 299   1          ES = 1;
 300   1          /* EA is set by the caller after all peripherals are initialised. */
 301   1      }
