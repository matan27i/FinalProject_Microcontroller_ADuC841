 356          
 357          /*
 358             UART ERROR MARKER
 359             ---
 360             Always-on (not RX_DEBUG-gated) compact 2-byte marker for ECC events:
 361               '!U'  PESEC double-error / uncorrectable, frame dropped
 362               '!d'  PESEC corrected a single data-bit error
 363               '!r'  PESEC corrected a single redundancy-bit error
 364               '!p'  PESEC corrected the overall parity bit itself
C51 COMPILER V9.60.7.0   RX_HW                                                             05/19/2026 13:14:32 PAGE 7   

 365             The leading '!' makes the marker stand out in a stream that may
 366             otherwise contain printable payload bytes.
 367          
 368             This routine itself is non-blocking: rx_send_uart_byte() enqueues the
 369             bytes into the existing 128-byte TX ring buffer drained by UART_ISR's
 370             TI handler.  If the ring is full the marker is dropped silently --
 371             that's exactly the case the LED indicator is designed to cover.
 372          */
 373          void rx_signal_error(uint8_t kind)
 374          {
 375   1      #ifdef debug  
                  rx_send_uart_byte('!');
              #endif
 378   1          rx_send_uart_byte(kind);
 379   1      }


