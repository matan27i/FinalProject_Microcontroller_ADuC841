 140          /*
 141             UART RX BYTE HANDLER -- called from the ISR
 142             ---
 143             A single CRC mismatch aborts the current frame and returns the state
 144             machine to SOF hunt.  A stray 0xAA in the middle of a corrupted
 145             stream will therefore resync at most one frame later.
 146          */
 147          static void uart_handle_rx_byte(uint8_t rx_byte)
 148          {
 149   1          switch (uart_rx_state)
 150   1          {
 151   2              case UART_RX_WAIT_SOF:
 152   2                  if (rx_byte == UART_SOF)
 153   2                  {
 154   3                      uart_rx_count = 0u;
 155   3                      uart_rx_state = UART_RX_COLLECT;
 156   3                  }
 157   2                  break;
 158   2      
 159   2              case UART_RX_COLLECT:
 160   2                  uart_rx_buf[uart_rx_count++] = rx_byte;
 161   2                  if (uart_rx_count >= UART_PAYLOAD_LEN)
 162   2                  {
 163   3                      uart_rx_state = UART_RX_WAIT_CRC;
 164   3                  }
 165   2                  break;
 166   2      
 167   2              case UART_RX_WAIT_CRC:
 168   2              default:
 169   2                  if (rx_byte == uart_crc8(uart_rx_buf, UART_PAYLOAD_LEN))
 170   2                  {
 171   3                      /* Frame is valid -- assemble the 26-bit word.  If the
 172   3                         main loop has not consumed the previous frame yet we
 173   3                         overwrite it; the newer data is always preferred. */
 174   3                      rx_frame_data   = (uint16_t)uart_rx_buf[0]
 175   3                                      | (((uint16_t)(uart_rx_buf[1] & 0x7Fu)) << 8);
 176   3                      rx_frame_red    = (uint16_t)uart_rx_buf[2]
 177   3                                      | (((uint16_t)(uart_rx_buf[3] & 0x03u)) << 8);
 178   3                      rx_frame_parity = (uart_rx_buf[1] >> 7) & 0x01u;
C51 COMPILER V9.60.7.0   RX_HW                                                             05/19/2026 13:14:32 PAGE 4   

 179   3                      rx_frame_ready  = 1u;
 180   3                  }
 181   2                  else
 182   2                  {
 183   3                      rx_frame_crc_errors++;
 184   3      #if RX_DEBUG
                              /* 'C' = bridge-link CRC mismatch.  Nested call into
                                 rx_send_uart_byte() from the UART ISR is safe: the
