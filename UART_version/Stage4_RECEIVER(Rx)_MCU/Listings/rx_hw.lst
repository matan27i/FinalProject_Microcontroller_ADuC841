 181          /*
 182             UART RX BYTE HANDLER -- called from the ISR
 183             ---
 184             A single CRC mismatch aborts the current frame and returns the state
 185             machine to SOF hunt.  A stray 0xAA in the middle of a corrupted
 186             stream will therefore resync at most one frame later.
 187          */
 188          static void uart_handle_rx_byte(uint8_t rx_byte)
 189          {
 190   1          switch (uart_rx_state)
 191   1          {
 192   2              case UART_RX_WAIT_SOF:
 193   2                  if (rx_byte == UART_SOF)
 194   2                  {
 195   3                      uart_rx_count = 0u;
 196   3                      uart_rx_state = UART_RX_COLLECT;
 197   3                  }
 198   2                  break;
 199   2      
 200   2              case UART_RX_COLLECT:
 201   2                  uart_rx_buf[uart_rx_count++] = rx_byte;
 202   2                  if (uart_rx_count >= UART_PAYLOAD_LEN)
 203   2                  {
 204   3                      uart_rx_state = UART_RX_WAIT_CRC;
 205   3                  }
 206   2                  break;
 207   2      
 208   2              case UART_RX_WAIT_CRC:
 209   2              default:
 210   2                  if (rx_byte == uart_crc8(uart_rx_buf, UART_PAYLOAD_LEN))
 211   2                  {
 212   3                      /* Frame is valid -- assemble the 26-bit word.  If the
 213   3                         main loop has not consumed the previous frame yet we
 214   3                         overwrite it; the newer data is always preferred. */
 215   3                      rx_frame_data   = (uint16_t)uart_rx_buf[0]
 216   3                                      | (((uint16_t)(uart_rx_buf[1] & 0x7Fu)) << 8);
 217   3                      rx_frame_red    = (uint16_t)uart_rx_buf[2]
 218   3                                      | (((uint16_t)(uart_rx_buf[3] & 0x03u)) << 8);
 219   3                      rx_frame_parity = (uart_rx_buf[1] >> 7) & 0x01u;
 220   3                      rx_frame_ready  = 1u;
 221   3                  }
 222   2                  else
 223   2                  {
 224   3                      rx_frame_crc_errors++;
 225   3                      /* 'C' = bridge-link CRC mismatch.  Gated by the latched
 226   3                         debug-mode flag (refreshed only when '~' arrives at
 227   3                         rx_process_bus_state).  Reading the xdata byte from
 228   3                         inside the ISR is faster than calling rx_debug_active(),
 229   3                         which would pin-sample + branch + return.
 230   3      
 231   3                         Nested call into rx_send_uart_byte() from the UART
 232   3                         ISR is safe: the ES=0/ES=1 guards are idempotent
 233   3                         while already inside vector 4, and SBUF's RX and TX
 234   3                         halves are independent hardware. */
 235   3                      if (rx_debug_mode_active)
 236   3                      {
 237   4                          rx_send_uart_byte('C');
 238   4                      }
 239   3                  }
 240   2                  uart_rx_state = UART_RX_WAIT_SOF;
