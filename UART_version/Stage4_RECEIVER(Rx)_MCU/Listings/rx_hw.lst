 119          /*
 120             UART RX BYTE HANDLER -- called from the ISR
 121             ---
 122             A single CRC mismatch aborts the current frame and returns the state
 123             machine to SOF hunt.  A stray 0xAA in the middle of a corrupted
 124             stream will therefore resync at most one frame later.
 125          */
 126          static void uart_handle_rx_byte(uint8_t rx_byte)
 127          {
 128   1          switch (uart_rx_state)
 129   1          {
 130   2              case UART_RX_WAIT_SOF:
 131   2                  if (rx_byte == UART_SOF)
 132   2                  {
 133   3                      uart_rx_count = 0u;
 134   3                      uart_rx_state = UART_RX_COLLECT;
 135   3                  }
 136   2                  break;
 137   2      
 138   2              case UART_RX_COLLECT:
 139   2                  uart_rx_buf[uart_rx_count++] = rx_byte;
 140   2                  if (uart_rx_count >= UART_PAYLOAD_LEN)
 141   2                  {
 142   3                      uart_rx_state = UART_RX_WAIT_CRC;
 143   3                  }
 144   2                  break;
 145   2      
 146   2              case UART_RX_WAIT_CRC:
 147   2              default:
 148   2                  if (rx_byte == uart_crc8(uart_rx_buf, UART_PAYLOAD_LEN))
 149   2                  {
 150   3                      /* Frame is valid -- assemble the 26-bit word.  If the
 151   3                         main loop has not consumed the previous frame yet we
 152   3                         overwrite it; the newer data is always preferred. */
 153   3                      rx_frame_data   = (uint16_t)uart_rx_buf[0]
 154   3                                      | (((uint16_t)(uart_rx_buf[1] & 0x7Fu)) << 8);
 155   3                      rx_frame_red    = (uint16_t)uart_rx_buf[2]
 156   3                                      | (((uint16_t)(uart_rx_buf[3] & 0x03u)) << 8);
 157   3                      rx_frame_parity = (uart_rx_buf[1] >> 7) & 0x01u;
 158   3                      rx_frame_ready  = 1u;
 159   3                  }
 160   2                  else
 161   2                  {
 162   3                      rx_frame_crc_errors++;
 163   3      #if RX_DEBUG
                              /* 'C' = bridge-link CRC mismatch.  Nested call into
                                 rx_send_uart_byte() from the UART ISR is safe: the
                                 ES=0/ES=1 guards are idempotent while already inside
                                 the vector-4 handler, and SBUF's RX and TX halves are
                                 independent hardware. */
                              rx_send_uart_byte('C');
              #endif
 171   3                  }
 172   2                  uart_rx_state = UART_RX_WAIT_SOF;
 173   2                  break;
 174   2          }
 175   1      }
