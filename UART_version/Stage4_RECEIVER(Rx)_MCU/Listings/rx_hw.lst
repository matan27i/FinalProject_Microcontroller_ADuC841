 106          /*
 107             CRC-8 HELPER (poly 0x07, init 0x00, no reflection)
 108             ---
 109             Must match the bridge's crc8().  Keil C51 generates ~8 cycles per
 110             inner iteration, so 32 iterations per frame = ~23 us at 11.0592 MHz
 111             core -- well under the 87 us UART byte time.
 112          */
 113          /* NOTE: parameter is named `buf` rather than `data` because `data` is a
 114             Keil C51 reserved memory-space keyword (alongside xdata/idata/code/
 115             pdata/bdata) -- using it as an identifier yields C141 syntax errors. */
 116          static uint8_t uart_crc8(uint8_t *buf, uint8_t len)
C51 COMPILER V9.60.7.0   RX_HW                                                             05/19/2026 13:14:32 PAGE 3   

 117          {
 118   1          uint8_t crc = 0u;
 119   1          uint8_t i, j;
 120   1      
 121   1          for (i = 0u; i < len; i++)
 122   1          {
 123   2              crc ^= buf[i];
 124   2              for (j = 0u; j < 8u; j++)
 125   2              {
 126   3                  if (crc & 0x80u)
 127   3                  {
 128   4                      crc = (uint8_t)((crc << 1) ^ UART_CRC_POLY);
 129   4                  }
 130   3                  else
 131   3                  {
 132   4                      crc = (uint8_t)(crc << 1);
 133   4                  }
 134   3              }
 135   2          }
 136   1          return crc;
 137   1      }
