 234          /*
 235             RX_UART_Init -- SCON Mode 1, full-duplex, interrupt-driven.
 236          
 237             SCON = 0x50:
C51 COMPILER V9.60.7.0   RX_HW                                                             04/23/2026 23:50:14 PAGE 5   

 238               SM0=0, SM1=1   -> Mode 1 (8-bit async UART, variable baud)
 239               SM2=0          -> No multiprocessor framing
 240               REN=1          -> Receive enabled (NEW: was 0 in SPI version)
 241               TB8=RB8=TI=RI = 0
 242          
 243             ES=1 enables the serial interrupt; the ISR handles both RI and TI.
 244             TI starts at 0: the first rx_send_uart_byte() will prime SBUF.
 245          
 246             The MOV-as-byte style (rather than individual sbit writes to SM0/SM1)
 247             avoids the SMOD0 trap documented on the TX side -- when SMOD0=1 in
 248             PCON, SM0 aliases to a framing-error flag and sbit writes silently
 249             miss SCON.7.
 250          */
 251          void RX_UART_Init(void)
 252          {
 253   1          SCON    = 0x50u;
 254   1          tx_busy = 0;
 255   1          tx_head = 0;
 256   1          tx_tail = 0;
 257   1          uart_rx_state       = UART_RX_WAIT_SOF;
 258   1          uart_rx_count       = 0;
 259   1          rx_frame_ready      = 0;
 260   1          rx_frame_data       = 0;
 261   1          rx_frame_red        = 0;
 262   1          rx_frame_parity     = 0;
 263   1          rx_frame_crc_errors = 0;
 264   1      
 265   1          ES = 1;
 266   1          /* EA is set by the caller after all peripherals are initialised. */
