 147          /*
 148             CRC-8 HELPER (poly 0x07, init 0x00, no reflection)
 149             ---
 150             Must match the bridge's crc8().  Keil C51 generates ~8 cycles per
 151             inner iteration, so 32 iterations per frame = ~23 us at 11.0592 MHz
 152             core -- well under the 87 us UART byte time.
 153          */
 154          /* NOTE: parameter is named `buf` rather than `data` because `data` is a
 155             Keil C51 reserved memory-space keyword (alongside xdata/idata/code/
 156             pdata/bdata) -- using it as an identifier yields C141 syntax errors. */
 157          static uint8_t uart_crc8(uint8_t *buf, uint8_t len)
 158          {
 159   1          uint8_t crc = 0u;
 160   1          uint8_t i, j;
 161   1      
 162   1          for (i = 0u; i < len; i++)
 163   1          {
 164   2              crc ^= buf[i];
 165   2              for (j = 0u; j < 8u; j++)
 166   2              {
 167   3                  if (crc & 0x80u)
 168   3                  {
 169   4                      crc = (uint8_t)((crc << 1) ^ UART_CRC_POLY);
 170   4                  }
 171   3                  else
 172   3                  {
 173   4                      crc = (uint8_t)(crc << 1);
 174   4                  }
 175   3              }
 176   2          }
 177   1          return crc;
 178   1      }
