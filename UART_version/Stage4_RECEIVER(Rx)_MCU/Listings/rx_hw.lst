 178          /*
C51 COMPILER V9.60.7.0   RX_HW                                                             04/25/2026 20:51:51 PAGE 4   

 179             UART ISR (vector 4, address 0x23)
 180             ---
 181             Serves both RI (receive) and TI (transmit) on the single 8052 UART.
 182             Priority-wise RI is handled first so that a simultaneous RI+TI (rare
 183             at 115200, but possible when a new start bit arrives as the previous
 184             byte finishes shifting out) is drained promptly.
 185          
 186             TI handling: if there is buffered data, shove the next byte into
 187             SBUF and keep tx_busy = 1.  Otherwise clear tx_busy and leave TI = 0
 188             so the ISR does not re-fire until the next send primes SBUF again.
 189          */
 190          void UART_ISR(void) interrupt 4
 191          {
 192   1          uint8_t rx_byte;
 193   1      
 194   1          if (RI)
 195   1          {
 196   2              rx_byte = SBUF;
 197   2              RI = 0;
 198   2              uart_handle_rx_byte(rx_byte);
 199   2          }
 200   1      
 201   1          if (TI)
 202   1          {
 203   2              TI = 0;
 204   2              if (tx_tail != tx_head)
 205   2              {
 206   3                  SBUF = tx_buf[tx_tail];
 207   3                  tx_tail = (tx_tail + 1u) % TX_BUF_SIZE;
 208   3              }
 209   2              else
 210   2              {
 211   3                  tx_busy = 0;
 212   3              }
 213   2          }
 214   1      }
