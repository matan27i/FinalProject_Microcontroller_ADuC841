  47          /* 
  48             rx_compute_syndrome
  49          */
  50          uint8_t rx_compute_syndrome(uint16_t bus_state)
  51          {
  52   1          uint8_t  syndrome = 0;
  53   1          uint8_t  col_idx;
  54   1          uint16_t temp;
C51 COMPILER V9.60.7.0   RX_DECODER                                                        05/19/2026 13:14:32 PAGE 2   

  55   1      
  56   1          temp = bus_state & BUS_STATE_MASK;
  57   1      
  58   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  59   1          {
  60   2              if (temp & 0x0001u)
  61   2              {
  62   3                  syndrome ^= col_idx;
  63   3              }
  64   2              temp >>= 1;
  65   2          }
  66   1      
  67   1          return (syndrome & 0x0Fu);
  68   1      }
