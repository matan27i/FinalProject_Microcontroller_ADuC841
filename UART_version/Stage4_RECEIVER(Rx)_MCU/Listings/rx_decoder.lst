  75          void rx_process_bus_state(uint16_t bus_state)
  76          {
  77   1          uint8_t data_nibble;
  78   1          uint8_t complete_byte;
  79   1      
  80   1          /* Alignment recovery: if a previous PESEC_UNCORRECTABLE event left
  81   1             us off by one nibble, drop this frame to restore even parity with
  82   1             the TX byte boundary.  See rx_skip_next_frame in this file. */
  83   1          if (rx_skip_next_frame)
  84   1          {
  85   2              rx_skip_next_frame = 0;
  86   2              return;
  87   2          }
  88   1      
  89   1          data_nibble = rx_compute_syndrome(bus_state);
  90   1      
  91   1          switch (rx_current_state)
  92   1          {
  93   2              case RX_STATE_WAIT_HIGH:
  94   2                  rx_stored_high_nibble = data_nibble & 0x0Fu;
  95   2                  rx_current_state      = RX_STATE_WAIT_LOW;
  96   2                  break;
  97   2      
  98   2              case RX_STATE_WAIT_LOW:
  99   2                  complete_byte = (uint8_t)((rx_stored_high_nibble << 4)
 100   2                                   | (data_nibble & 0x0Fu));
 101   2      
 102   2                  rx_send_uart_byte(complete_byte);
 103   2      
 104   2                  rx_bytes_decoded++;
 105   2                  rx_current_state      = RX_STATE_WAIT_HIGH;
 106   2                  rx_stored_high_nibble = 0;
 107   2                  break;
 108   2      
 109   2              default:
 110   2                  rx_reset_state_machine();
 111   2                  break;
 112   2          }
 113   1      }
