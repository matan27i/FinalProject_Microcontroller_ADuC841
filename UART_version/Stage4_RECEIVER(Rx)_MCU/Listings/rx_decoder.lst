  31          uint8_t rx_compute_syndrome(uint16_t bus_state)
  32          {
  33   1          uint8_t  syndrome = 0;
  34   1          uint8_t  col_idx;
  35   1          uint16_t temp;
  36   1      
  37   1          temp = bus_state & BUS_STATE_MASK; // filter to 15 bits
  38   1      
  39   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  40   1          {
  41   2              if (temp & 0x0001u)
