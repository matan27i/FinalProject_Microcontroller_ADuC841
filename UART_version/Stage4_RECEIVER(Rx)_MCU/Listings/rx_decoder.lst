  27          /* Byte-alignment recovery flag.
  28             ---
  29             Each uncorrectable PESEC frame drops exactly one nibble.  For the
  30             nibble FSM to remain aligned to TX byte boundaries, the total number
  31             of dropped nibbles per recovery window must be EVEN.  When the FSM
  32             was WAIT_HIGH at the time of an uncorrectable, we dropped a HIGH
  33             nibble (odd count) -- the next clean frame is its LOW partner and
  34             must be skipped to restore even parity.  When the FSM was WAIT_LOW,
  35             resetting the FSM also discards the orphaned stored HIGH, which
  36             already accounts for two effective drops (the stored HIGH + the
  37             uncorrectable LOW), so no extra skip is needed.
  38          
  39             Toggle (^=1) rather than set (=1) so consecutive uncorrectables
  40             self-cancel correctly: e.g. two uncorrectables in WAIT_HIGH drop two
  41             nibbles total -- skip count goes 0 -> 1 -> 0, no extra skip needed.
  42          
  43             [MEM] XDATA. */
  44          volatile uint8_t xdata rx_skip_next_frame = 0;
  45          
