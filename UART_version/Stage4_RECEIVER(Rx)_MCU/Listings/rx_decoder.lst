  56          void rx_process_bus_state(uint16_t bus_state)
  57          {
  58   1          uint8_t data_nibble;
  59   1          uint8_t complete_byte;
  60   1      
  61   1          data_nibble = rx_compute_syndrome(bus_state);
  62   1      
  63   1          switch (rx_current_state) // FSM
  64   1          {
  65   2              case RX_STATE_WAIT_HIGH:
  66   2                  rx_stored_high_nibble = data_nibble & 0x0Fu; 
  67   2                  rx_current_state      = RX_STATE_WAIT_LOW;
  68   2                  break;
  69   2      
  70   2              case RX_STATE_WAIT_LOW:
  71   2                  complete_byte = (uint8_t)((rx_stored_high_nibble << 4)
  72   2                                   | (data_nibble & 0x0Fu)); // create full Byte
  73   2      
  74   2                  rx_send_uart_byte(complete_byte);
  75   2      
  76   2                  rx_bytes_decoded++;
  77   2                  rx_byte_ready         = 1;
  78   2                  rx_current_state      = RX_STATE_WAIT_HIGH;
  79   2                  rx_stored_high_nibble = 0;
  80   2                  break;
  81   2      
  82   2              default:
  83   2                  rx_reset_state_machine();
  84   2                  break;
  85   2          }
  86   1      }
