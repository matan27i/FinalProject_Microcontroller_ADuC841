  24          
  25          uint16_t current_bus_state = 0;
  26          
  27          /* =========================================================================
  28           * SYNDROME COMPUTATION
  29           * ========================================================================= */
  30          uint8_t compute_syndrome_from_bus(uint16_t bus_state)
  31          {
  32   1          uint8_t  syndrome = 0;
  33   1          uint8_t  col_idx;
  34   1          uint16_t temp_state;
  35   1      
  36   1          temp_state = bus_state & BUS_STATE_MASK;
  37   1      
  38   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  39   1          {
  40   2              if (temp_state & 0x0001)
  41   2              {
  42   3                  syndrome ^= col_idx;
  43   3              }
  44   2              temp_state >>= 1;
  45   2          }
  46   1      
  47   1          return syndrome;
  48   1      }
  49          
  50          /* 
  51           * MINIMAL-WEIGHT CODEWORD SEARCH
  52           */
  53          uint16_t find_minimal_w(uint8_t s_target)
  54          {
C51 COMPILER V9.60.7.0   TX_ENCODER                                                        05/19/2026 12:44:07 PAGE 2   

  55   1          s_target &= 0x0F;
  56   1      
  57   1          if (s_target == 0)
  58   1          {
  59   2              return 0;
  60   2          }
  61   1      
  62   1          return ((uint16_t)1 << (s_target - 1));
  63   1      }
  64          
  65          /* 
  66           * PROCESS NIBBLE  (Core Stateful Encoder)
  67           */
  68          void process_nibble(uint8_t s_new)
  69          {
  70   1          uint8_t  s_old;
  71   1          uint8_t  s_target;
  72   1          uint16_t w;
  73   1      
