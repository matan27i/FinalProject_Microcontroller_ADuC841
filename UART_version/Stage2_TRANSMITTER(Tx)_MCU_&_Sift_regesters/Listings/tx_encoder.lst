  91          void tx_handler(uint8_t rx_char)
  92          {
  93   1          uint8_t high_nibble;
  94   1          uint8_t low_nibble;
  95   1      
  96   1          /* --- Batch terminators -- silently discard '\r' and '\n' so the
  97   1             host can use either line ending without encoding it as data. */
  98   1          if (rx_char == '\r' || rx_char == '\n')
