 163          /*
 164           * SHIFT-REGISTER OUTPUT DRIVER
 165           * [W4] Serialises the full 26-bit word (10 ECC + 1 parity + 15 data) into
 166           * 4 daisy-chained 74HC595 shift registers, then pulses the latch.
 167           *
 168           * SHIFT ORDER (first bit shifted -> farthest from SER input -> deepest chip):
 169           *   Phase 0: 10 ECC redundancy bits (pesec_redundancy_reg, MSB-first)
 170           *   Phase 1:  1 overall parity bit  (pesec_overall_parity)
 171           *   Phase 2: 15 data bits           (current_bus_state, MSB-first)
 172           *   Phase 3:  Latch pulse
 173           *
 174           * After 26 shifts + latch, the chain holds:
 175           *   Chip 1 (closest to SER):  QA..QH = data[0..7]   -> PA0..PA7
 176           *   Chip 2:                   QA..QG = data[8..14]  -> PC0..PC6
 177           *                             QH     = parity       -> PC7
 178           *   Chip 3:                   QA..QH = red[0..7]    -> PK0..PK7
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:44:08 PAGE 4   

 179           *   Chip 4 (deepest):         QA     = red[8]       -> PF0
 180           *                             QB     = red[9]       -> PF1
 181           *                             QC..QH = stale (unused by bridge)
 182           *
 183           * [BUG FIX] An earlier revision shifted parity in Phase 0 (FIRST), which
 184           * placed it at the deepest chip-4 QB position rather than chip-2 QH.  The
 185           * Mega bridge then read red[0] as parity, parity as red[9], and the rest
 186           * of the redundancy bits one position off.  See the inline comment in the
 187           * function body for the full position mapping.
 188           */
 189          void output_to_shift_registers(void)
 190          {
 191   1          uint16_t state_copy;
 192   1          uint16_t ecc_copy;
 193   1          uint8_t  parity_copy;
 194   1          signed char bit_pos;
 195   1          uint8_t bit_value;
 196   1      
 197   1          /* Snapshot all three values for consistency during output. */
 198   1          state_copy  = current_bus_state & BUS_STATE_MASK;
 199   1          ecc_copy    = pesec_redundancy_reg & PESEC_RED_MASK;
 200   1          parity_copy = pesec_overall_parity & 0x01u;
 201   1      
 202   1          /* [FIX] Ensure Mode-0 (single clock-pulse) for all bit shifts.
 203   1           * Guards against stale flag_t2_mod if this function is ever
 204   1           * entered from an unexpected context. */
 205   1          flag_t2_mod = 0;
 206   1      
 207   1          /* --- Phase 0: Shift out 10 ECC redundancy bits (MSB-first) ---
 208   1           *
 209   1           * [BUG FIX] The previous revision shifted the overall parity bit FIRST
 210   1           * (Phase 0), assuming "parity shifted first arrives at PC7 / chip-2 QH."
 211   1           * That assumption is wrong for a 4-chip 26-bit daisy chain: the FIRST
 212   1           * bit shifted ends up in the DEEPEST chip (chip 4), not in chip 2.
 213   1           *
 214   1           * With the old order the physical pin assignments came out misaligned:
 215   1           *     PC7  (chip 2 QH) = red[0]    <- bridge thinks this is parity
 216   1           *     PK0..PK7         = red[1..8] <- bridge thinks red[0..7]
 217   1           *     PF0  (chip 4 QA) = red[9]    <- bridge thinks red[8]
 218   1           *     PF1  (chip 4 QB) = parity    <- bridge thinks red[9]
 219   1           *
 220   1           * The correct order to land each field at the documented Mega pin --
 221   1           *     PA0..PA7  = data[0..7]    (chip 1, positions 1..8 from input)
 222   1           *     PC0..PC6  = data[8..14]   (chip 2, positions 9..15)
 223   1           *     PC7       = parity        (chip 2 QH, position 16)
 224   1           *     PK0..PK7  = red[0..7]     (chip 3, positions 17..24)
 225   1           *     PF0       = red[8]        (chip 4 QA, position 25)
 226   1           *     PF1       = red[9]        (chip 4 QB, position 26)
 227   1           * is to shift in the order: red[9..0] FIRST (oldest, lands deepest),
 228   1           * THEN parity (the 11th bit, lands at chip-2 QH = PC7),
 229   1           * THEN data[14..0] LAST (newest, lands at chip 1 + chip 2 QA..QG). */
 230   1          for (bit_pos = 9; bit_pos >= 0; bit_pos--)
 231   1          {
 232   2              bit_value = (uint8_t)((ecc_copy >> bit_pos) & 0x0001);
 233   2              SR_DATA   = bit_value;
 234   2      
 235   2              counter_t2 = 0;
 236   2              TH2 = T2_RELOAD_H;
 237   2              TL2 = T2_RELOAD_L;
 238   2              TR2 = 1;
 239   2              while (TR2 == 1);
 240   2          }
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:44:08 PAGE 5   

 241   1      
 242   1          /* --- Phase 1: Shift out the 1 overall parity bit ---
 243   1           * Position 16 from input = chip 2 QH = PC7 (Mega pin 30). */
 244   1          SR_DATA = parity_copy;
 245   1      
 246   1          counter_t2 = 0;
 247   1          TH2 = T2_RELOAD_H;
 248   1          TL2 = T2_RELOAD_L;
 249   1          TR2 = 1;
 250   1          while (TR2 == 1);
 251   1      
 252   1          /* --- Phase 2: Shift out 15 data bits (MSB-first) --- */
 253   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
 254   1          {
 255   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
 256   2              SR_DATA   = bit_value;
 257   2      
 258   2              counter_t2 = 0;
 259   2              TH2 = T2_RELOAD_H;
 260   2              TL2 = T2_RELOAD_L;
 261   2              TR2 = 1;
 262   2              while (TR2 == 1);
 263   2          }
 264   1      
 265   1          /* --- Phase 3: Latch pulse (transfer shift reg -> output reg) --- */
 266   1          flag_t2_mod = 2;
 267   1          counter_t2  = 0;
 268   1          TH2 = T2_RELOAD_H;
 269   1          TL2 = T2_RELOAD_L;
 270   1          TR2 = 1;
 271   1          while (TR2 == 1);
 272   1      }
