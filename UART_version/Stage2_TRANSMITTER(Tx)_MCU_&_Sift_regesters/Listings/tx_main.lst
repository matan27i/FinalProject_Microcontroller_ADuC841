 165          /* 
 166           * SHIFT-REGISTER OUTPUT DRIVER
 167           * [W4] Serialises the full 26-bit word (1 parity + 10 ECC + 15 data,
 168           * MSB-first) into daisy-chained 74HC595 shift registers, then pulses
 169           * the latch.
 170           *
 171           * SHIFT ORDER (first bit shifted -> farthest chain position):
 172           *   Phase 0:  1 overall parity bit  (pesec_overall_parity)
 173           *   Phase 1: 10 ECC redundancy bits (pesec_redundancy_reg, MSB-first)
 174           *   Phase 2: 15 data bits           (current_bus_state, MSB-first)
 175           *   Phase 3:  Latch pulse
 176           *
 177           * The parity bit is shifted first so it arrives at the output pin
 178           * connected to the Arduino Mega's PC7 (pin 30).  The ECC and data
C51 COMPILER V9.60.7.0   TX_MAIN                                                           04/26/2026 14:13:31 PAGE 4   

 179           * bits retain their original mapping.
 180           */
 181          void output_to_shift_registers(void)
 182          {
 183   1          uint16_t state_copy;
 184   1          uint16_t ecc_copy;
 185   1          uint8_t  parity_copy;
 186   1          signed char bit_pos;
 187   1          uint8_t bit_value;
 188   1      
 189   1          /* Snapshot all three values for consistency during output. */
 190   1          state_copy  = current_bus_state & BUS_STATE_MASK;
 191   1          ecc_copy    = pesec_redundancy_reg & PESEC_RED_MASK;
 192   1          parity_copy = pesec_overall_parity & 0x01u;
 193   1      
 194   1          /* [FIX] Ensure Mode-0 (single clock-pulse) for all bit shifts.
 195   1           * Guards against stale flag_t2_mod if this function is ever
 196   1           * entered from an unexpected context. */
 197   1          flag_t2_mod = 0;
 198   1      
 199   1          /* --- Phase 0: [W4] Shift out 1 overall parity bit --- */
 200   1          SR_DATA = parity_copy;
 201   1      
 202   1          counter_t2 = 0;
 203   1          TH2 = T2_RELOAD_H;
 204   1          TL2 = T2_RELOAD_L;
 205   1          TR2 = 1;
 206   1          while (TR2 == 1);
 207   1      
 208   1          /* --- Phase 1: Shift out 10 ECC redundancy bits (MSB-first) --- */
 209   1          for (bit_pos = 9; bit_pos >= 0; bit_pos--)
 210   1          {
 211   2              bit_value = (uint8_t)((ecc_copy >> bit_pos) & 0x0001);
 212   2              SR_DATA   = bit_value;
 213   2      
 214   2              counter_t2 = 0;
 215   2              TH2 = T2_RELOAD_H;
 216   2              TL2 = T2_RELOAD_L;
 217   2              TR2 = 1;
 218   2              while (TR2 == 1);
 219   2          }
 220   1      
 221   1          /* --- Phase 2: Shift out 15 data bits (MSB-first) --- */
 222   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
 223   1          {
 224   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
 225   2              SR_DATA   = bit_value;
 226   2      
 227   2              counter_t2 = 0;
 228   2              TH2 = T2_RELOAD_H;
 229   2              TL2 = T2_RELOAD_L;
 230   2              TR2 = 1;
 231   2              while (TR2 == 1);
 232   2          }
 233   1      
 234   1          /* --- Phase 3: Latch pulse (transfer shift reg -> output reg) --- */
 235   1          flag_t2_mod = 2;
 236   1          counter_t2  = 0;
 237   1          TH2 = T2_RELOAD_H;
 238   1          TL2 = T2_RELOAD_L;
 239   1          TR2 = 1;
 240   1          while (TR2 == 1);
C51 COMPILER V9.60.7.0   TX_MAIN                                                           04/26/2026 14:13:31 PAGE 5   

 241   1      }
