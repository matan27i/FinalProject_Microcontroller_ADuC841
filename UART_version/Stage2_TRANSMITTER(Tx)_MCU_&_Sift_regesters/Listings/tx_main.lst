 274          /* 
 275           * MAIN ENTRY POINT
 276           */
 277          void main(void)
 278          {
 279   1          /* [FIX] ADuC841: CD=0 for full-speed core (11.0592 MHz).
 280   1           * Per datasheet p.49, all non-CD bits in PLLCON are reserved
 281   1           * on the ADuC841 and must be written as 0.  The previous
 282   1           * read-modify-write (PLLCON & 0xF8) left reserved bits 6
 283   1           * and 4 set from the power-on default of 0x53. */
 284   1          PLLCON = 0x00;
 285   1      
 286   1          /* [W5] Enable on-chip 2 KB XRAM.  The PESEC matrices in tx_ecc.c
 287   1           * live in XDATA, so MOVX must be able to address the internal RAM
 288   1           * window.  CFG841 bit 0 (XRAMEN) routes 0x0000..0x07FF to the
 289   1           * on-chip XRAM rather than off-chip; without this, MOVX silently
 290   1           * misses and the matrices read as 0xFF. */
 291   1          CFG841 |= 0x01;
 292   1      
 293   1          Port_Init();
 294   1          BaudRate_Init();
 295   1          UART_Init();
 296   1          Init_Timer2();
 297   1      
 298   1          Init_PESEC_Matrices(pesec_config, 2);
 299   1      
 300   1          GlobalINT();
 301   1      
 302   1          while (1)
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:44:08 PAGE 6   

 303   1          {
 304   2              if (rx_tail != rx_head)
 305   2              {
 306   3                  uint8_t rx_byte = rx_buf[rx_tail];
 307   3                  rx_tail = (rx_tail + 1) % RX_BUF_SIZE;
 308   3                  tx_handler(rx_byte);
 309   3              }
 310   2          }
 311   1      }


