 246          void main(void)
 247          {
 248   1          /* [FIX] ADuC841: CD=0 for full-speed core (11.0592 MHz).
 249   1           * Per datasheet p.49, all non-CD bits in PLLCON are reserved
 250   1           * on the ADuC841 and must be written as 0.  The previous
 251   1           * read-modify-write (PLLCON & 0xF8) left reserved bits 6
 252   1           * and 4 set from the power-on default of 0x53. */
 253   1          PLLCON = 0x00;
 254   1      
 255   1          Port_Init();
 256   1          BaudRate_Init();
 257   1          UART_Init();
 258   1          Init_Timer2();
 259   1      
 260   1          Init_PESEC_Matrices(pesec_config, 2);
 261   1      
 262   1          GlobalINT();
 263   1      
 264   1          while (1)
 265   1          {
 266   2              if (rx_tail != rx_head)
 267   2              {
 268   3                  uint8_t rx_byte = rx_buf[rx_tail];
 269   3                  rx_tail = (rx_tail + 1) % RX_BUF_SIZE;
 270   3                  tx_handler(rx_byte);
 271   3              }
 272   2      
 273   2              if (buffer_flag)
 274   2              {
 275   3                  /* No ES guard needed: UART_ISR does not touch buffer_flag or
 276   3                   * buffer_count, so single-byte writes are atomic on the 8052
 277   3                   * and cannot race with the ISR. */
 278   3                  buffer_flag  = 0;
 279   3                  buffer_count = 0;
 280   3              }
 281   2          }
 282   1      }


