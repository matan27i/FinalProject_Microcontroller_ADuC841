 278          /* 
 279           * MAIN ENTRY POINT
 280           */
 281          void main(void)
 282          {
 283   1          /* [FIX] ADuC841: CD=0 for full-speed core (11.0592 MHz).
 284   1           * Per datasheet p.49, all non-CD bits in PLLCON are reserved
 285   1           * on the ADuC841 and must be written as 0.  The previous
 286   1           * read-modify-write (PLLCON & 0xF8) left reserved bits 6
 287   1           * and 4 set from the power-on default of 0x53. */
 288   1          PLLCON = 0x00;
 289   1      
 290   1          /* [W5] Enable on-chip 2 KB XRAM.  The PESEC matrices in tx_ecc.c
 291   1           * live in XDATA, so MOVX must be able to address the internal RAM
 292   1           * window.  CFG841 bit 0 (XRAMEN) routes 0x0000..0x07FF to the
 293   1           * on-chip XRAM rather than off-chip; without this, MOVX silently
 294   1           * misses and the matrices read as 0xFF. */
 295   1          CFG841 |= 0x01;
 296   1      
 297   1          Port_Init();
 298   1          BaudRate_Init();
 299   1          UART_Init();
 300   1          Init_Timer2();
 301   1      
 302   1          Init_PESEC_Matrices(pesec_config, 2);
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:02:45 PAGE 6   

 303   1      
 304   1          GlobalINT();
 305   1      
 306   1          while (1)
 307   1          {
 308   2              if (rx_tail != rx_head)
 309   2              {
 310   3                  uint8_t rx_byte = rx_buf[rx_tail];
 311   3                  rx_tail = (rx_tail + 1) % RX_BUF_SIZE;
 312   3                  tx_handler(rx_byte);
 313   3              }
 314   2      
 315   2              if (buffer_flag)
 316   2              {
 317   3                  /* No ES guard needed: UART_ISR does not touch buffer_flag or
 318   3                   * buffer_count, so single-byte writes are atomic on the 8052
 319   3                   * and cannot race with the ISR. */
 320   3                  buffer_flag  = 0;
 321   3                  buffer_count = 0;
 322   3              }
 323   2          }
 324   1      }


