 167          /*
 168           * SHIFT-REGISTER OUTPUT DRIVER
 169           * [W4] Serialises the full 26-bit word (10 ECC + 1 parity + 15 data) into
 170           * 4 daisy-chained 74HC595 shift registers, then pulses the latch.
 171           *
 172           * SHIFT ORDER (first bit shifted -> farthest from SER input -> deepest chip):
 173           *   Phase 0: 10 ECC redundancy bits (pesec_redundancy_reg, MSB-first)
 174           *   Phase 1:  1 overall parity bit  (pesec_overall_parity)
 175           *   Phase 2: 15 data bits           (current_bus_state, MSB-first)
 176           *   Phase 3:  Latch pulse
 177           *
 178           * After 26 shifts + latch, the chain holds:
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:02:45 PAGE 4   

 179           *   Chip 1 (closest to SER):  QA..QH = data[0..7]   -> PA0..PA7
 180           *   Chip 2:                   QA..QG = data[8..14]  -> PC0..PC6
 181           *                             QH     = parity       -> PC7
 182           *   Chip 3:                   QA..QH = red[0..7]    -> PK0..PK7
 183           *   Chip 4 (deepest):         QA     = red[8]       -> PF0
 184           *                             QB     = red[9]       -> PF1
 185           *                             QC..QH = stale (unused by bridge)
 186           *
 187           * [BUG FIX] An earlier revision shifted parity in Phase 0 (FIRST), which
 188           * placed it at the deepest chip-4 QB position rather than chip-2 QH.  The
 189           * Mega bridge then read red[0] as parity, parity as red[9], and the rest
 190           * of the redundancy bits one position off.  See the inline comment in the
 191           * function body for the full position mapping.
 192           */
 193          void output_to_shift_registers(void)
 194          {
 195   1          uint16_t state_copy;
 196   1          uint16_t ecc_copy;
 197   1          uint8_t  parity_copy;
 198   1          signed char bit_pos;
 199   1          uint8_t bit_value;
 200   1      
 201   1          /* Snapshot all three values for consistency during output. */
 202   1          state_copy  = current_bus_state & BUS_STATE_MASK;
 203   1          ecc_copy    = pesec_redundancy_reg & PESEC_RED_MASK;
 204   1          parity_copy = pesec_overall_parity & 0x01u;
 205   1      
 206   1          /* [FIX] Ensure Mode-0 (single clock-pulse) for all bit shifts.
 207   1           * Guards against stale flag_t2_mod if this function is ever
 208   1           * entered from an unexpected context. */
 209   1          flag_t2_mod = 0;
 210   1      
 211   1          /* --- Phase 0: Shift out 10 ECC redundancy bits (MSB-first) ---
 212   1           *
 213   1           * [BUG FIX] The previous revision shifted the overall parity bit FIRST
 214   1           * (Phase 0), assuming "parity shifted first arrives at PC7 / chip-2 QH."
 215   1           * That assumption is wrong for a 4-chip 26-bit daisy chain: the FIRST
 216   1           * bit shifted ends up in the DEEPEST chip (chip 4), not in chip 2.
 217   1           *
 218   1           * With the old order the physical pin assignments came out misaligned:
 219   1           *     PC7  (chip 2 QH) = red[0]    <- bridge thinks this is parity
 220   1           *     PK0..PK7         = red[1..8] <- bridge thinks red[0..7]
 221   1           *     PF0  (chip 4 QA) = red[9]    <- bridge thinks red[8]
 222   1           *     PF1  (chip 4 QB) = parity    <- bridge thinks red[9]
 223   1           *
 224   1           * The correct order to land each field at the documented Mega pin --
 225   1           *     PA0..PA7  = data[0..7]    (chip 1, positions 1..8 from input)
 226   1           *     PC0..PC6  = data[8..14]   (chip 2, positions 9..15)
 227   1           *     PC7       = parity        (chip 2 QH, position 16)
 228   1           *     PK0..PK7  = red[0..7]     (chip 3, positions 17..24)
 229   1           *     PF0       = red[8]        (chip 4 QA, position 25)
 230   1           *     PF1       = red[9]        (chip 4 QB, position 26)
 231   1           * is to shift in the order: red[9..0] FIRST (oldest, lands deepest),
 232   1           * THEN parity (the 11th bit, lands at chip-2 QH = PC7),
 233   1           * THEN data[14..0] LAST (newest, lands at chip 1 + chip 2 QA..QG). */
 234   1          for (bit_pos = 9; bit_pos >= 0; bit_pos--)
 235   1          {
 236   2              bit_value = (uint8_t)((ecc_copy >> bit_pos) & 0x0001);
 237   2              SR_DATA   = bit_value;
 238   2      
 239   2              counter_t2 = 0;
 240   2              TH2 = T2_RELOAD_H;
C51 COMPILER V9.60.7.0   TX_MAIN                                                           05/19/2026 12:02:45 PAGE 5   

 241   2              TL2 = T2_RELOAD_L;
 242   2              TR2 = 1;
 243   2              while (TR2 == 1);
 244   2          }
 245   1      
 246   1          /* --- Phase 1: Shift out the 1 overall parity bit ---
 247   1           * Position 16 from input = chip 2 QH = PC7 (Mega pin 30). */
 248   1          SR_DATA = parity_copy;
 249   1      
 250   1          counter_t2 = 0;
 251   1          TH2 = T2_RELOAD_H;
 252   1          TL2 = T2_RELOAD_L;
 253   1          TR2 = 1;
 254   1          while (TR2 == 1);
 255   1      
 256   1          /* --- Phase 2: Shift out 15 data bits (MSB-first) --- */
 257   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
 258   1          {
 259   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
 260   2              SR_DATA   = bit_value;
 261   2      
 262   2              counter_t2 = 0;
 263   2              TH2 = T2_RELOAD_H;
 264   2              TL2 = T2_RELOAD_L;
 265   2              TR2 = 1;
 266   2              while (TR2 == 1);
 267   2          }
 268   1      
 269   1          /* --- Phase 3: Latch pulse (transfer shift reg -> output reg) --- */
 270   1          flag_t2_mod = 2;
 271   1          counter_t2  = 0;
 272   1          TH2 = T2_RELOAD_H;
 273   1          TL2 = T2_RELOAD_L;
 274   1          TR2 = 1;
 275   1          while (TR2 == 1);
 276   1      }
