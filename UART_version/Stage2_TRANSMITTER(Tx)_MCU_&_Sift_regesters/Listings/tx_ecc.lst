 110          static uint8_t calc_pesec_synd(uint16_t reg_val, uint8_t* mat_ptr, uint8_t cols)
 111          {
 112   1          uint8_t synd_res = 0;
 113   1          uint8_t idx;
 114   1      
 115   1          for (idx = 0; idx < cols; idx++)
 116   1          {
