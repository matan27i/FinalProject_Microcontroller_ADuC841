 135          /* =========================================================================
 136           * PARITY COMPUTATION HELPER  (W4 -- SEC+DED)
 137           * =========================================================================
 138           * Computes the population parity (popcount mod 2) of a 16-bit value
 139           * using XOR folding.  Optimised for the 8051 instruction set:
 140           *   1. XOR the high byte into the low byte (one 8-bit XOR).
 141           *   2. Fold the resulting byte: nibbles, pairs, then single bit.
 142           * Total: 5 XORs + 3 shifts + 1 AND -- no branches, no lookup table.
 143           *
 144           * Returns: 0 if the number of set bits is even, 1 if odd.
 145           * ========================================================================= */
 146          static uint8_t parity16(uint16_t v)
 147          {
 148   1          uint8_t x;
 149   1      
 150   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 151   1          x ^= x >> 4;
 152   1          x ^= x >> 2;
 153   1          x ^= x >> 1;
 154   1      
 155   1          return (x & 1u);
 156   1      }
 157          
 158          /* 
 159           * DELTA SOLVER
 160           */
 161          static uint16_t solve_pesec_delta(uint8_t synd_gap)
 162          {
 163   1          uint16_t delta_vec = 0;
 164   1          uint8_t  b, chunk, val;
 165   1      
 166   1          for (b = 0; b < pesec_num_blocks; b++)
 167   1          {
 168   2              chunk = synd_gap & pesec_chunk_masks[b];
 169   2      
 170   2              if (chunk != 0)
 171   2              {
 172   3                  val = chunk >> pesec_bit_offsets[b];
 173   3                  delta_vec |= (1 << (pesec_col_offsets[b] + val - 1));
 174   3              }
 175   2          }
 176   1      
 177   1          return delta_vec;
 178   1      }
