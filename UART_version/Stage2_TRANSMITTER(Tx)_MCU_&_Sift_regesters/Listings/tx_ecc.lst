 185          /* 
 186           * MAIN ECC FUNCTION
 187           * Called after each nibble encoding cycle in process_nibble().
 188           *
 189           * Steps:
 190           *   1. Compute syndrome of data bits (Matrix A x current_bus_state)
 191           *   2. Compute syndrome of redundancy bits (Matrix D x pesec_redundancy_reg)
 192           *   3. XOR to find the syndrome gap
 193           *   4. Solve for the optimal redundancy-bit flip vector
 194           *   5. Apply the differential update to pesec_redundancy_reg
 195           *   6. [W4] Compute overall even parity of all 25 bits
 196           *   7. Output all 26 bits to shift registers
 197           * ========================================================================= */
 198          void ECC(void)
 199          {
 200   1          uint8_t  synd_data;
 201   1          uint8_t  synd_red;
 202   1          uint8_t  synd_diff;
 203   1          uint16_t delta_vector;
 204   1      
 205   1          /* Step 1: Syndrome of the new data */
 206   1          synd_data = get_data_pesec_synd(current_bus_state);
 207   1      
 208   1          /* Step 2: Syndrome of the current redundancy */
 209   1          synd_red = get_red_pesec_synd(pesec_redundancy_reg);
 210   1      
 211   1          /* Step 3: Syndrome gap */
 212   1          synd_diff = synd_data ^ synd_red;
 213   1      
 214   1          /* Step 4: Solve for minimal redundancy flip */
 215   1          delta_vector = solve_pesec_delta(synd_diff);
 216   1      
 217   1          /* Step 5: Apply differential update */
 218   1          pesec_redundancy_reg ^= delta_vector;
 219   1      
 220   1          /* Step 6: [W4] Compute overall even parity of all 25 bits.
 221   1           *
 222   1           * P = parity(data[14:0]) XOR parity(redundancy[9:0])
 223   1           *
 224   1           * The parity of the 25-bit concatenation [data | red] equals the
 225   1           * XOR of the individual parities because parity is linear over
 226   1           * disjoint bit fields.  The receiver checks:
 227   1           *   received_P XOR parity(received_data) XOR parity(received_red)
 228   1           * and combines the result with the PESEC syndrome to distinguish
 229   1           * single errors (correctable) from double errors (detectable). */
 230   1          pesec_overall_parity = parity16(current_bus_state & BUS_STATE_MASK)
 231   1                               ^ parity16(pesec_redundancy_reg & PESEC_RED_MASK);
 232   1      
 233   1          /* Step 7: Output 26 bits to daisy-chained shift registers */
 234   1          output_to_shift_registers();
 235   1      }


