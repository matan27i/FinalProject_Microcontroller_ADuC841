  57          void Init_PESEC_Matrices(uint8_t* m_sizes, uint8_t num_blocks)
  58          {
  59   1          uint8_t i, b, val;
  60   1          uint8_t is_in_d;
  61   1          uint8_t total_m = 0;
  62   1          uint8_t current_col_offset = 0;
  63   1          uint8_t max_syndrome;
  64   1      
  65   1          pesec_num_blocks = num_blocks;
  66   1          pesec_num_d_cols = 0;
  67   1          pesec_num_a_cols = 0;
  68   1      
  69   1          for (b = 0; b < num_blocks; b++)
  70   1          {
  71   2              pesec_bit_offsets[b] = total_m;
  72   2              pesec_col_offsets[b] = current_col_offset;
  73   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  74   2      
  75   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  76   2              {
  77   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  78   3              }
  79   2      
  80   2              total_m += m_sizes[b];
  81   2              current_col_offset += ((1 << m_sizes[b]) - 1);
  82   2          }
  83   1      
  84   1          max_syndrome = (1 << total_m) - 1;
  85   1      
  86   1          for (val = 1; val <= max_syndrome; val++)
  87   1          {
  88   2              is_in_d = 0;
  89   2      
  90   2              for (i = 0; i < pesec_num_d_cols; i++)
  91   2              {
  92   3                  if (PESEC_MAT_D[i] == val)
  93   3                  {
  94   4                      is_in_d = 1;
  95   4                      break;
  96   4                  }
  97   3              }
  98   2      
  99   2              if (is_in_d == 0)
 100   2              {
 101   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 102   3              }
 103   2          }
 104   1      }
