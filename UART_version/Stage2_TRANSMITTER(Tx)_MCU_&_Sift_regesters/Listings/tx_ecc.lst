  46          uint8_t pesec_bit_offsets[MAX_PESEC_BLOCKS];
  47          uint8_t pesec_col_offsets[MAX_PESEC_BLOCKS];
  48          uint8_t pesec_chunk_masks[MAX_PESEC_BLOCKS];
  49          
