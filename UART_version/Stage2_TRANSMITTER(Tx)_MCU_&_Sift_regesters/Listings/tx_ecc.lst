 140          /* =========================================================================
 141           * PARITY COMPUTATION HELPER  (W4 -- SEC+DED)
 142           * =========================================================================
 143           * Computes the population parity (popcount mod 2) of a 16-bit value
 144           * using XOR folding.  Optimised for the 8051 instruction set:
 145           *   1. XOR the high byte into the low byte (one 8-bit XOR).
 146           *   2. Fold the resulting byte: nibbles, pairs, then single bit.
 147           * Total: 5 XORs + 3 shifts + 1 AND -- no branches, no lookup table.
 148           *
 149           * Returns: 0 if the number of set bits is even, 1 if odd.
 150           * ========================================================================= */
 151          static uint8_t parity16(uint16_t v)
 152          {
 153   1          uint8_t x;
 154   1      
 155   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 156   1          x ^= x >> 4;
 157   1          x ^= x >> 2;
 158   1          x ^= x >> 1;
 159   1      
 160   1          return (x & 1u);
 161   1      }
 162          
 163          /* 
 164           * DELTA SOLVER
 165           */
 166          static uint16_t solve_pesec_delta(uint8_t synd_gap)
 167          {
 168   1          uint16_t delta_vec = 0;
 169   1          uint8_t  b, chunk, val;
 170   1      
 171   1          for (b = 0; b < pesec_num_blocks; b++)
 172   1          {
 173   2              chunk = synd_gap & pesec_chunk_masks[b];
 174   2      
 175   2              if (chunk != 0)
 176   2              {
 177   3                  val = chunk >> pesec_bit_offsets[b];
 178   3                  delta_vec |= (1 << (pesec_col_offsets[b] + val - 1));
C51 COMPILER V9.60.7.0   TX_ECC                                                            05/04/2026 12:33:31 PAGE 4   

 179   3              }
 180   2          }
 181   1      
 182   1          return delta_vec;
 183   1      }
