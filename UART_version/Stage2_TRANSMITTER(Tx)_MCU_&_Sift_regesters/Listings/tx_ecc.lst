 180          /* 
 181           * MAIN ECC FUNCTION
 182           * Called after each nibble encoding cycle in process_nibble().
 183           *
 184           * Steps:
 185           *   1. Compute syndrome of data bits (Matrix A x current_bus_state)
 186           *   2. Compute syndrome of redundancy bits (Matrix D x pesec_redundancy_reg)
 187           *   3. XOR to find the syndrome gap
 188           *   4. Solve for the optimal redundancy-bit flip vector
 189           *   5. Apply the differential update to pesec_redundancy_reg
 190           *   6. [W4] Compute overall even parity of all 25 bits
 191           *   7. Output all 26 bits to shift registers
 192           * ========================================================================= */
 193          void ECC(void)
 194          {
 195   1          uint8_t  synd_data;
 196   1          uint8_t  synd_red;
 197   1          uint8_t  synd_diff;
 198   1          uint16_t delta_vector;
 199   1      
 200   1          /* Step 1: Syndrome of the new data */
 201   1          synd_data = get_data_pesec_synd(current_bus_state);
 202   1      
 203   1          /* Step 2: Syndrome of the current redundancy */
 204   1          synd_red = get_red_pesec_synd(pesec_redundancy_reg);
 205   1      
 206   1          /* Step 3: Syndrome gap */
 207   1          synd_diff = synd_data ^ synd_red;
 208   1      
 209   1          /* Step 4: Solve for minimal redundancy flip */
 210   1          delta_vector = solve_pesec_delta(synd_diff);
 211   1      
 212   1          /* Step 5: Apply differential update */
 213   1          pesec_redundancy_reg ^= delta_vector;
 214   1      
 215   1          /* Step 6: [W4] Compute overall even parity of all 25 bits.
 216   1           *
 217   1           * P = parity(data[14:0]) XOR parity(redundancy[9:0])
 218   1           *
 219   1           * The parity of the 25-bit concatenation [data | red] equals the
 220   1           * XOR of the individual parities because parity is linear over
 221   1           * disjoint bit fields.  The receiver checks:
 222   1           *   received_P XOR parity(received_data) XOR parity(received_red)
 223   1           * and combines the result with the PESEC syndrome to distinguish
 224   1           * single errors (correctable) from double errors (detectable). */
 225   1          pesec_overall_parity = parity16(current_bus_state & BUS_STATE_MASK)
 226   1                               ^ parity16(pesec_redundancy_reg & PESEC_RED_MASK);
 227   1      
 228   1          /* Step 7: Output 26 bits to daisy-chained shift registers */
 229   1          output_to_shift_registers();
 230   1      }


