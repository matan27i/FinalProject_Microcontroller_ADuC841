  59          /* 
  60           * MATRIX INITIALISATION
  61           */
  62          void Init_PESEC_Matrices(uint8_t* m_sizes, uint8_t num_blocks)
  63          {
  64   1          uint8_t i, b, val;
  65   1          uint8_t is_in_d;
  66   1          uint8_t total_m = 0;
  67   1          uint8_t current_col_offset = 0;
  68   1          uint8_t max_syndrome;
  69   1      
  70   1          pesec_num_blocks = num_blocks;
  71   1          pesec_num_d_cols = 0;
  72   1          pesec_num_a_cols = 0;
  73   1      
  74   1          for (b = 0; b < num_blocks; b++)
  75   1          {
  76   2              pesec_bit_offsets[b] = total_m;
  77   2              pesec_col_offsets[b] = current_col_offset;
  78   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  79   2      
  80   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  81   2              {
  82   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  83   3              }
  84   2      
  85   2              total_m += m_sizes[b];
  86   2              current_col_offset += ((1 << m_sizes[b]) - 1);
  87   2          }
  88   1      
  89   1          max_syndrome = (1 << total_m) - 1;
  90   1      
  91   1          for (val = 1; val <= max_syndrome; val++)
  92   1          {
  93   2              is_in_d = 0;
  94   2      
  95   2              for (i = 0; i < pesec_num_d_cols; i++)
  96   2              {
  97   3                  if (PESEC_MAT_D[i] == val)
  98   3                  {
  99   4                      is_in_d = 1;
 100   4                      break;
 101   4                  }
 102   3              }
 103   2      
 104   2              if (is_in_d == 0)
 105   2              {
 106   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 107   3              }
 108   2          }
 109   1      }
