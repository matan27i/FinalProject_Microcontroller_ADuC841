  55   2              if (temp_state & 0x0001)
  56   2              {
  57   3                  syndrome ^= col_idx;
  58   3              }
  59   2              temp_state >>= 1;
  60   2          }
  61   1      
  62   1          return syndrome;
  63   1      }
  64          
  65          /* =========================================================================
  66           * MINIMAL-WEIGHT CODEWORD SEARCH
  67           * =========================================================================
  68           * Exploits H1-type structure:
  69           *   s_target == 0  →  w = 0          (weight-0, no change)
  70           *   s_target != 0  →  w = 1 << (s-1) (weight-1, single bit flip)
  71           * Provably minimal and fully deterministic.
  72           * ========================================================================= */
  73          uint16_t find_minimal_w(uint8_t s_target)
  74          {
  75   1          s_target &= 0x0F;
  76   1      
  77   1          if (s_target == 0)
  78   1          {
  79   2              return 0;
  80   2          }
  81   1      
  82   1          return ((uint16_t)1 << (s_target - 1));
  83   1      }
