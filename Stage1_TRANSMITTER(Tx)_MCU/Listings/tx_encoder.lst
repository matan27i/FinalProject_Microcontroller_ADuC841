   8           *   - Syndrome computation (on-the-fly, no lookup tables)
   9           *   - Minimal-weight codeword selection (O(1) for H1-type matrices)
  10           *   - process_nibble(): stateful differential encoder
  11           *   - tx_handler(): UART byte → nibble splitter
  12           *
  13           * H1-TYPE MATRIX STRUCTURE (4×15):
  14           *   Column i (1-based) = binary representation of i.
  15           *   Syndrome S = XOR of column indices for every set bit in x.
  16           *
  17           * MINIMAL-WEIGHT SELECTION:
  18           *   For s_target in {1..15}, w = 1 << (s_target - 1)  is weight-1
  19           *   and provably minimal (H1-type minimum distance = 3).
  20           *
  21           * Portability: No hardware dependencies.  Calls ECC() from Group 3
  22           *              (which in turn calls output_to_shift_registers() in
  23           *              Group 1) at the end of each nibble cycle.
  24           */
  25          
  26          #include "tx_header.h"
  27          
  28          /* =========================================================================
  29           * STATE VARIABLE DEFINITIONS  (owned by this module)
  30           * ========================================================================= */
  31          
  32          /* The 15-bit physical bus state vector x.
  33           * Only bits 0..14 are meaningful (BUS_STATE_MASK = 0x7FFF).
  34           * H * current_bus_state^T  gives the current syndrome.
  35           * Initialised to 0 -> syndrome 0, bus in zero state.
  36           * [N2] Not volatile: only accessed from main-loop call chain. */
  37          uint16_t current_bus_state = 0;
  38          
  39          /* =========================================================================
  40           * SYNDROME COMPUTATION
  41           * =========================================================================
  42           * Computes S = H * x^T using the H1-type identity: column i = i.
  43           * No stored matrix.  Loop through set bits and XOR their 1-based index.
  44           * ========================================================================= */
  45          uint8_t compute_syndrome_from_bus(uint16_t bus_state)
  46          {
  47   1          uint8_t  syndrome = 0;
  48   1          uint8_t  col_idx;
  49   1          uint16_t temp_state;
  50   1      
  51   1          temp_state = bus_state & BUS_STATE_MASK;
  52   1      
  53   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  54   1          {
