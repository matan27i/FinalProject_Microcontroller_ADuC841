 120          /* =========================================================================
 121           * TX HANDLER  (UART Character → Nibble Splitter)
 122           * =========================================================================
 123           * INPUT:  8-bit character from UART.
 124           * OUTPUT: Two calls to process_nibble (high nibble first, then low).
 125           *
 126           * Special characters:
 127           *   '\r', '\n'  — Batch terminators.  Set buffer_flag, no nibble output.
 128           *   '='         — Full bus + ECC reset.  Clears shift registers via
 129           *                 hardware clear sequence, resets both state vectors.
 130           * ========================================================================= */
 131          void tx_handler(uint8_t rx_char)
 132          {
 133   1          uint8_t high_nibble;
 134   1          uint8_t low_nibble;
 135   1      
 136   1          /* --- Batch terminators --- */
 137   1          if (rx_char == '\r' || rx_char == '\n')
 138   1          {
 139   2              buffer_flag = 1;
 140   2              return;
 141   2          }
 142   1      
 143   1          /* --- Full reset command --- */
 144   1          if (rx_char == '=')
 145   1          {
 146   2              /* Reset encoder state */
 147   2              current_bus_state = 0;
 148   2      
 149   2              /* FIX: Reset ECC redundancy register to stay in sync */
 150   2              pesec_redundancy_reg = 0;
 151   2      
 152   2              /* Hardware clear of shift registers (Mode 1) */
 153   2              flag_t2_mod = 1;
 154   2              counter_t2  = 0;
 155   2              TH2 = T2_RELOAD_H;
 156   2              TL2 = T2_RELOAD_L;
 157   2              TR2 = 1;
 158   2      
 159   2              /* FIX: Block until clear sequence completes to prevent
 160   2               * race condition with subsequent UART characters */
 161   2              while (TR2 == 1);
 162   2      
 163   2              buffer_flag = 1;
 164   2              return;
 165   2          }
 166   1      
 167   1          /* --- Normal data character: split into two nibbles --- */
 168   1          high_nibble = (rx_char >> 4) & 0x0F;
 169   1          low_nibble  = rx_char & 0x0F;
 170   1      
 171   1          /* Process HIGH nibble first (per protocol spec) */
 172   1          process_nibble(high_nibble);
 173   1      
 174   1          /* Process LOW nibble second */
 175   1          process_nibble(low_nibble);
 176   1      
 177   1          /* [C2] Track nibble count — guard accounts for +2 increment */
 178   1          if (buffer_count <= 253)
