  85          /* =========================================================================
  86           * PROCESS NIBBLE  (Core Stateful Encoder)
  87           * =========================================================================
  88           * Steps:
  89           *   1. S_old    = H * current_bus_state^T
  90           *   2. S_target = S_new XOR S_old
  91           *   3. w        = minimal-weight vector with H * w^T = S_target
  92           *   4. current_bus_state ^= w          (differential toggle)
  93           *   5. Call ECC() to compute redundancy and output all 25 bits
  94           * ========================================================================= */
  95          void process_nibble(uint8_t s_new)
  96          {
  97   1          uint8_t  s_old;
  98   1          uint8_t  s_target;
  99   1          uint16_t w;
