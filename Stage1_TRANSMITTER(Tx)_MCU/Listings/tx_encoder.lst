 101   1          s_new &= 0x0F;
 102   1      
 103   1          /* Step 1: Current syndrome from bus state */
 104   1          s_old = compute_syndrome_from_bus(current_bus_state);
 105   1      
 106   1          /* Step 2: Target syndrome (mod-2 arithmetic) */
 107   1          s_target = s_new ^ s_old;
