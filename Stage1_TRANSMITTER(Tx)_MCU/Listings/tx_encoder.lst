  27          
  28          /* =========================================================================
  29           * SYNDROME COMPUTATION
  30           * ========================================================================= */
  31          uint8_t compute_syndrome_from_bus(uint16_t bus_state)
  32          {
  33   1          uint8_t  syndrome = 0;
  34   1          uint8_t  col_idx;
  35   1          uint16_t temp_state;
  36   1      
  37   1          temp_state = bus_state & BUS_STATE_MASK;
  38   1      
  39   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  40   1          {
