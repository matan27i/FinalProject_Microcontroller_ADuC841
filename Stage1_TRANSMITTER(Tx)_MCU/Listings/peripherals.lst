   1          /* File: peripherals.c
   2            Peripheral Configuration for ADuC841
   3            UART and Timer Setup for H1-Type Bus Encoder
   4           */
   5          
   6          #include <aduc841.h>
   7          #include "header.h"
   8          
   9          /* 
  10            Timer3_Init
  11          -
  12            Configure Timer 3 as UART baud rate generator for 9600 baud.
  13            
  14            ADuC841 Timer 3 configuration for 9600 baud with 11.0592 MHz crystal:
  15            T3CON settings and T3FD fractional divider per datasheet.
  16           */
  17          void Timer3_Init(void)
  18          {
  19   1          T3CON &= 0xFE;  /* Disable Timer 3 */
  20   1          T3CON |= 0x86;  /* Set mode bits for UART baud generation */
  21   1          T3FD = 0x08;    /* Fractional divider for 9600 baud accuracy */
  22   1      }
  23          
  24          /*
  25            UART_Init
  26          
  27            Initialize UART for 8-bit data, no parity, 1 stop bit (8N1).
  28            Baud rate is set by Timer 3.
  29            Enable receive and serial interrupt.
  30           */
  31          void UART_Init(void)
  32          {
  33   1          SM0 = 0;    /* Mode 1: 8-bit UART */
  34   1          SM1 = 1;    /* Mode 1: variable baud rate */
  35   1          REN = 1;    /* Enable receiver */
  36   1          RI = 0;     /* Clear receive interrupt flag */
  37   1          TI = 0;     /* Clear transmit interrupt flag */
  38   1          ES = 1;     /* Enable serial interrupt */
  39   1      }
  40          
  41          /*
  42            GlobalINT
  43          
  44            Enable global interrupt master switch.
  45            
  46           */
  47          void GlobalINT(void)
  48          {
  49   1          EA = 1;     /* Enable All interrupts */
  50   1      }
  51          
  52          /* 
  53            UART_ISR
  54            UART Interrupt Service Routine (Interrupt 4).
C51 COMPILER V9.60.7.0   PERIPHERALS                                                       02/08/2026 15:49:53 PAGE 2   

  55            
  56            On receive (RI):
  57              - Clear RI flag
  58              - Copy SBUF to tx_temp_byte
  59              - Set tx_flag to signal main loop
  60           
  61            On transmit (TI):
  62              - Clear TI flag (not used for transmission in this application)
  63           */
  64          void UART_ISR(void) interrupt 4
  65          {
  66   1          if (RI)
  67   1          {
  68   2              RI = 0;                 /* Clear receive interrupt flag */
  69   2              tx_temp_byte = SBUF;    /* Copy received byte */
  70   2              tx_flag = 1;            /* Signal main loop */
  71   2          }
  72   1          if (TI)
  73   1          {
  74   2              TI = 0;                 /* Clear transmit interrupt flag */
  75   2          }
  76   1      }


