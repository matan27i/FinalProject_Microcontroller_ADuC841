   1          /* File: ecc.c
   2           * Group 3: PESEC Error Correction
   3           * ================================
   4           * Target: ADuC841 (8052 single-cycle core)
   5           *
   6           * Contains:
   7           *   - pesec_redundancy_reg: the 10-bit ECC redundancy vector
   8           *   - Dynamic matrix storage (D and A) and block solver metadata
   9           *   - Init_PESEC_Matrices(): builds D and A from block-size config
  10           *   - Syndrome helpers and delta solver
  11           *   - ECC(): main encode cycle — differential redundancy update + output
  12           *
  13           * PESEC ENCODER OVERVIEW:
  14           *   The encoder maintains a redundancy register R such that [x | R] is
  15           *   always a valid codeword.  When the data vector x changes, a
  16           *   "syndrome gap" is computed and resolved into a minimal set of bit
  17           *   flips (delta_vector) applied to R via XOR.
  18           *
  19           * Portability: Pure algorithmic logic.  The only external call is
  20           *              output_to_shift_registers() from Group 1.
  21           */
  22          
  23          #include "tx_header.h"
  24          
  25          /* =========================================================================
  26           * STATE VARIABLE DEFINITIONS  (owned by this module)
  27           * ========================================================================= */
  28          
  29          /* 10-bit redundancy register, updated differentially.
  30           * [N2] Not volatile: only accessed from main-loop call chain. */
  31          uint16_t pesec_redundancy_reg = 0;
  32          
  33          /* Dynamic matrix storage */
  34          uint8_t PESEC_MAT_D[20];   /* Redundancy-bit columns */
  35          uint8_t PESEC_MAT_A[40];   /* Data-bit columns       */
  36          
  37          /* Block solver metadata */
  38          uint8_t pesec_num_blocks;
  39          uint8_t pesec_bit_offsets[MAX_PESEC_BLOCKS];
  40          uint8_t pesec_col_offsets[MAX_PESEC_BLOCKS];
  41          uint8_t pesec_chunk_masks[MAX_PESEC_BLOCKS];
  42          
  43          /* Column counts */
  44          uint8_t pesec_num_d_cols;
  45          uint8_t pesec_num_a_cols;
  46          
  47          /* =========================================================================
  48           * MATRIX INITIALISATION
  49           * =========================================================================
  50           * Builds matrices D (redundancy columns) and A (data columns) from an
  51           * array of block sizes.  Also pre-computes per-block masks and offsets
  52           * for O(1) delta solving.
  53           *
  54           * For config {m1, m2, ...}:
C51 COMPILER V9.60.7.0   TX_ECC                                                            03/16/2026 15:41:44 PAGE 2   

  55           *   Block b contributes (2^mb - 1) columns to D.
  56           *   A = syndrome-space values NOT present in D.
  57           * ========================================================================= */
  58          void Init_PESEC_Matrices(uint8_t* m_sizes, uint8_t num_blocks)
  59          {
  60   1          uint8_t i, b, val;
  61   1          uint8_t is_in_d;
  62   1          uint8_t total_m = 0;
  63   1          uint8_t current_col_offset = 0;
  64   1          uint8_t max_syndrome;
  65   1      
  66   1          pesec_num_blocks = num_blocks;
  67   1          pesec_num_d_cols = 0;
  68   1          pesec_num_a_cols = 0;
  69   1      
  70   1          /* --- Build Matrix D and pre-calculate solver metadata --- */
  71   1          for (b = 0; b < num_blocks; b++)
  72   1          {
  73   2              pesec_bit_offsets[b] = total_m;
  74   2              pesec_col_offsets[b] = current_col_offset;
  75   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  76   2      
  77   2              /* Each block contributes columns 1..(2^m - 1) shifted by total_m */
  78   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  79   2              {
  80   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  81   3              }
  82   2      
  83   2              total_m += m_sizes[b];
  84   2              current_col_offset += ((1 << m_sizes[b]) - 1);
  85   2          }
  86   1      
  87   1          max_syndrome = (1 << total_m) - 1;
  88   1      
  89   1          /* --- Build Matrix A: everything in syndrome space NOT in D --- */
  90   1          for (val = 1; val <= max_syndrome; val++)
  91   1          {
  92   2              is_in_d = 0;
  93   2      
  94   2              for (i = 0; i < pesec_num_d_cols; i++)
  95   2              {
  96   3                  if (PESEC_MAT_D[i] == val)
  97   3                  {
  98   4                      is_in_d = 1;
  99   4                      break;
 100   4                  }
 101   3              }
 102   2      
 103   2              if (is_in_d == 0)
 104   2              {
 105   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 106   3              }
 107   2          }
 108   1      }
