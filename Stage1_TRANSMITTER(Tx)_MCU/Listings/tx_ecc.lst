 169          /* =========================================================================
 170           * MAIN ECC FUNCTION
 171           * =========================================================================
 172           * Called after each nibble encoding cycle in process_nibble().
 173           *
 174           * Steps:
 175           *   1. Compute syndrome of data bits (Matrix A × current_bus_state)
 176           *   2. Compute syndrome of redundancy bits (Matrix D × pesec_redundancy_reg)
 177           *   3. XOR to find the syndrome gap
 178           *   4. Solve for the optimal redundancy-bit flip vector
C51 COMPILER V9.60.7.0   TX_ECC                                                            03/16/2026 15:41:44 PAGE 4   

 179           *   5. Apply the differential update to pesec_redundancy_reg
 180           *   6. Output all 25 bits to shift registers
 181           * ========================================================================= */
 182          void ECC(void)
 183          {
 184   1          uint8_t  synd_data;
 185   1          uint8_t  synd_red;
 186   1          uint8_t  synd_diff;
 187   1          uint16_t delta_vector;
 188   1      
 189   1          /* Step 1: Syndrome of the new data */
 190   1          synd_data = get_data_pesec_synd(current_bus_state);
 191   1      
 192   1          /* Step 2: Syndrome of the current redundancy */
 193   1          synd_red = get_red_pesec_synd(pesec_redundancy_reg);
 194   1      
 195   1          /* Step 3: Syndrome gap */
 196   1          synd_diff = synd_data ^ synd_red;
 197   1      
 198   1          /* Step 4: Solve for minimal redundancy flip */
 199   1          delta_vector = solve_pesec_delta(synd_diff);
 200   1      
 201   1          /* Step 5: Apply differential update */
 202   1          pesec_redundancy_reg ^= delta_vector;
 203   1      
 204   1          /* Step 6: Output 25 bits to daisy-chained shift registers */
 205   1          output_to_shift_registers();
 206   1      }


