 110          /* =========================================================================
 111           * SYNDROME COMPUTATION HELPERS
 112           * ========================================================================= */
 113          
 114          /* Generic syndrome: XOR matrix columns selected by set bits in reg_val */
 115          static uint8_t calc_pesec_synd(uint16_t reg_val, uint8_t* mat_ptr, uint8_t cols)
 116          {
C51 COMPILER V9.60.7.0   TX_ECC                                                            03/16/2026 15:41:44 PAGE 3   

 117   1          uint8_t synd_res = 0;
 118   1          uint8_t idx;
 119   1      
 120   1          for (idx = 0; idx < cols; idx++)
 121   1          {
 122   2              if ((reg_val >> idx) & 1)
 123   2              {
 124   3                  synd_res ^= mat_ptr[idx];
 125   3              }
 126   2          }
 127   1          return synd_res;
 128   1      }
 129          
 130          /* Syndrome of data bits via Matrix A */
 131          static uint8_t get_data_pesec_synd(uint16_t data_val)
 132          {
 133   1          return calc_pesec_synd(data_val, PESEC_MAT_A, pesec_num_a_cols);
 134   1      }
 135          
 136          /* Syndrome of redundancy bits via Matrix D */
 137          static uint8_t get_red_pesec_synd(uint16_t red_val)
 138          {
 139   1          return calc_pesec_synd(red_val, PESEC_MAT_D, pesec_num_d_cols);
 140   1      }
