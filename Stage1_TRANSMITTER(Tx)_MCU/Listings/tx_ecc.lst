 142          /* =========================================================================
 143           * DELTA SOLVER
 144           * =========================================================================
 145           * Converts a syndrome gap into the minimal set of redundancy-bit flips.
 146           * Iterates through each H1-type sub-block, extracts its chunk of the
 147           * syndrome gap, and maps it to a single bit position in the redundancy
 148           * register.  O(num_blocks) — effectively O(1) for small block counts.
 149           * ========================================================================= */
 150          static uint16_t solve_pesec_delta(uint8_t synd_gap)
 151          {
 152   1          uint16_t delta_vec = 0;
 153   1          uint8_t  b, chunk, val;
 154   1      
 155   1          for (b = 0; b < pesec_num_blocks; b++)
 156   1          {
 157   2              chunk = synd_gap & pesec_chunk_masks[b];
 158   2      
 159   2              if (chunk != 0)
 160   2              {
 161   3                  val = chunk >> pesec_bit_offsets[b];
 162   3                  delta_vec |= (1 << (pesec_col_offsets[b] + val - 1));
 163   3              }
 164   2          }
 165   1      
 166   1          return delta_vec;
 167   1      }
