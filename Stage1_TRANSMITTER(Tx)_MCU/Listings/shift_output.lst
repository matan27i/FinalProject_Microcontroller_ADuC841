   8           /*
   9            delay_half_period - Delay for one half-period of shift register clock
  10            Provides a 5 µs delay for 100 kHz shift register clock timing.
  11           
  12            Calculation:
  13              - Target: 5 µs = 5000 ns
  14              - CPU cycle time: 1 / 11.0592 MHz = 90.422 ns
  15              - Required cycles: 5000 / 90.422 ≈ 55.3 cycles
  16           
  17            Implementation:
  18              - uint8_t initialization: 1 cycle (MOV)
  19              - Loop body: DJNZ (2 cycles) + NOP (1 cycle) = 3 cycles per iteration
  20              - 18 iterations: 18 * 3 = 54 cycles
  21              - Total: 1 + 54 = 55 cycles ≈ 4.973 µs
  22           
  23            Actual timing: 55 * 90.422 ns = 4973 ns = 4.973 µs
  24            Clock frequency: 1 / (2 * 4.973 µs) = 100.5 kHz
  25           
  26            Note: This is a blocking delay. The function disables interrupts during
  27            the shift operation, so timing precision is maintained.
  28            ---------------------------------------------------------------------------
  29            */
  30          static void delay_half_period(void)
  31          {
  32   1          uint8_t i = 18;  /* Calibrated for 5 µs at 11.0592 MHz */
  33   1      
  34   1          /* Each iteration: 2 cycles (DJNZ) + 1 cycle (NOP) = 3 cycles */
  35   1          while (i--) {
  36   2              _nop_();
  37   2          }
  38   1      }
  39          
  40          void output_to_shift_registers(void)
  41          {
  42   1          uint16_t state_copy;
  43   1          signed char bit_pos;  /* Signed to allow decrement below zero */
  44   1          uint8_t saved_ea;
  45   1          uint8_t bit_value;
  46   1      
  47   1          /* === Begin Critical Section === */
  48   1          /* Save and disable interrupts for atomic, timing-consistent output */
  49   1          saved_ea = EA;
  50   1          EA = 0;
  51   1      
  52   1          /* Make local copy of bus state (guarantees consistency during output) */
  53   1          state_copy = current_bus_state & BUS_STATE_MASK;
  54   1      
