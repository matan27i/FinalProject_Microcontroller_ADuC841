  57   1          delay_half_period();  /* Allow pin to settle and outputs to stabilize */
  58   1      
  59   1          /* Step 2: Shift out 15 bits, MSB-first (bit 14 down to bit 0) */
  60   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
  61   1          {
  62   2              /* Extract current bit value
  63   2                 Note: Explicit extraction to uint8_t for clarity and to avoid
  64   2                 any potential issues with implicit type conversions */
  65   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
  66   2      
  67   2              /* Set DATA_PIN (SER input) to current bit value */
  68   2              DATA_PIN = bit_value;
  69   2      
  70   2              /* Data Setup Time: Ensure data is stable before clock rising edge
  71   2                 74HC595 requires minimum 25 ns setup time @ 5V
  72   2                 We provide 2 NOPs = 2 * 90.422 ns = 180.8 ns
  73   2                 This is 7.2× the minimum requirement, ensuring robust operation */
  74   2              _nop_();
  75   2              _nop_();
  76   2      
  77   2              /* Clock Rising Edge: Shift data into register on SRCLK rising edge
  78   2                 The 74HC595 samples DATA_PIN on the rising edge of CLK_PIN */
  79   2              CLK_PIN = 1;
