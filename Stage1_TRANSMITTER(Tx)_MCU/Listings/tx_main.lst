  64          /* Init_Timer2 — Configure Timer 2 for shift-register clock generation.
  65           * [M2] Reload value 0xFF84 gives 124 counts = ~11.2 us at 11.0592 MHz.
  66           * [N1] EA is NOT set here; GlobalINT() handles it after all inits.
  67           * Timer is NOT started here; individual output routines start it. */
  68          void Init_Timer2(void)
  69          {
  70   1          T2CON  = 0x00;
  71   1          RCAP2H = T2_RELOAD_H;
  72   1          RCAP2L = T2_RELOAD_L;
  73   1          ET2    = 1;     /* Enable Timer 2 interrupt */
  74   1          TR2    = 0;     /* Stopped until needed     */
  75   1      }
  76          
  77          /* [C1] BaudRate_Init — Timer 1 Mode 2 (8-bit autoreload) for 9600 baud.
  78           * At fCORE = 11.0592 MHz, SMOD = 0:
  79           *   Baud = fCORE / (32 * (256 - TH1)) = 11059200 / (32 * 36) = 9600
  80           *   TH1  = 256 - 36 = 220 = 0xDC
  81           *
  82           * Replaces Timer3_Init which cannot produce 9600 baud at this clock. */
  83          void BaudRate_Init(void)
  84          {
  85   1          TMOD &= 0x0F;      /* Clear Timer 1 mode bits, preserve Timer 0 */
  86   1          TMOD |= 0x20;      /* Timer 1: Mode 2 (8-bit autoreload) */
  87   1          TH1   = 0xDC;      /* Reload value for 9600 baud */
  88   1          TL1   = 0xDC;
  89   1          TR1   = 1;          /* Start Timer 1 */
  90   1      }
  91          
