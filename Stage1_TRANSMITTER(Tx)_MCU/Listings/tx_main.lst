 136          /* Timer2 ISR (vector 5) — Drives shift-register clock/latch/clear sequences.
 137           *
 138           * Mode 0 (flag_t2_mod == 0): Toggle SR_CLK twice  -> one full clock cycle
 139           *                             (shifts one bit into 74HC595).
 140           * Mode 1 (flag_t2_mod == 1): Assert SR_CLR low + SR_LATCH low, toggle CLK
 141           *                             4 times, then restore -> hardware reset.
 142           * Mode 2 (flag_t2_mod == 2): Toggle SR_LATCH twice -> one latch pulse
 143           *                             (transfers shift reg -> output reg).
 144           */
 145          void Timer2_ISR(void) interrupt 5
 146          {
 147   1          TF2 = 0;  /* Clear overflow flag (required for Timer 2) */
 148   1      
 149   1          if (flag_t2_mod == 0)
 150   1          {
 151   2              /* --- Mode 0: Clock one bit --- */
 152   2              if (counter_t2 < 2)
 153   2              {
 154   3                  SR_CLK = !SR_CLK;
 155   3                  counter_t2++;
 156   3              }
 157   2              else
 158   2              {
 159   3                  TR2    = 0;
 160   3                  SR_CLK = 0;   /* Ensure idle-low */
 161   3              }
 162   2          }
 163   1          else if (flag_t2_mod == 1)
 164   1          {
 165   2              /* --- Mode 1: Hardware clear sequence --- */
 166   2              if (counter_t2 < 4)
 167   2              {
 168   3                  SR_CLR   = 0;
 169   3                  SR_LATCH = 0;
 170   3                  SR_CLK   = !SR_CLK;
 171   3                  counter_t2++;
 172   3              }
 173   2              else
 174   2              {
 175   3                  TR2        = 0;
 176   3                  SR_CLK     = 0;   /* Force clock idle-low after clear */
 177   3                  SR_LATCH   = 1;
 178   3                  SR_CLR     = 1;
C51 COMPILER V9.60.7.0   TX_MAIN                                                           03/16/2026 15:41:44 PAGE 4   

 179   3                  flag_t2_mod = 0;
 180   3              }
 181   2          }
 182   1          else if (flag_t2_mod == 2)
 183   1          {
 184   2              /* --- Mode 2: Latch pulse --- */
 185   2              if (counter_t2 < 2)
 186   2              {
 187   3                  SR_LATCH = !SR_LATCH;
 188   3                  counter_t2++;
 189   3              }
 190   2              else
 191   2              {
 192   3                  TR2         = 0;
 193   3                  flag_t2_mod = 0;
 194   3              }
 195   2          }
 196   1      }
