  56          /* Port_Init — Set shift-register control pins to safe idle state */
  57          void Port_Init(void)
  58          {
  59   1          SR_CLK   = 0;  /* Clock idle low   */
  60   1          SR_LATCH = 1;  /* Latch idle high  */
  61   1          SR_CLR   = 1;  /* Clear deasserted */
  62   1      }
