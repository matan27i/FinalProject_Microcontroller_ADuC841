  93          void UART_Init(void)
  94          {
  95   1          SM0 = 0;  /* Mode 1: 8-bit UART      */
  96   1          SM1 = 1;  /* Variable baud rate      */
  97   1          REN = 1;  /* Enable receiver         */
  98   1          RI  = 0;  /* Clear receive flag      */
  99   1          TI  = 0;  /* Clear transmit flag     */
 100   1          ES  = 1;  /* Enable serial interrupt */
 101   1      }
