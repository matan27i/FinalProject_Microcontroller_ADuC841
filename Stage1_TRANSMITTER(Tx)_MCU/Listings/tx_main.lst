 122   2              next_head = (rx_head + 1) % RX_BUF_SIZE;
 123   2              if (next_head != rx_tail)
 124   2              {
 125   3                  rx_buf[rx_head] = SBUF;
 126   3                  rx_head = next_head;
 127   3              }
