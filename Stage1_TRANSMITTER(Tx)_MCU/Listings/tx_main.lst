 198          /* =========================================================================
 199           * SHIFT-REGISTER OUTPUT DRIVER
 200           * =========================================================================
 201           * Serialises the full 25-bit word (10 ECC + 15 data, MSB-first) into
 202           * daisy-chained 74HC595 shift registers, then pulses the latch.
 203           *
 204           * Uses Timer 2 ISR for clock generation (non-blocking per bit, but the
 205           * function blocks until all bits are shifted out).
 206           *
 207           * [N3] Uses T2_RELOAD_H/L constants instead of hardcoded values.
 208           * ========================================================================= */
 209          void output_to_shift_registers(void)
 210          {
 211   1          uint16_t state_copy;
 212   1          uint16_t ecc_copy;
 213   1          signed char bit_pos;
 214   1          uint8_t bit_value;
 215   1      
 216   1          /* Snapshot both registers for consistency during output */
 217   1          state_copy = current_bus_state & BUS_STATE_MASK;
 218   1          ecc_copy   = pesec_redundancy_reg & PESEC_RED_MASK;
 219   1      
 220   1          /* --- Phase 1: Shift out 10 ECC redundancy bits (MSB-first) --- */
 221   1          for (bit_pos = 9; bit_pos >= 0; bit_pos--)
 222   1          {
 223   2              bit_value = (uint8_t)((ecc_copy >> bit_pos) & 0x0001);
 224   2              SR_DATA   = bit_value;
 225   2      
 226   2              counter_t2 = 0;
 227   2              TH2 = T2_RELOAD_H;
 228   2              TL2 = T2_RELOAD_L;
 229   2              TR2 = 1;
 230   2              while (TR2 == 1);   /* Wait for one clock cycle */
 231   2          }
 232   1      
 233   1          /* --- Phase 2: Shift out 15 data bits (MSB-first) --- */
 234   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
 235   1          {
 236   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
 237   2              SR_DATA   = bit_value;
 238   2      
 239   2              counter_t2 = 0;
 240   2              TH2 = T2_RELOAD_H;
C51 COMPILER V9.60.7.0   TX_MAIN                                                           03/16/2026 15:41:44 PAGE 5   

 241   2              TL2 = T2_RELOAD_L;
 242   2              TR2 = 1;
 243   2              while (TR2 == 1);   /* Wait for one clock cycle */
 244   2          }
 245   1      
 246   1          /* --- Phase 3: Latch pulse (transfer shift reg -> output reg) --- */
 247   1          flag_t2_mod = 2;
 248   1          counter_t2  = 0;
 249   1          TH2 = T2_RELOAD_H;
 250   1          TL2 = T2_RELOAD_L;
 251   1          TR2 = 1;
 252   1          while (TR2 == 1);   /* Wait for latch pulse to complete */
 253   1      }
 254          
 255          /* =========================================================================
 256           * MAIN ENTRY POINT
 257           * ========================================================================= */
 258          void main(void)
 259          {
 260   1          /* [C1] Set core clock to full crystal speed.
 261   1           * PLLCON default = 0x53 -> CD=3 -> fCORE = 11.0592/8 = 1.38 MHz.
 262   1           * We need CD=0 -> fCORE = 11.0592 MHz for correct Timer 2 timing.
 263   1           * On ADuC841, core_clk = crystal_freq / 2^CD (datasheet p. 49). */
 264   1          PLLCON = (PLLCON & 0xF8);  /* CD = 0: fCORE = 11.0592 MHz */
 265   1      
 266   1          /* [M1] Initialise all peripherals BEFORE enabling interrupts.
 267   1           * This prevents ISR entry with unconfigured peripheral registers. */
 268   1          Port_Init();
 269   1          BaudRate_Init();
 270   1          UART_Init();
 271   1          Init_Timer2();
 272   1      
 273   1          /* ECC Initialisation (Group 3) */
 274   1          Init_PESEC_Matrices(pesec_config, 2);
 275   1      
 276   1          /* [M1] Enable interrupts LAST, after all peripherals are ready */
 277   1          GlobalINT();
 278   1      
 279   1          /* --- Event Loop --- */
 280   1          while (1)
 281   1          {
 282   2              /* [M4] Drain UART ring buffer one byte at a time */
 283   2              if (rx_tail != rx_head)
 284   2              {
 285   3                  uint8_t rx_byte = rx_buf[rx_tail];
 286   3                  rx_tail = (rx_tail + 1) % RX_BUF_SIZE;
 287   3                  tx_handler(rx_byte);
 288   3              }
 289   2      
 290   2              /* Handle batch terminator */
 291   2              if (buffer_flag)
 292   2              {
 293   3                  ES = 0;             /* Enter critical section  */
 294   3                  buffer_flag  = 0;
 295   3                  buffer_count = 0;
 296   3                  ES = 1;             /* Exit critical section   */
 297   3              }
 298   2          }
 299   1      }


