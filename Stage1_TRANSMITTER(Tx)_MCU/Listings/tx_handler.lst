   1          /* File: tx_handler.c
   2            UART Character Handler for H1-Type Stateful Bus Encoder
   3            Target: ADuC841 (8052 single-cycle core) 
   4            
   5            INPUT FORMAT:
   6            The host (external Python script) sends arbitrary 8-bit characters (ASCII).
   7            Each character is split into TWO 4-bit nibbles:
   8              - HIGH nibble: bits 7..4 of the character
   9              - LOW nibble:  bits 3..0 of the character
  10           
  11            TRANSMISSION ORDER: HIGH nibble first, then LOW nibble.
  12            Each nibble is processed as an independent S_new (4-bit syndrome).
  13           
  14            TERMINATOR HANDLING:
  15            '\r' (0x0D) and '\n' (0x0A) are treated as batch terminators.
  16            They set buffer_flag for compatibility with the original codebase.
  17            They do NOT generate nibble transmissions.
  18           */
  19          
  20          #include <aduc841.h>
  21          #include "header.h"
  22          
  23          /* 
  24            tx_handler
  25            Processes a single character received from UART.
  26           
  27            For printable/data characters:
  28            1. Extract high nibble: (rx_char >> 4) & 0x0F
  29            2. Extract low nibble:  rx_char & 0x0F
  30            3. Process high nibble first via process_nibble()
  31            4. Process low nibble second via process_nibble()
  32           
  33            For terminators ('\r', '\n'):
  34            - Set buffer_flag = 1 (for legacy batch processing compatibility)
  35            - Do NOT process as nibbles
  36           
  37            The process_nibble() function handles the full encode cycle:
  38            S_old computation, S_target = S_new ^ S_old, minimal-w search,
  39            differential update, and shift register output.
  40          
  41           */
  42          void tx_handler(uint8_t rx_char)
  43          {
  44   1          uint8_t high_nibble;
  45   1          uint8_t low_nibble;
  46   1          
  47   1          /* --- Check for line terminators (batch boundary markers) --- */
  48   1          if (rx_char == '\r' || rx_char == '\n')
  49   1          {
  50   2              /* Set flag for main loop (preserved for compatibility) */
  51   2              buffer_flag = 1;
  52   2              return;
  53   2          }
  54   1          
