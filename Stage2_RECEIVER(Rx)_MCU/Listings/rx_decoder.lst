  46          /* ---------------------------------------------------------------------------
  47             rx_compute_syndrome
  48             ---------------------------------------------------------------------------
  49             Computes S = H * bus_state^T on-the-fly using bitwise XOR.
  50          
  51             Algorithm:
  52               Iterate over bit positions j = 0 .. (HAMMING_N - 1).
  53               For each bit j that is set in bus_state, XOR the syndrome
  54               accumulator with the column index (j + 1).
C51 COMPILER V9.60.7.0   RX_DECODER                                                        03/16/2026 15:50:26 PAGE 2   

  55          
  56             Equivalence to matrix multiplication:
  57               The H1-type matrix stores the value (j+1) in column (j+1).
  58               By linearity of XOR over GF(2):
  59                   H * bus_state^T  =  XOR{ (j+1) : bit j set }
  60             ---------------------------------------------------------------------------
  61          */
  62          uint8_t rx_compute_syndrome(uint16_t bus_state)
  63          {
  64   1          uint8_t  syndrome = 0;
  65   1          uint8_t  col_idx;
  66   1          uint16_t temp;
  67   1      
  68   1          temp = bus_state & BUS_STATE_MASK;
  69   1      
  70   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  71   1          {
  72   2              if (temp & 0x0001u)
  73   2              {
  74   3                  syndrome ^= col_idx;
  75   3              }
  76   2              temp >>= 1;
  77   2          }
  78   1      
  79   1          return (syndrome & 0x0Fu);
  80   1      }
  81          
  82          
  83          /* ---------------------------------------------------------------------------
  84             rx_process_bus_state
  85             ---------------------------------------------------------------------------
  86             Nibble-reassembly FSM.  See rx_decoder.h for the full state description.
  87             ---------------------------------------------------------------------------
  88          */
  89          void rx_process_bus_state(uint16_t bus_state)
  90          {
  91   1          uint8_t data_nibble;
  92   1          uint8_t complete_byte;
  93   1      
  94   1          /* Extract the 4-bit data nibble encoded in this bus state. */
  95   1          data_nibble = rx_compute_syndrome(bus_state);
  96   1      
  97   1          switch (rx_current_state)
  98   1          {
  99   2              case RX_STATE_WAIT_HIGH:
 100   2                  /*
 101   2                     First nibble of a new byte pair.
 102   2                     Store as the high nibble (bits [7:4]) and wait for the
 103   2                     low nibble in the next bus state.
 104   2                  */
 105   2                  rx_stored_high_nibble = data_nibble & 0x0Fu;
 106   2                  rx_current_state      = RX_STATE_WAIT_LOW;
 107   2                  break;
 108   2      
 109   2              case RX_STATE_WAIT_LOW:
 110   2                  /*
 111   2                     Second nibble of the pair.
 112   2                     Combine with the stored high nibble to form a full byte.
 113   2      
 114   2                     Byte layout:
 115   2                       bits [7:4]  =  rx_stored_high_nibble  (arrived first)
 116   2                       bits [3:0]  =  data_nibble             (arrives now)
C51 COMPILER V9.60.7.0   RX_DECODER                                                        03/16/2026 15:50:26 PAGE 3   

 117   2      
 118   2                     Example:
 119   2                       high = 0x4, low = 0x1  ->  byte = 0x41 = 'A'
 120   2                  */
 121   2                  complete_byte = (uint8_t)((rx_stored_high_nibble << 4)
 122   2                                   | (data_nibble & 0x0Fu));
 123   2      
 124   2                  rx_send_uart_byte(complete_byte);
 125   2      
 126   2                  rx_bytes_decoded++;
 127   2                  rx_byte_ready         = 1;
 128   2                  rx_current_state      = RX_STATE_WAIT_HIGH;
 129   2                  rx_stored_high_nibble = 0;
 130   2                  break;
 131   2      
 132   2              default:
 133   2                  /* Should never reach here; reset to a safe, known state. */
 134   2                  rx_reset_state_machine();
 135   2                  break;
 136   2          }
 137   1      }
