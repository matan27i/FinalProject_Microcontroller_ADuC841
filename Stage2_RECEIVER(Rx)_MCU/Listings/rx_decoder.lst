  30          /* Current position in the nibble-reassembly FSM. */
  31          rx_state_t xdata rx_current_state    = RX_STATE_WAIT_HIGH;
  32          
  33          /* High nibble stored between the WAIT_HIGH and WAIT_LOW calls. */
  34          uint8_t    xdata rx_stored_high_nibble = 0;
  35          
