 152          /* ---------------------------------------------------------------------------
 153             rx_is_bus_reset
 154             ---------------------------------------------------------------------------
 155             Detects the TX hard-reset condition (all 25 bits zero).
 156          
 157             The TX '=' command clears both current_bus_state and pesec_redundancy_reg
 158             to zero, then hardware-clears the shift registers.  This produces an
 159             all-zero 25-bit word on the physical bus.
 160          
 161             Detection: both data and redundancy must be exactly zero.
 162          
 163             NOTE: At system startup the bus is also zero.  The main loop uses
 164             additional context (e.g., whether any states have been processed) to
 165             distinguish cold-start from mid-session reset if needed.  This
 166             function is a pure predicate; it does not perform any state changes.
 167             ---------------------------------------------------------------------------
 168          */
 169          uint8_t rx_is_bus_reset(uint16_t data_bits, uint16_t red_bits)
 170          {
 171   1          if ((data_bits == 0) && (red_bits == 0))
 172   1          {
 173   2              return 1;
 174   2          }
 175   1          return 0;
 176   1      }


