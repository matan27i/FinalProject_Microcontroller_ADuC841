 205          /* =========================================================================
 206             PESEC ERROR CORRECTION
 207             =========================================================================
 208          
 209             MATHEMATICAL BACKGROUND
 210             ~~~~~~~~~~~~~~~~~~~~~~~
 211             The PESEC codeword is the concatenation [data(15) | redundancy(10)].
 212             The parity-check matrix H_pesec = [A | D] has the property that for
 213             any valid codeword C:
 214          
 215                 H_pesec * C^T  =  A * data^T  XOR  D * redundancy^T  =  0
 216          
 217             When the received word has a single-bit error at position k, the
 218             syndrome becomes:
 219          
 220                 S  =  column_k  (the k-th column of [A | D])
 221          
 222             Because every column of [A | D] is a unique non-zero value in the
 223             5-bit syndrome space (by construction of the H1-type sub-blocks),
 224             S uniquely identifies the error position:
 225          
 226               - If S matches A[i] (i < 15): the error is in data bit i.
 227               - If S matches D[j] (j < 10): the error is in redundancy bit j.
 228          
 229             For multi-bit errors, S will (in general) not match any single column,
 230             and the function returns PESEC_UNCORRECTABLE.
 231          
 232             CORRECTION PROCEDURE
 233             ~~~~~~~~~~~~~~~~~~~~
 234             1. Compute S = get_data_syndrome(data) XOR get_red_syndrome(red).
 235             2. If S == 0: return PESEC_NO_ERROR.
 236             3. Search A[0..14] for a match: if found at index i, flip data bit i.
 237             4. Search D[0..9] for a match: if found at index j, flip red bit j.
 238             5. No match: return PESEC_UNCORRECTABLE.
 239             ========================================================================= */
 240          uint8_t rx_pesec_correct(uint16_t *data_bits, uint16_t *red_bits)
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/16/2026 15:50:26 PAGE 5   

 241          {
 242   1          uint8_t syndrome;
 243   1          uint8_t i;
 244   1          uint8_t search_limit;
 245   1      
 246   1          /* Step 1: Compute full PESEC syndrome. */
 247   1          syndrome = get_data_syndrome(*data_bits) ^ get_red_syndrome(*red_bits);
 248   1      
 249   1          /* Step 2: Zero syndrome means valid codeword, no error. */
 250   1          if (syndrome == 0)
 251   1          {
 252   2              return PESEC_NO_ERROR;
 253   2          }
 254   1      
 255   1          /* Step 3: Search data-bit columns (Matrix A).
 256   1             Only check the first HAMMING_N columns because the bus state has
 257   1             exactly 15 physical data bits.  Columns beyond index 14 correspond
 258   1             to virtual bit positions that cannot be in error. */
 259   1          search_limit = pesec_num_a_cols;
 260   1          if (search_limit > HAMMING_N)
 261   1          {
 262   2              search_limit = HAMMING_N;
 263   2          }
 264   1      
 265   1          for (i = 0; i < search_limit; i++)
 266   1          {
 267   2              if (PESEC_MAT_A[i] == syndrome)
 268   2              {
 269   3                  /* Error is in data bit i.  Flip it. */
 270   3                  *data_bits ^= ((uint16_t)1u << i);
 271   3                  *data_bits &= BUS_STATE_MASK;
 272   3                  rx_pesec_corrections++;
 273   3                  return PESEC_CORRECTED_DATA;
 274   3              }
 275   2          }
 276   1      
 277   1          /* Step 4: Search redundancy-bit columns (Matrix D). */
 278   1          for (i = 0; i < pesec_num_d_cols; i++)
 279   1          {
 280   2              if (PESEC_MAT_D[i] == syndrome)
 281   2              {
 282   3                  /* Error is in redundancy bit i.  Flip it. */
 283   3                  *red_bits ^= ((uint16_t)1u << i);
 284   3                  *red_bits &= PESEC_RED_MASK;
 285   3                  rx_pesec_corrections++;
 286   3                  return PESEC_CORRECTED_RED;
 287   3              }
 288   2          }
 289   1      
 290   1          /* Step 5: Syndrome is non-zero but matches no single column.
 291   1             This indicates a multi-bit error that cannot be corrected. */
 292   1          rx_errors_detected++;
 293   1          return PESEC_UNCORRECTABLE;
 294   1      }
