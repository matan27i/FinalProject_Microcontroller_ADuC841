  55          /* =========================================================================
  56             PESEC MATRIX INITIALISATION
  57             =========================================================================
  58             This function is a direct port of the TX encoder's Init_PESEC_Matrices().
  59             It must be called with the SAME block-size configuration so that the
  60             receiver's matrices match the transmitter's exactly.
  61          
  62             For config {m1=3, m2=2} the construction proceeds as follows:
  63          
  64             Block 0 (m=3, total_m starts at 0):
  65               Columns: i << 0 for i = 1..7  ->  D = {1, 2, 3, 4, 5, 6, 7}
  66               chunk_mask = ((1<<3)-1) << 0 = 0x07
  67               bit_offset = 0, col_offset = 0
  68               total_m advances to 3
  69          
  70             Block 1 (m=2, total_m = 3):
  71               Columns: i << 3 for i = 1..3  ->  D += {8, 16, 24}
  72               chunk_mask = ((1<<2)-1) << 3 = 0x18
  73               bit_offset = 3, col_offset = 7
  74               total_m advances to 5
  75          
  76             max_syndrome = 2^5 - 1 = 31
  77          
  78             Matrix A = {val in 1..31 : val NOT in D}
  79                      = {9,10,11,12,13,14,15, 17,18,19,20,21,22,23, 25,26,27,28,29,30,31}
  80                      = 21 columns
  81          
  82             Only A[0]..A[14] correspond to physical data bits 0..14.
  83             A[15]..A[20] map to virtual positions that are always zero in the
  84             15-bit bus state, so they never contribute to the syndrome and never
  85             need correction.
  86             ========================================================================= */
  87          void rx_init_pesec_matrices(uint8_t *m_sizes, uint8_t num_blocks)
  88          {
  89   1          uint8_t i, b, val;
  90   1          uint8_t is_in_d;
  91   1          uint8_t total_m = 0;
  92   1          uint8_t current_col_offset = 0;
  93   1          uint8_t max_syndrome;
  94   1      
  95   1          pesec_num_blocks = num_blocks;
  96   1          pesec_num_d_cols = 0;
  97   1          pesec_num_a_cols = 0;
  98   1      
  99   1          /* --- Build Matrix D and pre-calculate block solver metadata --- */
 100   1          for (b = 0; b < num_blocks; b++)
 101   1          {
 102   2              pesec_bit_offsets[b] = total_m;
 103   2              pesec_col_offsets[b] = current_col_offset;
 104   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
 105   2      
 106   2              /* Each block contributes columns 1..(2^m - 1) shifted by total_m.
 107   2                 These are the syndrome-space values for the redundancy bits
 108   2                 belonging to this block. */
 109   2              for (i = 1; i < (1 << m_sizes[b]); i++)
 110   2              {
 111   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
 112   3              }
 113   2      
 114   2              total_m += m_sizes[b];
 115   2              current_col_offset += ((1 << m_sizes[b]) - 1);
 116   2          }
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/16/2026 15:50:26 PAGE 3   

 117   1      
 118   1          max_syndrome = (1 << total_m) - 1;
 119   1      
 120   1          /* --- Build Matrix A: syndrome-space values NOT present in D ---
 121   1             These become the columns for the data bits.  The first HAMMING_N
 122   1             columns map to physical bus bits 0..14. */
 123   1          for (val = 1; val <= max_syndrome; val++)
 124   1          {
 125   2              is_in_d = 0;
 126   2      
 127   2              for (i = 0; i < pesec_num_d_cols; i++)
 128   2              {
 129   3                  if (PESEC_MAT_D[i] == val)
 130   3                  {
 131   4                      is_in_d = 1;
 132   4                      break;
 133   4                  }
 134   3              }
 135   2      
 136   2              if (is_in_d == 0)
 137   2              {
 138   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 139   3              }
 140   2          }
 141   1      }
