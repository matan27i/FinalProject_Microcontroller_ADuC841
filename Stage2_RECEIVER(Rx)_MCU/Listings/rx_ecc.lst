 144          /* =========================================================================
 145             PESEC SYNDROME COMPUTATION (INTERNAL HELPERS)
 146             =========================================================================
 147             These are static helpers that compute partial syndromes by XOR-ing
 148             together the matrix columns selected by set bits in a register value.
 149          
 150             Identical in structure to the TX encoder's syndrome helpers, ensuring
 151             mathematical equivalence.
 152             ========================================================================= */
 153          
 154          /* ---------------------------------------------------------------------------
 155             calc_pesec_syndrome_generic
 156             ---------------------------------------------------------------------------
 157             Generic helper: for each set bit in reg_val, XOR the corresponding
 158             column from mat_ptr into the accumulator.
 159          
 160             Parameters:
 161               reg_val    Bit vector selecting columns (bit i selects mat_ptr[i]).
 162               mat_ptr    Pointer to the column array (either A or D).
 163               num_cols   Number of columns in the array.
 164             Returns:
 165               XOR accumulation of selected columns (the partial syndrome).
 166             ---------------------------------------------------------------------------
 167          */
 168          static uint8_t calc_pesec_syndrome_generic(uint16_t reg_val,
 169                                                     uint8_t *mat_ptr,
 170                                                     uint8_t  num_cols)
 171          {
 172   1          uint8_t syndrome = 0;
 173   1          uint8_t idx;
 174   1      
 175   1          for (idx = 0; idx < num_cols; idx++)
 176   1          {
 177   2              if ((reg_val >> idx) & 1u)
 178   2              {
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/16/2026 15:50:26 PAGE 4   

 179   3                  syndrome ^= mat_ptr[idx];
 180   3              }
 181   2          }
 182   1      
 183   1          return syndrome;
 184   1      }
 185          
 186          
 187          /* Syndrome contribution from the 15-bit data vector via Matrix A.
 188             Only the first min(HAMMING_N, pesec_num_a_cols) bits matter because
 189             the bus state has at most 15 physical bits. */
 190          static uint8_t get_data_syndrome(uint16_t data_val)
 191          {
 192   1          return calc_pesec_syndrome_generic(data_val, PESEC_MAT_A,
 193   1                                             pesec_num_a_cols);
 194   1      }
 195          
 196          
 197          /* Syndrome contribution from the 10-bit redundancy vector via Matrix D. */
 198          static uint8_t get_red_syndrome(uint16_t red_val)
 199          {
 200   1          return calc_pesec_syndrome_generic(red_val, PESEC_MAT_D,
 201   1                                             pesec_num_d_cols);
 202   1      }
