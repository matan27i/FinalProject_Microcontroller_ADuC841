 296          
 297          /* =========================================================================
 298             H1 DIFFERENTIAL ERROR CORRECTION
 299             =========================================================================
 300             This layer operates on the 15-bit data AFTER PESEC correction.
 301             It exploits the TX encoder's invariant that consecutive bus states
 302             differ by at most one bit (weight-0 or weight-1 transition).
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/16/2026 15:50:26 PAGE 6   

 303          
 304             After PESEC has corrected any channel errors in the 25-bit word,
 305             the data bits should be clean.  This layer serves as:
 306               (a) a secondary validation check,
 307               (b) the differential baseline tracker for the decode pipeline.
 308          
 309             If PESEC correction was successful, this function will almost always
 310             pass the data through unchanged.  It only applies a correction if
 311             the transition somehow has weight > 1 (e.g., PESEC missed a multi-bit
 312             error, or a synchronisation glitch occurred).
 313             ========================================================================= */
 314          
 315          /* ---------------------------------------------------------------------------
 316             find_minimal_w
 317             ---------------------------------------------------------------------------
 318             H1-type minimum-weight vector for a given syndrome target.
 319             Identical to the TX encoder's implementation.
 320          
 321             s_target = 0  ->  return 0          (no transition)
 322             s_target != 0 ->  return 1 << (s-1) (single bit at position s-1)
 323             ---------------------------------------------------------------------------
 324          */
 325          uint16_t find_minimal_w(uint8_t s_target)
 326          {
 327   1          s_target &= 0x0F;
 328   1      
 329   1          if (s_target == 0)
 330   1          {
 331   2              return 0;
 332   2          }
 333   1      
 334   1          return ((uint16_t)1u << (s_target - 1));
 335   1      }
 336          
 337          
 338          /* ---------------------------------------------------------------------------
 339             rx_correct_bus_state
 340             ---------------------------------------------------------------------------
 341             Full explanation in rx_ecc.h.  Summary:
 342          
 343             1. delta = corrected_data XOR rx_previous_bus_state
 344             2. syndrome_delta = H1 * delta^T
 345             3. expected_delta = find_minimal_w(syndrome_delta)
 346             4. If delta == expected_delta: accept as-is.
 347                Else: reconstruct from previous + expected_delta.
 348             5. Update rx_previous_bus_state.
 349             ---------------------------------------------------------------------------
 350          */
 351          uint16_t rx_correct_bus_state(uint16_t corrected_data)
 352          {
 353   1          uint16_t delta;
 354   1          uint8_t  syndrome_delta;
 355   1          uint16_t expected_delta;
 356   1          uint16_t result;
 357   1      
 358   1          corrected_data &= BUS_STATE_MASK;
 359   1      
 360   1          /* Step 1: Observed transition from previous known-good state. */
 361   1          delta = corrected_data ^ rx_previous_bus_state;
 362   1      
 363   1          /* Step 2: H1 syndrome of the transition.
 364   1             rx_compute_syndrome() is defined in rx_decoder.c and performs
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/16/2026 15:50:26 PAGE 7   

 365   1             the on-the-fly H * delta^T computation. */
 366   1          syndrome_delta = rx_compute_syndrome(delta);
 367   1      
 368   1          /* Step 3: Reconstruct the canonical transition the TX would send. */
 369   1          expected_delta = find_minimal_w(syndrome_delta);
 370   1      
 371   1          /* Step 4: Accept or correct. */
 372   1          if (delta == expected_delta)
 373   1          {
 374   2              result = corrected_data;
 375   2          }
 376   1          else
 377   1          {
 378   2              /* The transition weight was not 0 or 1.  This should be rare
 379   2                 after PESEC correction.  Reconstruct the intended state. */
 380   2              result = (rx_previous_bus_state ^ expected_delta) & BUS_STATE_MASK;
 381   2              rx_errors_corrected++;
 382   2          }
 383   1      
 384   1          /* Step 5: Advance the differential baseline. */
 385   1          rx_previous_bus_state = result;
 386   1      
 387   1          return result;
 388   1      }


