   1          /* =============================================================================
   2             File: rx_main.c
   3             Module: Group 1 -- Main entry point and pipeline loop (SPI Slave version)
   4          
   5             MODIFICATION SUMMARY:
   6               The original design polled a DATA_READY GPIO (P3.2) for rising edges
   7               and called rx_read_full_bus() to capture 25 parallel bits.  This
   8               version replaces that input mechanism with SPI slave reception:
   9          
  10                 Old path:  DATA_READY edge -> rx_read_full_bus() -> pipeline
  11                 New path:  SPI ISR fills rx_spi_data/rx_spi_red -> pipeline
  12          
  13               The five-stage decode pipeline (A through E) is preserved exactly.
  14               Stages B-E are completely unchanged.  Stage A is replaced by the
  15               SPI ISR in rx_hw.c; the main loop simply checks rx_spi_frame_ready.
  16          
  17             Responsibilities:
  18               - Hardware startup sequence (clock, XRAM, UART, SPI slave).
  19               - PESEC matrix initialisation (must match TX config).
  20               - Checking the SPI frame-ready flag each iteration.
  21               - Sequencing the full decode pipeline per received frame:
  22                   (Stage A: handled by SPI ISR -- see rx_hw.c)
  23                   Stage B: rx_is_bus_reset()        (decoder -- reset detect)
  24                   Stage C: rx_pesec_correct()       (ecc -- 25-bit PESEC)
  25                   Stage D: rx_correct_bus_state()   (ecc -- H1 differential)
  26                   Stage E: rx_process_bus_state()   (decoder -- nibble FSM)
  27          
  28             This file owns no domain logic.  It is intentionally thin so that
  29             the three functional modules can be tested independently.
  30             =============================================================================
  31          */
  32          
  33          #include "rx_system.h"
  34          
  35          /* ---------------------------------------------------------------------------
  36             PESEC block configuration -- MUST MATCH THE TX ENCODER.
  37          
  38             The TX uses:  static uint8_t pesec_config[] = {3, 2};
  39             This produces:
  40               Block 0 (m=3): 7 redundancy columns, syndrome bits [2:0]
  41               Block 1 (m=2): 3 redundancy columns, syndrome bits [4:3]
  42               Total: 10 redundancy bits, 5-bit syndrome
  43             ---------------------------------------------------------------------------
  44          */
  45          static uint8_t pesec_config[] = {3, 2};
  46          
  47          
  48          /* ---------------------------------------------------------------------------
  49             rx_perform_full_reset
  50             ---------------------------------------------------------------------------
  51             Resets all receiver state to match the TX post-reset condition.
  52             Called when an all-zero 25-bit word is detected, indicating the TX
  53             has executed its '=' reset command.
  54          
C51 COMPILER V9.60.7.0   RX_MAIN                                                           03/16/2026 15:50:26 PAGE 2   

  55             After TX reset:
  56               current_bus_state    = 0
  57               pesec_redundancy_reg = 0
  58             ---------------------------------------------------------------------------
  59          */
  60          static void rx_perform_full_reset(void)
  61          {
  62   1          rx_previous_bus_state = 0;
  63   1      
  64   1          rx_errors_corrected  = 0;
  65   1          rx_errors_detected   = 0;
  66   1          rx_pesec_corrections = 0;
  67   1      
  68   1          rx_reset_state_machine();
  69   1      }
  70          
