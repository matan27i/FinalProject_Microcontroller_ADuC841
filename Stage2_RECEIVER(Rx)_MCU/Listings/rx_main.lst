 130   1          /* ------------------------------------------------------------------
 131   1             Main pipeline loop
 132   1             ------------------------------------------------------------------
 133   1             The loop structure is deliberately simple:
 134   1               1. Pump the UART TX buffer (non-blocking).
 135   1               2. Check if the SPI ISR has delivered a new 25-bit frame.
 136   1               3. If yes, run the decode pipeline (stages B through E).
 137   1      
 138   1             The SPI ISR handles all timing-critical reception.  The main loop
 139   1             only needs to process frames faster than they arrive, which is
 140   1             easily satisfied: the TX produces one frame every ~280 us, and
 141   1             the decode pipeline (syndrome + delta solve + nibble FSM) takes
 142   1             well under 100 us on the 8051 at 11 MHz.
 143   1             ------------------------------------------------------------------
 144   1          */
 145   1          while (1)
 146   1          {
 147   2              /* Pump the non-blocking UART TX buffer each iteration. */
 148   2              rx_uart_pump();
 149   2      
 150   2              /* Check for a new SPI frame. */
 151   2              if (rx_spi_frame_ready)
 152   2              {
 153   3                  /* --- Consume the SPI frame --- */
 154   3                  /* Disable interrupts briefly to take an atomic snapshot
 155   3                     of the two 16-bit staging registers, then clear the flag.
 156   3                     This prevents a new ISR write from corrupting the read. */
 157   3                  EA = 0;
 158   3                  raw_data = rx_spi_data;
 159   3                  raw_red  = rx_spi_red;
 160   3                  rx_spi_frame_ready = 0;
 161   3                  EA = 1;
 162   3      
 163   3                  /* Stage B: TX reset detection.
 164   3                     All-zero 25-bit word means the TX executed '='. */
 165   3                  if (rx_is_bus_reset(raw_data, raw_red))
 166   3                  {
 167   4                      rx_perform_full_reset();
 168   4                      continue;
 169   4                  }
 170   3      
 171   3                  /* Stage C: PESEC error correction (25-bit codeword).
 172   3                     raw_data and raw_red are corrected IN PLACE. */
 173   3                  rx_pesec_correct(&raw_data, &raw_red);
 174   3      
 175   3                  /* Stage D: H1 differential validation (15-bit data). */
 176   3                  corrected_data = rx_correct_bus_state(raw_data);
 177   3      
 178   3                  /* Stage E: Nibble extraction and byte reassembly. */
C51 COMPILER V9.60.7.0   RX_MAIN                                                           03/16/2026 15:50:26 PAGE 4   

