 289          
 290          /* =========================================================================
 291             NON-BLOCKING UART TX BUFFER  (unchanged from original)
 292             =========================================================================
 293             Bytes are enqueued by rx_send_uart_byte() and drained by rx_uart_pump()
 294             which the main loop calls on every iteration.
 295             ========================================================================= */
 296          
 297          /* TX buffer in XRAM (2 KB internal, accessed via MOVX).
 298             CFG841.XRAMEN must be set in main() before first access. */
 299          #define TX_BUF_SIZE 16
 300          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 301          static uint8_t tx_head = 0;
 302          static uint8_t tx_tail = 0;
C51 COMPILER V9.60.7.0   RX_HW                                                             03/16/2026 15:50:26 PAGE 6   

 303          
 304          
 305          void rx_send_uart_byte(uint8_t data_byte)
 306          {
 307   1          uint8_t next_head;
 308   1      
 309   1          next_head = (tx_head + 1) % TX_BUF_SIZE;
 310   1          if (next_head == tx_tail)
 311   1          {
 312   2              return;  /* Buffer full, drop byte. */
 313   2          }
 314   1      
 315   1          tx_buf[tx_head] = data_byte;
 316   1          tx_head = next_head;
 317   1      }
 318          
 319          
 320          void rx_uart_pump(void)
 321          {
 322   1          if (TI && (tx_tail != tx_head))
 323   1          {
 324   2              TI = 0;
 325   2              SBUF = tx_buf[tx_tail];
 326   2              tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
 327   2          }
 328   1      }


