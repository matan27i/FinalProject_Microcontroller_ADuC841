 198             ---------------------------------------------------------------------------
 199          */
 200          void RX_Timer3_Init(void)
 201          {
 202   1          T3CON = 0x86u;
 203   1          T3FD  = 0x08u;
 204   1      }
 205          
 206          
 207          /* ---------------------------------------------------------------------------
 208             RX_UART_Init  (unchanged from original)
 209             ---------------------------------------------------------------------------
 210             8-bit UART, transmit-only, 9600 baud (clocked by Timer 3).
 211             TI pre-armed so the first SBUF write does not stall.
 212             ---------------------------------------------------------------------------
 213          */
 214          void RX_UART_Init(void)
 215          {
 216   1          SM0 = 0;
 217   1          SM1 = 1;
 218   1          REN = 0;
 219   1          RI  = 0;
 220   1          TI  = 0;
 221   1          ES  = 0;
 222   1      
 223   1          TI  = 1;   /* Pre-arm for first byte. */
 224   1      }
 225          
 226          
 227          /* ---------------------------------------------------------------------------
 228             RX_SPI_Slave_Init
 229             ---------------------------------------------------------------------------
 230             Configures the ADuC841 SPI peripheral as a slave and sets up INT0
 231             for frame synchronisation.
 232          
 233             SPI CONFIGURATION (SPICON = 0xA0):
 234               Bit 7  ISPI = 1   Enable SPI interrupt.
 235               Bit 6  WCOL = 0   (read-only, cannot set)
 236               Bit 5  SPE  = 1   Enable SPI peripheral; pins become SPI function.
 237               Bit 4  SPIM = 0   Slave mode.
 238               Bit 3  CPOL = 0   Clock idle low  (SPI Mode 0, matches Mega config).
 239               Bit 2  CPHA = 0   Sample on leading (rising) edge (SPI Mode 0).
 240               Bit 1-0 SPR = 00  (Ignored in slave mode.)
C51 COMPILER V9.60.7.0   RX_HW                                                             03/16/2026 15:50:26 PAGE 5   

 241          
 242               Combined: 1_0_1_0_0_0_0_0 = 0xA0
 243          
 244             INT0 CONFIGURATION:
 245               P3.2 (INT0) is connected to the Mega's /SS output.
 246               Configured for falling-edge trigger (IT0 = 1).
 247               Enabled via EX0 = 1 in the IE register.
 248          
 249             Pre-load SPIDAT with 0x00 so the slave has a defined first
 250             response byte (the Mega ignores MISO, but this is good practice).
 251          
 252             GLOBAL INTERRUPT NOTE:
 253               This function enables the SPI and INT0 interrupt sources but does
 254               NOT set EA=1.  The caller (main) must set EA=1 after all
 255               initialisations are complete, exactly as the original design did.
 256             ---------------------------------------------------------------------------
 257          */
 258          void RX_SPI_Slave_Init(void)
 259          {
 260   1          /* Reset SPI receive state. */
 261   1          spi_byte_idx       = 0;
 262   1          rx_spi_frame_ready = 0;
 263   1          rx_spi_data        = 0;
 264   1          rx_spi_red         = 0;
 265   1      
 266   1          /* Pre-load transmit register (slave sends 0x00 -- Mega ignores it). */
 267   1          SPIDAT = 0x00u;
 268   1      
 269   1          /* Configure SPI: slave mode, Mode 0, interrupt enabled.
 270   1             ISPI=1, SPE=1, SPIM=0, CPOL=0, CPHA=0, SPR=00 => 0xA0. */
 271   1          SPICON = 0xA0u;
 272   1      
 273   1          /* Configure INT0 (P3.2) for falling-edge trigger.
 274   1             IT0 = 1: edge-triggered (not level).
 275   1             IE0 is auto-cleared by hardware on ISR entry. */
 276   1          IT0 = 1;
 277   1      
 278   1          /* Clear any pending INT0 flag from startup noise. */
 279   1          IE0 = 0;
 280   1      
 281   1          /* Enable INT0 interrupt source. */
 282   1          EX0 = 1;
 283   1      
 284   1          /* NOTE: EA (global interrupt enable) is NOT set here.
 285   1             The caller must set EA=1 after all init functions complete.
 286   1             This prevents ISR entry with partially-configured peripherals. */
 287   1      }
