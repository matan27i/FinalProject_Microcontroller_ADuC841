 141          /* 
 142             RX_SPI_Slave_Init
 143             
 144             [F2] FIX: P1.5 ANALOG-MODE BUG
 145          
 146             The ADuC841 Port 1 defaults to ANALOG INPUT mode on power-up.
 147             In analog mode, the digital input buffer is disconnected, so the
 148             pin cannot reliably read logic levels.  P1.5 is the SPI /SS pin.
 149             If SPE is enabled while P1.5 is still analog, the SPI slave
 150             peripheral cannot detect the master's slave-select assertion.
 151          
 152             FIX: Write 0 to P1.5 BEFORE enabling SPE.  On the ADuC841, writing
 153             a 0 to any Port 1 bit switches that pin from analog to digital mode.
 154             We use a bitwise AND to clear only P1.5 without disturbing other P1
 155             bits that may be intentionally left in analog mode for ADC use.
 156          
 157             After the digital-mode switch, SPI is enabled as before.
 158          
 159             [W4] rx_spi_parity is reset to 0 alongside the other staging registers.
 160          
 161             SPICON = 0xA0:
 162               ISPI=1 (SPI interrupt enable), SPE=1 (SPI enable),
 163               SPIM=0 (slave), CPOL=0, CPHA=0 (Mode 0), SPR=00 (ignored).
 164             
 165          */
 166          void RX_SPI_Slave_Init(void)
 167          {
 168   1          /* Reset SPI receive state. */
 169   1          spi_byte_idx       = 0;
 170   1          rx_spi_frame_ready = 0;
 171   1          rx_spi_data        = 0;
 172   1          rx_spi_red         = 0;
 173   1          rx_spi_parity      = 0;   /* [W4] */
 174   1      
 175   1          /* [F2] Force P1.5 (/SS) from analog mode to digital input mode.
 176   1             On ADuC841, writing 0 to a Port 1 bit activates the digital
 177   1             input buffer for that pin.  This MUST happen before SPE is set,
 178   1             otherwise the SPI slave cannot detect /SS transitions.
C51 COMPILER V9.60.7.0   RX_HW                                                             04/15/2026 20:02:42 PAGE 4   

 179   1      
 180   1             P1 &= ~0x20  clears bit 5 only.  Bits 0-4 and 6-7 are preserved
 181   1             so that any ADC channels configured on other P1 pins remain
 182   1             undisturbed.  If additional SPI pins (MOSI, MISO, SCLOCK) also
 183   1             reside on Port 1, clear those bits here too -- consult the
 184   1             datasheet for your specific package variant. */
 185   1          P1 &= ~0x20u;   /* P1.5 = 0 -> digital mode for /SS */
 186   1      
 187   1          /* Pre-load transmit register. */
 188   1          SPIDAT = 0x00u;
 189   1      
 190   1          /* Configure SPI: slave mode, Mode 0, interrupt enabled.
 191   1             ISPI=1, SPE=1, SPIM=0, CPOL=0, CPHA=0, SPR=00 => 0xA0. */
 192   1          SPICON = 0xA0u;
 193   1      
 194   1          /* Configure INT0 (P3.2) for falling-edge trigger. */
 195   1          IT0 = 1;
 196   1          IE0 = 0;
 197   1          EX0 = 1;
 198   1      
 199   1          /* EA is NOT set here; caller must set EA=1 after all inits. */
 200   1      }
