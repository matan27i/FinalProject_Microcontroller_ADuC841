   1          /* 
   2             File: rx_hw.c
   3          
   4             ADuC841 PORT 1 ANALOG-MODE ANOMALY:
   5             On the ADuC841, all Port 1 pins power up in ANALOG INPUT mode.  In
   6             this mode the digital input buffer is disabled and the pin reads as
   7             indeterminate.  Writing a 0 to a P1 bit switches that pin to DIGITAL
   8             mode.  This must be done BEFORE enabling any peripheral (like SPI)
   9             that relies on reading the pin.
  10          
  11             The SPI /SS pin is P1.5.  If SPE is set while P1.5 is still in
  12             analog mode, the SPI slave cannot detect /SS transitions and will
  13             either ignore frames entirely or sample data at random phases.
  14             
  15          */
  16          
  17          #include "rx_system.h"
  18          
  19          /* 
  20             SPI RECEIVE STATE VARIABLES
  21              */
  22          
  23          /* Staging registers: assembled 26-bit word from the last complete frame.
  24             Written atomically by the SPI ISR; read by the main loop when
  25             rx_spi_frame_ready == 1. */
  26          volatile uint16_t rx_spi_data        = 0;
  27          volatile uint16_t rx_spi_red         = 0;
  28          volatile uint8_t  rx_spi_parity      = 0;   /* [W4] Overall parity bit */
  29          volatile uint8_t  rx_spi_frame_ready = 0;
  30          
  31          /* ISR-private byte accumulation buffer and counter. */
  32          static uint8_t spi_rx_buf[4];
  33          static uint8_t spi_byte_idx = 0;
  34          
  35          
  36          /* 
  37             INTERRUPT SERVICE ROUTINES
  38              */
  39          
  40          /* 
  41             INT0 ISR (vector 0, address 0x0003) -- /SS Frame-Sync
  42             
  43             Fires on the falling edge of /SS (Mega asserts slave select).
  44             Resets the byte counter to 0 so the next SPI byte is byte 0.
  45             
  46          */
  47          void INT0_FrameSync_ISR(void) interrupt 0
  48          {
  49   1          spi_byte_idx = 0;
  50   1      }
  51          
  52          
  53          /* 
  54             SPI/I2C ISR (vector 6, address 0x0033) -- Byte Received
C51 COMPILER V9.60.7.0   RX_HW                                                             04/15/2026 20:02:42 PAGE 2   

  55             
  56             Fires after each complete 8-bit SPI transfer.
  57          
  58             FRAME PROTOCOL (4 bytes per frame):
  59               Index 0: H1 data bits  [7:0]
  60               Index 1: bit 7 = overall parity (W4)
  61                        bits [6:0] = H1 data bits [14:8]
  62               Index 2: ECC red bits  [7:0]
  63               Index 3: ECC red bits  [9:8] (bits 7-2 = 0)
  64          
  65             After storing byte 3, the ISR assembles the 15-bit data, 10-bit
  66             redundancy, and 1-bit parity, then sets rx_spi_frame_ready = 1.
  67             
  68          */
  69          sbit DEBUG_LED = P3^4;
  70          void SPI_Receive_ISR(void) interrupt 6
  71          {
  72   1          uint8_t rx_byte;
  73   1          DEBUG_LED = !DEBUG_LED;
  74   1          /* Read SPIDAT to get the received byte AND clear the interrupt flag. */
  75   1          rx_byte = SPIDAT;
  76   1      
  77   1          if (spi_byte_idx >= 4)
  78   1          {
  79   2              return;
  80   2          }
  81   1      
  82   1          spi_rx_buf[spi_byte_idx] = rx_byte;
  83   1          spi_byte_idx++;
  84   1      
  85   1          if (spi_byte_idx == 4)
  86   1          {
  87   2              /* Assemble the 15-bit data word from bytes 0 and 1.
  88   2                 Byte 0 = data[7:0].
  89   2                 Byte 1 bits [6:0] = data[14:8].
  90   2                 Byte 1 bit 7 = overall parity (extracted separately). */
  91   2              rx_spi_data = (uint16_t)spi_rx_buf[0]
  92   2                          | (((uint16_t)(spi_rx_buf[1] & 0x7Fu)) << 8);
  93   2      
  94   2              /* Assemble the 10-bit redundancy word from bytes 2 and 3. */
  95   2              rx_spi_red  = (uint16_t)spi_rx_buf[2]
  96   2                          | (((uint16_t)(spi_rx_buf[3] & 0x03u)) << 8);
  97   2      
  98   2              /* [W4] Extract the overall parity bit from byte 1, bit 7.
  99   2                 This is the TX-computed even parity of all 25 bits
 100   2                 (15 data + 10 redundancy).  It rides in the previously-
 101   2                 unused high bit of byte 1. */
 102   2              rx_spi_parity = (spi_rx_buf[1] >> 7) & 0x01u;
 103   2      
 104   2              rx_spi_frame_ready = 1;
 105   2          }
 106   1      }
