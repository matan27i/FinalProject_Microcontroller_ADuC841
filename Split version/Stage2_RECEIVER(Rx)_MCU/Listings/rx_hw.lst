 203          /* 
 204             NON-BLOCKING UART TX BUFFER  (unchanged)
 205              */
 206          
 207          #define TX_BUF_SIZE 16
 208          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 209          static uint8_t tx_head = 0;
 210          static uint8_t tx_tail = 0;
 211          
 212          
 213          void rx_send_uart_byte(uint8_t data_byte)
 214          {
 215   1          uint8_t next_head;
 216   1      
 217   1          next_head = (tx_head + 1) % TX_BUF_SIZE;
 218   1          if (next_head == tx_tail)
 219   1          {
 220   2              return;
 221   2          }
 222   1      
 223   1          tx_buf[tx_head] = data_byte;
 224   1          tx_head = next_head;
 225   1      }
 226          
 227          
 228          void rx_uart_pump(void)
 229          {
 230   1          if (TI && (tx_tail != tx_head))
 231   1          {
 232   2              TI = 0;
 233   2              SBUF = tx_buf[tx_tail];
 234   2              tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
 235   2          }
 236   1      }


