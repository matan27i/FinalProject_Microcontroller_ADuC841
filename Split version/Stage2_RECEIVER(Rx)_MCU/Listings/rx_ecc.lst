 181          /* =========================================================================
 182             PESEC ERROR CORRECTION  (SEC+DED UPGRADED)
 183             =========================================================================
 184          
 185             [W4] UPGRADED FROM SEC TO SEC+DED
 186          
 187             The original SEC-only algorithm:
 188               1. Compute syndrome S.
 189               2. If S == 0: no error.
 190               3. If S != 0: search for matching column, correct if found.
 191          
 192             The SEC+DED algorithm adds an overall parity check to distinguish
 193             single errors (correctable) from double errors (detectable only):
 194          
 195               1. Compute PESEC syndrome S.
 196               2. Recompute the overall parity of the received 25 data+red bits.
 197               3. Compare recomputed parity with the received overall parity bit.
 198               4. Apply the 4-case truth table:
 199          
 200                  CASE 1: S == 0, parity OK
 201                    The codeword is valid.  No error occurred.
 202                    Return: PESEC_NO_ERROR.
 203          
 204                  CASE 2: S != 0, parity FAIL (odd total parity)
 205                    An odd number of bits flipped.  For practical channel error
 206                    rates, this is overwhelmingly a SINGLE-bit error.  The PESEC
 207                    syndrome S identifies the errored bit position.  Proceed with
 208                    standard column-matching correction.
 209                    Return: PESEC_CORRECTED_DATA or PESEC_CORRECTED_RED.
 210          
 211                  CASE 3: S != 0, parity OK (even total parity)
 212                    An even number of bits flipped (2, 4, ...).  The PESEC syndrome
 213                    is non-zero because the two (or more) errors do not cancel in
 214                    syndrome space, but the overall parity IS even because two flips
 215                    preserve parity.  This is a DOUBLE (or higher even) error that
 216                    PESEC cannot correct -- applying the syndrome would "correct"
 217                    to the wrong codeword.
 218                    Return: PESEC_UNCORRECTABLE.
 219          
 220                  CASE 4: S == 0, parity FAIL (odd total parity)
 221                    The syndrome is zero, meaning all 25 data+red bits form a valid
 222                    PESEC codeword.  But the parity is wrong, so exactly one bit
 223                    flipped -- and that bit is the overall parity bit itself.
 224                    The data and redundancy are clean; no correction needed.
 225                    Return: PESEC_CORRECTED_PARITY.
 226          
 227             Parameters:
 228               data_bits       Pointer to 15-bit data; corrected in place if needed.
 229               red_bits        Pointer to 10-bit redundancy; corrected in place.
 230               overall_parity  The received overall parity bit (0 or 1) from the
 231                               26th bus bit, as extracted by the SPI ISR.
 232             ========================================================================= */
 233          uint8_t rx_pesec_correct(uint16_t *data_bits, uint16_t *red_bits,
 234                                   uint8_t overall_parity)
 235          {
 236   1          uint8_t syndrome;
 237   1          uint8_t parity_check;
 238   1          uint8_t i;
 239   1          uint8_t search_limit;
 240   1      
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/17/2026 14:35:28 PAGE 5   

 241   1          /* Step 1: Compute full PESEC syndrome over the received 25 bits. */
 242   1          syndrome = get_data_syndrome(*data_bits) ^ get_red_syndrome(*red_bits);
 243   1      
 244   1          /* Step 2: Recompute parity of the received 25 data+redundancy bits
 245   1             and compare with the received overall parity bit.
 246   1             parity_check = 0 means parity is consistent (even total).
 247   1             parity_check = 1 means parity mismatch (odd total = error). */
 248   1          parity_check = parity16(*data_bits & BUS_STATE_MASK)
 249   1                       ^ parity16(*red_bits & PESEC_RED_MASK)
 250   1                       ^ (overall_parity & 0x01u);
 251   1      
 252   1          /* Step 3: Apply the SEC+DED truth table. */
 253   1      
 254   1          if (syndrome == 0)
 255   1          {
 256   2              if (parity_check == 0)
 257   2              {
 258   3                  /* CASE 1: S==0, parity OK -> no error. */
 259   3                  return PESEC_NO_ERROR;
 260   3              }
 261   2              else
 262   2              {
 263   3                  /* CASE 4: S==0, parity FAIL -> only the parity bit flipped.
 264   3                     Data and redundancy are intact.  Increment the correction
 265   3                     counter since a bit error was detected and accounted for. */
 266   3                  rx_pesec_corrections++;
 267   3                  return PESEC_CORRECTED_PARITY;
 268   3              }
 269   2          }
 270   1          else
 271   1          {
 272   2              if (parity_check == 0)
 273   2              {
 274   3                  /* CASE 3: S!=0, parity OK -> double (or even-count) error.
 275   3                     The syndrome points to a wrong position; correcting would
 276   3                     make things worse.  Flag as uncorrectable. */
 277   3                  rx_errors_detected++;
 278   3                  return PESEC_UNCORRECTABLE;
 279   3              }
 280   2      
 281   2              /* CASE 2: S!=0, parity FAIL -> single error.  Proceed with
 282   2                 standard PESEC column-matching correction. */
 283   2          }
 284   1      
 285   1          /* --- Single-error correction (Case 2 only reaches here) --- */
 286   1      
 287   1          /* Search data-bit columns (Matrix A).
 288   1             Only check the first HAMMING_N columns (physical data bits). */
 289   1          search_limit = pesec_num_a_cols;
 290   1          if (search_limit > HAMMING_N)
 291   1          {
 292   2              search_limit = HAMMING_N;
 293   2          }
 294   1      
 295   1          for (i = 0; i < search_limit; i++)
 296   1          {
 297   2              if (PESEC_MAT_A[i] == syndrome)
 298   2              {
 299   3                  *data_bits ^= ((uint16_t)1u << i);
 300   3                  *data_bits &= BUS_STATE_MASK;
 301   3                  rx_pesec_corrections++;
 302   3                  return PESEC_CORRECTED_DATA;
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/17/2026 14:35:28 PAGE 6   

 303   3              }
 304   2          }
 305   1      
 306   1          /* Search redundancy-bit columns (Matrix D). */
 307   1          for (i = 0; i < pesec_num_d_cols; i++)
 308   1          {
 309   2              if (PESEC_MAT_D[i] == syndrome)
 310   2              {
 311   3                  *red_bits ^= ((uint16_t)1u << i);
 312   3                  *red_bits &= PESEC_RED_MASK;
 313   3                  rx_pesec_corrections++;
 314   3                  return PESEC_CORRECTED_RED;
 315   3              }
 316   2          }
 317   1      
 318   1          /* Syndrome is non-zero, parity says single error, but no column
 319   1             matches.  This should not happen with the H1-type construction
 320   1             (every non-zero 5-bit value is a column), but guard against it. */
 321   1          rx_errors_detected++;
 322   1          return PESEC_UNCORRECTABLE;
 323   1      }
