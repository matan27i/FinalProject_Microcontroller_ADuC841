 123          /* =========================================================================
 124             PESEC SYNDROME COMPUTATION (INTERNAL HELPERS)
 125             ========================================================================= */
 126          
 127          static uint8_t calc_pesec_syndrome_generic(uint16_t reg_val,
 128                                                     uint8_t *mat_ptr,
 129                                                     uint8_t  num_cols)
 130          {
 131   1          uint8_t syndrome = 0;
 132   1          uint8_t idx;
 133   1      
 134   1          for (idx = 0; idx < num_cols; idx++)
 135   1          {
 136   2              if ((reg_val >> idx) & 1u)
 137   2              {
 138   3                  syndrome ^= mat_ptr[idx];
 139   3              }
 140   2          }
 141   1      
 142   1          return syndrome;
 143   1      }
 144          
 145          
 146          static uint8_t get_data_syndrome(uint16_t data_val)
 147          {
 148   1          return calc_pesec_syndrome_generic(data_val, PESEC_MAT_A,
 149   1                                             pesec_num_a_cols);
 150   1      }
 151          
 152          
 153          static uint8_t get_red_syndrome(uint16_t red_val)
 154          {
 155   1          return calc_pesec_syndrome_generic(red_val, PESEC_MAT_D,
 156   1                                             pesec_num_d_cols);
 157   1      }
