  70          /* =========================================================================
  71             PESEC MATRIX INITIALISATION
  72             ========================================================================= */
  73          void rx_init_pesec_matrices(uint8_t *m_sizes, uint8_t num_blocks)
  74          {
  75   1          uint8_t i, b, val;
  76   1          uint8_t is_in_d;
  77   1          uint8_t total_m = 0;
  78   1          uint8_t current_col_offset = 0;
  79   1          uint8_t max_syndrome;
  80   1      
  81   1          pesec_num_blocks = num_blocks;
  82   1          pesec_num_d_cols = 0;
  83   1          pesec_num_a_cols = 0;
  84   1      
  85   1          for (b = 0; b < num_blocks; b++)
  86   1          {
  87   2              pesec_bit_offsets[b] = total_m;
  88   2              pesec_col_offsets[b] = current_col_offset;
  89   2              pesec_chunk_masks[b] = ((1 << m_sizes[b]) - 1) << total_m;
  90   2      
  91   2              for (i = 1; i < (1 << m_sizes[b]); i++)
  92   2              {
  93   3                  PESEC_MAT_D[pesec_num_d_cols++] = (i << total_m);
  94   3              }
  95   2      
  96   2              total_m += m_sizes[b];
  97   2              current_col_offset += ((1 << m_sizes[b]) - 1);
  98   2          }
  99   1      
 100   1          max_syndrome = (1 << total_m) - 1;
 101   1      
 102   1          for (val = 1; val <= max_syndrome; val++)
 103   1          {
 104   2              is_in_d = 0;
 105   2      
 106   2              for (i = 0; i < pesec_num_d_cols; i++)
 107   2              {
 108   3                  if (PESEC_MAT_D[i] == val)
 109   3                  {
 110   4                      is_in_d = 1;
 111   4                      break;
 112   4                  }
 113   3              }
 114   2      
 115   2              if (is_in_d == 0)
 116   2              {
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/17/2026 14:35:28 PAGE 3   

 117   3                  PESEC_MAT_A[pesec_num_a_cols++] = val;
 118   3              }
 119   2          }
 120   1      }
