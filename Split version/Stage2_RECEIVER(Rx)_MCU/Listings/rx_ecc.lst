 160          /* =========================================================================
 161             PARITY COMPUTATION HELPER  (W4 -- SEC+DED)
 162             =========================================================================
 163             Computes the population parity (popcount mod 2) of a 16-bit value
 164             using XOR folding.  Identical to the TX encoder's implementation.
 165          
 166             Returns: 0 if even number of set bits, 1 if odd.
 167             ========================================================================= */
 168          static uint8_t parity16(uint16_t v)
 169          {
 170   1          uint8_t x;
 171   1      
 172   1          x = (uint8_t)(v >> 8) ^ (uint8_t)(v);
 173   1          x ^= x >> 4;
 174   1          x ^= x >> 2;
 175   1          x ^= x >> 1;
 176   1      
 177   1          return (x & 1u);
 178   1      }
