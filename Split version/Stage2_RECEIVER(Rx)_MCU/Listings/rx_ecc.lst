 326          /* =========================================================================
 327             H1 DIFFERENTIAL ERROR CORRECTION  (unchanged from previous version)
 328             ========================================================================= */
 329          
 330          uint16_t find_minimal_w(uint8_t s_target)
 331          {
 332   1          s_target &= 0x0F;
 333   1      
 334   1          if (s_target == 0)
 335   1          {
 336   2              return 0;
 337   2          }
 338   1      
 339   1          return ((uint16_t)1u << (s_target - 1));
 340   1      }
