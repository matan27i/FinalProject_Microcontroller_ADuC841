 342          
 343          uint16_t rx_correct_bus_state(uint16_t corrected_data)
 344          {
 345   1          uint16_t delta;
 346   1          uint8_t  syndrome_delta;
 347   1          uint16_t expected_delta;
 348   1          uint16_t result;
 349   1      
 350   1          corrected_data &= BUS_STATE_MASK;
 351   1      
 352   1          delta = corrected_data ^ rx_previous_bus_state;
 353   1      
 354   1          syndrome_delta = rx_compute_syndrome(delta);
 355   1      
 356   1          expected_delta = find_minimal_w(syndrome_delta);
 357   1      
 358   1          if (delta == expected_delta)
 359   1          {
 360   2              result = corrected_data;
 361   2          }
 362   1          else
 363   1          {
 364   2              result = (rx_previous_bus_state ^ expected_delta) & BUS_STATE_MASK;
C51 COMPILER V9.60.7.0   RX_ECC                                                            03/17/2026 14:35:28 PAGE 7   

 365   2              rx_errors_corrected++;
 366   2          }
 367   1      
 368   1          rx_previous_bus_state = result;
 369   1      
 370   1          return result;
 371   1      }


