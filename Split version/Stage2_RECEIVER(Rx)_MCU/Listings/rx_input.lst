  16          {
  17              uint8_t p2_val, p3_val;
  18              uint8_t i;
  19              
  20              // 1. Clear output array to ensure no garbage data remains in unused bits
  21              memset(X, 0, HAMMING_N);
  22              
  23              // 2. Atomic read from ports (Critical Section)
  24              EA = 0;
  25              p2_val = P2;
  26              p3_val = P3;
  27              EA = 1;
  28              
  29              // 3. Unpack P2 into X[0-7]
  30              for (i = 0; i < 8; i++)
  31              {
  32                  X[i] = (p2_val >> i) & 0x01;
  33              }
  34              
