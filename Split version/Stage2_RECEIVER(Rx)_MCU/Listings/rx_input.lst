  39              X[9]  = (p3_val >> 6) & 0x01; // Read P3.6
  40              X[10] = (p3_val >> 7) & 0x01; // Read P3.7
  41              
  42              // Bits X[11] through X[14] remain 0 (from memset)
  43          }/
  44          /* File: rx_input.c
  45           * Active Low Logic:
  46           * Voltage High (1) -> Interpreted as Logic 0 (Idle)
  47           * Voltage Low (0/GND) -> Interpreted as Logic 1 (Active)
