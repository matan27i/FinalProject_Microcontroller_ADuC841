  59          void rx_process_bus_state(uint16_t bus_state)
  60          {
  61   1          uint8_t data_nibble;
  62   1          uint8_t complete_byte;
  63   1      
  64   1          data_nibble = rx_compute_syndrome(bus_state);
  65   1      
  66   1          switch (rx_current_state)
  67   1          {
  68   2              case RX_STATE_WAIT_HIGH:
  69   2                  rx_stored_high_nibble = data_nibble & 0x0Fu;
  70   2                  rx_current_state      = RX_STATE_WAIT_LOW;
  71   2                  break;
  72   2      
  73   2              case RX_STATE_WAIT_LOW:
  74   2                  complete_byte = (uint8_t)((rx_stored_high_nibble << 4)
  75   2                                   | (data_nibble & 0x0Fu));
