  34          uint8_t rx_compute_syndrome(uint16_t bus_state)
  35          {
  36   1          uint8_t  syndrome = 0;
  37   1          uint8_t  col_idx;
  38   1          uint16_t temp;
  39   1      
  40   1          temp = bus_state & BUS_STATE_MASK;
  41   1      
  42   1          for (col_idx = 1; col_idx <= HAMMING_N; col_idx++)
  43   1          {
  44   2              if (temp & 0x0001u)
  45   2              {
  46   3                  syndrome ^= col_idx;
  47   3              }
  48   2              temp >>= 1;
  49   2          }
  50   1      
  51   1          return (syndrome & 0x0Fu);
  52   1      }
