 166          /* =========================================================================
 167           * SHIFT-REGISTER OUTPUT DRIVER
 168           * =========================================================================
 169           * [W4] Serialises the full 26-bit word (1 parity + 10 ECC + 15 data,
 170           * MSB-first) into daisy-chained 74HC595 shift registers, then pulses
 171           * the latch.
 172           *
 173           * SHIFT ORDER (first bit shifted -> farthest chain position):
 174           *   Phase 0:  1 overall parity bit  (pesec_overall_parity)
 175           *   Phase 1: 10 ECC redundancy bits (pesec_redundancy_reg, MSB-first)
 176           *   Phase 2: 15 data bits           (current_bus_state, MSB-first)
 177           *   Phase 3:  Latch pulse
 178           *
C51 COMPILER V9.60.7.0   TX_MAIN                                                           03/17/2026 14:35:08 PAGE 4   

 179           * The parity bit is shifted first so it arrives at the output pin
 180           * connected to the Arduino Mega's PC7 (pin 30).  The ECC and data
 181           * bits retain their original mapping.
 182           * ========================================================================= */
 183          void output_to_shift_registers(void)
 184          {
 185   1          uint16_t state_copy;
 186   1          uint16_t ecc_copy;
 187   1          uint8_t  parity_copy;
 188   1          signed char bit_pos;
 189   1          uint8_t bit_value;
 190   1      
 191   1          /* Snapshot all three values for consistency during output. */
 192   1          state_copy  = current_bus_state & BUS_STATE_MASK;
 193   1          ecc_copy    = pesec_redundancy_reg & PESEC_RED_MASK;
 194   1          parity_copy = pesec_overall_parity & 0x01u;
 195   1      
 196   1          /* --- Phase 0: [W4] Shift out 1 overall parity bit --- */
 197   1          SR_DATA = parity_copy;
 198   1      
 199   1          counter_t2 = 0;
 200   1          TH2 = T2_RELOAD_H;
 201   1          TL2 = T2_RELOAD_L;
 202   1          TR2 = 1;
 203   1          while (TR2 == 1);
 204   1      
 205   1          /* --- Phase 1: Shift out 10 ECC redundancy bits (MSB-first) --- */
 206   1          for (bit_pos = 9; bit_pos >= 0; bit_pos--)
 207   1          {
 208   2              bit_value = (uint8_t)((ecc_copy >> bit_pos) & 0x0001);
 209   2              SR_DATA   = bit_value;
 210   2      
 211   2              counter_t2 = 0;
 212   2              TH2 = T2_RELOAD_H;
 213   2              TL2 = T2_RELOAD_L;
 214   2              TR2 = 1;
 215   2              while (TR2 == 1);
 216   2          }
 217   1      
 218   1          /* --- Phase 2: Shift out 15 data bits (MSB-first) --- */
 219   1          for (bit_pos = (HAMMING_N - 1); bit_pos >= 0; bit_pos--)
 220   1          {
 221   2              bit_value = (uint8_t)((state_copy >> bit_pos) & 0x0001);
 222   2              SR_DATA   = bit_value;
 223   2      
 224   2              counter_t2 = 0;
 225   2              TH2 = T2_RELOAD_H;
 226   2              TL2 = T2_RELOAD_L;
 227   2              TR2 = 1;
 228   2              while (TR2 == 1);
 229   2          }
 230   1      
 231   1          /* --- Phase 3: Latch pulse (transfer shift reg -> output reg) --- */
 232   1          flag_t2_mod = 2;
 233   1          counter_t2  = 0;
 234   1          TH2 = T2_RELOAD_H;
 235   1          TL2 = T2_RELOAD_L;
 236   1          TR2 = 1;
 237   1          while (TR2 == 1);
 238   1      }
