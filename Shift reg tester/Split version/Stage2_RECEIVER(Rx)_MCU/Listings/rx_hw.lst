 216          /* =========================================================================
 217             NON-BLOCKING UART TX BUFFER  (unchanged)
 218             ========================================================================= */
 219          
 220          #define TX_BUF_SIZE 16
 221          static uint8_t xdata tx_buf[TX_BUF_SIZE];
 222          static uint8_t tx_head = 0;
 223          static uint8_t tx_tail = 0;
 224          
 225          
 226          void rx_send_uart_byte(uint8_t data_byte)
 227          {
 228   1          uint8_t next_head;
 229   1      
 230   1          next_head = (tx_head + 1) % TX_BUF_SIZE;
 231   1          if (next_head == tx_tail)
 232   1          {
 233   2              return;
 234   2          }
 235   1      
 236   1          tx_buf[tx_head] = data_byte;
 237   1          tx_head = next_head;
 238   1      }
 239          
 240          
C51 COMPILER V9.60.7.0   RX_HW                                                             03/23/2026 11:25:55 PAGE 5   

 241          void rx_uart_pump(void)
 242          {
 243   1          if (TI && (tx_tail != tx_head))
 244   1          {
 245   2              TI = 0;
 246   2              SBUF = tx_buf[tx_tail];
 247   2              tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
 248   2          }
 249   1      }


