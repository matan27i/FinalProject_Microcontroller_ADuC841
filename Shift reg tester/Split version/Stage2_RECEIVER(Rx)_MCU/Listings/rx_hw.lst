   1          /* =============================================================================
   2             File: rx_hw.c
   3             Module: Group 1 -- Hardware Abstraction Layer (SPI Slave version)
   4             Target: ADuC841 (8052 single-cycle core, 11.0592 MHz crystal)
   5          
   6             FIX LOG:
   7               [F2] RX_SPI_Slave_Init() now writes 0 to P1.5 to force it from
   8                    analog mode (ADuC841 power-on default) to digital input mode
   9                    BEFORE enabling the SPI peripheral.  Without this fix, the /SS
  10                    pin cannot reliably detect the master's slave-select assertion,
  11                    causing intermittent SPI frame loss or corruption.
  12               [W4] SPI ISR now extracts the overall parity bit from byte 1 bit 7
  13                    and stores it in rx_spi_parity for the SEC+DED decode pipeline.
  14          
  15             ADuC841 PORT 1 ANALOG-MODE ANOMALY:
  16             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  17             On the ADuC841, all Port 1 pins power up in ANALOG INPUT mode.  In
  18             this mode the digital input buffer is disabled and the pin reads as
  19             indeterminate.  Writing a 0 to a P1 bit switches that pin to DIGITAL
  20             mode.  This must be done BEFORE enabling any peripheral (like SPI)
  21             that relies on reading the pin.
  22          
  23             The SPI /SS pin is P1.5.  If SPE is set while P1.5 is still in
  24             analog mode, the SPI slave cannot detect /SS transitions and will
  25             either ignore frames entirely or sample data at random phases.
  26          
  27             Reference: ADuC841 datasheet, "Port 1" section (p. 60-62).
  28             =============================================================================
  29          */
  30          
  31          #include "rx_system.h"
  32          
  33          /* =========================================================================
  34             SPI RECEIVE STATE VARIABLES
  35             ========================================================================= */
  36          
  37          /* Staging registers: assembled 26-bit word from the last complete frame.
  38             Written atomically by the SPI ISR; read by the main loop when
  39             rx_spi_frame_ready == 1. */
  40          volatile uint16_t rx_spi_data        = 0;
  41          volatile uint16_t rx_spi_red         = 0;
  42          volatile uint8_t  rx_spi_parity      = 0;   /* [W4] Overall parity bit */
  43          volatile uint8_t  rx_spi_frame_ready = 0;
  44          
  45          /* ISR-private byte accumulation buffer and counter. */
  46          static uint8_t spi_rx_buf[4];
  47          static uint8_t spi_byte_idx = 0;
  48          
  49          
  50          /* =========================================================================
  51             INTERRUPT SERVICE ROUTINES
  52             ========================================================================= */
  53          
  54          /* ---------------------------------------------------------------------------
C51 COMPILER V9.60.7.0   RX_HW                                                             03/23/2026 11:25:55 PAGE 2   

  55             INT0 ISR (vector 0, address 0x0003) -- /SS Frame-Sync
  56             ---------------------------------------------------------------------------
  57             Fires on the falling edge of /SS (Mega asserts slave select).
  58             Resets the byte counter to 0 so the next SPI byte is byte 0.
  59             ---------------------------------------------------------------------------
  60          */
  61          void INT0_FrameSync_ISR(void) interrupt 0
  62          {
  63   1          spi_byte_idx = 0;
  64   1      }
  65          
  66          
  67          /* ---------------------------------------------------------------------------
  68             SPI/I2C ISR (vector 6, address 0x0033) -- Byte Received
  69             ---------------------------------------------------------------------------
  70             Fires after each complete 8-bit SPI transfer.
  71          
  72             FRAME PROTOCOL (4 bytes per frame):
  73               Index 0: H1 data bits  [7:0]
  74               Index 1: bit 7 = overall parity (W4)
  75                        bits [6:0] = H1 data bits [14:8]
  76               Index 2: ECC red bits  [7:0]
  77               Index 3: ECC red bits  [9:8] (bits 7-2 = 0)
  78          
  79             After storing byte 3, the ISR assembles the 15-bit data, 10-bit
  80             redundancy, and 1-bit parity, then sets rx_spi_frame_ready = 1.
  81             ---------------------------------------------------------------------------
  82          */
  83          void SPI_Receive_ISR(void) interrupt 6
  84          {
  85   1          uint8_t rx_byte;
  86   1      
  87   1          /* Read SPIDAT to get the received byte AND clear the interrupt flag. */
  88   1          rx_byte = SPIDAT;
  89   1      
  90   1          if (spi_byte_idx >= 4)
  91   1          {
  92   2              return;
  93   2          }
  94   1      
  95   1          spi_rx_buf[spi_byte_idx] = rx_byte;
  96   1          spi_byte_idx++;
  97   1      
  98   1          if (spi_byte_idx == 4)
  99   1          {
 100   2              /* Assemble the 15-bit data word from bytes 0 and 1.
 101   2                 Byte 0 = data[7:0].
 102   2                 Byte 1 bits [6:0] = data[14:8].
 103   2                 Byte 1 bit 7 = overall parity (extracted separately). */
 104   2              rx_spi_data = (uint16_t)spi_rx_buf[0]
 105   2                          | (((uint16_t)(spi_rx_buf[1] & 0x7Fu)) << 8);
 106   2      
 107   2              /* Assemble the 10-bit redundancy word from bytes 2 and 3. */
 108   2              rx_spi_red  = (uint16_t)spi_rx_buf[2]
 109   2                          | (((uint16_t)(spi_rx_buf[3] & 0x03u)) << 8);
 110   2      
 111   2              /* [W4] Extract the overall parity bit from byte 1, bit 7.
 112   2                 This is the TX-computed even parity of all 25 bits
 113   2                 (15 data + 10 redundancy).  It rides in the previously-
 114   2                 unused high bit of byte 1. */
 115   2              rx_spi_parity = (spi_rx_buf[1] >> 7) & 0x01u;
 116   2      
C51 COMPILER V9.60.7.0   RX_HW                                                             03/23/2026 11:25:55 PAGE 3   

 117   2              rx_spi_frame_ready = 1;
 118   2          }
 119   1      }
