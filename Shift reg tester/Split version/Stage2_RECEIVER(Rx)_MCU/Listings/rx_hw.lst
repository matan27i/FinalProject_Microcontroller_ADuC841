 154          /* ---------------------------------------------------------------------------
 155             RX_SPI_Slave_Init
 156             ---------------------------------------------------------------------------
 157             [F2] FIX: P1.5 ANALOG-MODE BUG
 158          
 159             The ADuC841 Port 1 defaults to ANALOG INPUT mode on power-up.
 160             In analog mode, the digital input buffer is disconnected, so the
 161             pin cannot reliably read logic levels.  P1.5 is the SPI /SS pin.
 162             If SPE is enabled while P1.5 is still analog, the SPI slave
 163             peripheral cannot detect the master's slave-select assertion.
 164          
 165             FIX: Write 0 to P1.5 BEFORE enabling SPE.  On the ADuC841, writing
 166             a 0 to any Port 1 bit switches that pin from analog to digital mode.
 167             We use a bitwise AND to clear only P1.5 without disturbing other P1
 168             bits that may be intentionally left in analog mode for ADC use.
 169          
 170             After the digital-mode switch, SPI is enabled as before.
 171          
 172             [W4] rx_spi_parity is reset to 0 alongside the other staging registers.
 173          
 174             SPICON = 0xA0:
 175               ISPI=1 (SPI interrupt enable), SPE=1 (SPI enable),
 176               SPIM=0 (slave), CPOL=0, CPHA=0 (Mode 0), SPR=00 (ignored).
 177             ---------------------------------------------------------------------------
 178          */
C51 COMPILER V9.60.7.0   RX_HW                                                             03/23/2026 11:25:55 PAGE 4   

 179          void RX_SPI_Slave_Init(void)
 180          {
 181   1          /* Reset SPI receive state. */
 182   1          spi_byte_idx       = 0;
 183   1          rx_spi_frame_ready = 0;
 184   1          rx_spi_data        = 0;
 185   1          rx_spi_red         = 0;
 186   1          rx_spi_parity      = 0;   /* [W4] */
 187   1      
 188   1          /* [F2] Force P1.5 (/SS) from analog mode to digital input mode.
 189   1             On ADuC841, writing 0 to a Port 1 bit activates the digital
 190   1             input buffer for that pin.  This MUST happen before SPE is set,
 191   1             otherwise the SPI slave cannot detect /SS transitions.
 192   1      
 193   1             P1 &= ~0x20  clears bit 5 only.  Bits 0-4 and 6-7 are preserved
 194   1             so that any ADC channels configured on other P1 pins remain
 195   1             undisturbed.  If additional SPI pins (MOSI, MISO, SCLOCK) also
 196   1             reside on Port 1, clear those bits here too -- consult the
 197   1             datasheet for your specific package variant. */
 198   1          P1 &= ~0x20u;   /* P1.5 = 0 -> digital mode for /SS */
 199   1      
 200   1          /* Pre-load transmit register. */
 201   1          SPIDAT = 0x00u;
 202   1      
 203   1          /* Configure SPI: slave mode, Mode 0, interrupt enabled.
 204   1             ISPI=1, SPE=1, SPIM=0, CPOL=0, CPHA=0, SPR=00 => 0xA0. */
 205   1          SPICON = 0xA0u;
 206   1      
 207   1          /* Configure INT0 (P3.2) for falling-edge trigger. */
 208   1          IT0 = 1;
 209   1          IE0 = 0;
 210   1          EX0 = 1;
 211   1      
 212   1          /* EA is NOT set here; caller must set EA=1 after all inits. */
 213   1      }
